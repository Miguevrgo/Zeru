// Zeru Standard Library - HashMap
// One control byte per slot, sixteen of them per group, compared all at
// once with SSE2.
// A key is hashed by its bits.

// A control byte: a slot never used, one whose entry was removed, or else
// the top seven bits of its key's hash.
const EMPTY: u64 = 255;
const DELETED: u64 = 128;

// Fibonacci hashing: the bits, high half folded into the low one so every
// bit reaches the group index, times 2^64 over the golden ratio, wrapping.
fn hash(bits: u64) u64 {
    return (bits ^ (bits >> 32)) *% 11400714819323198485;
}

// The slots of the group whose control bytes are `low` and `high` holding
// `byte`, one bit each, and those never used.
fn scan(low: u64, high: u64, byte: u32) (u32, u32) {
    var hits: u32 = 0;
    var empty: u32 = 0;
    asm (
        "movq $2, %xmm0\n punpcklqdq $3, %xmm0\n movd $4, %xmm1\n punpcklbw %xmm1, %xmm1\n pshuflw $$0, %xmm1, %xmm1\n pshufd $$0, %xmm1, %xmm1\n pcmpeqb %xmm0, %xmm1\n pmovmskb %xmm1, $0\n pcmpeqd %xmm1, %xmm1\n pcmpeqb %xmm1, %xmm0\n pmovmskb %xmm0, $1"
        : "=r" (hits), "=r" (empty)
        : "r" (low), "x" (high), "r" (byte)
        : "xmm0", "xmm1"
    );
    return (hits, empty);
}

// The slots of the group free to take, never used or removed.
fn free_slots(low: u64, high: u64) u32 {
    var free: u32 = 0;
    asm (
        "movq $1, %xmm0\n punpcklqdq $2, %xmm0\n pmovmskb %xmm0, $0"
        : "=r" (free)
        : "r" (low), "x" (high)
        : "xmm0"
    );
    return free;
}

// The position of the lowest bit set in `bits`, which is not zero.
fn lowest(bits: u32) usize {
    var at: u32 = 0;
    asm ("bsf $1, $0" : "=r" (at) : "r" (bits));
    return at as usize;
}

// A map from keys to values, growing on the heap as entries come.
//
// Keys are integers, bools, text, enums without data, or tuples and structs of
// those; each key holds one value. Looking up, adding and removing a key
// take O(1) time on average. `for (key, value) in map` walks the entries
// in the order they went in, until a removal moves the last one into the
// gap it leaves;
// `for (key, value) in &var map` can change the values.
//
// # Examples
//
// ```zeru
// import std.collections.hashmap::{HashMap};
//
// var stock: HashMap<i64, i32> = HashMap.new();
// stock.insert(1001, 5);
// stock.insert(1002, 0);
// stock.insert(1001, 4);
// println("{}", stock.len()); // 2
// match stock.get(&1001) {
//     Some(count) => println("{}", *count), // 4
//     None => println("unknown item"),
// }
// println("{}", stock.contains(&1003)); // false
// var total = 0;
// for (_, count) in stock {
//     total += count;
// }
// println("{}", total); // 4
// ```
pub struct HashMap<K: Hash, V> {
    groups: Vec<u64>,
    slots: Vec<u32>,
    entries: Vec<(K, V)>,
    room: usize,

    // Returns an empty map.
    //
    // It allocates nothing until the first `insert`.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.hashmap::{HashMap};
    //
    // var ages: HashMap<i32, i32> = HashMap.new();
    // println("{}", ages.is_empty()); // true
    // ```
    pub fn new() HashMap<K, V> {
        return HashMap { groups: Vec.new(), slots: Vec.new(), entries: Vec.new(), room: 0 };
    }

    // Stores `value` under `key`, replacing the value already there.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.hashmap::{HashMap};
    //
    // var scores: HashMap<i32, i32> = HashMap.new();
    // scores.insert(7, 10);
    // scores.insert(7, 25);
    // println("{} {}", scores.len(), *scores.get(&7).unwrap()); // 1 25
    // ```
    pub fn insert(var self, key: K, value: V) {
        var found = self.find(&key);
        if found.is_some() {
            self.entries[self.slots[found.unwrap()] as usize] = (key, value);
            return;
        }
        self.add((key, value));
    }

    // Returns a reference to the value under `key`, first storing `value`
    // there when the key has none, so the value can change in place.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.hashmap::{HashMap};
    //
    // var counts: HashMap<i32, i32> = HashMap.new();
    // for n in [3, 1, 3] {
    //     *counts.get_or_insert(n, 0) += 1;
    // }
    // println("{} {}", *counts.get(&3).unwrap(), *counts.get(&1).unwrap()); // 2 1
    // ```
    pub fn get_or_insert(var self, key: K, value: V) &var V {
        var found = self.find(&key);
        if found.is_none() {
            self.add((key, value));
            return &var self.entries[self.entries.len() - 1].1;
        }
        return &var self.entries[self.slots[found.unwrap()] as usize].1;
    }

    // Add `entry`, whose key the map does not hold.
    fn add(var self, entry: (K, V)) {
        if self.room == 0 {
            self.grow();
        }
        self.entries.push(entry);
        self.place(self.entries.len() - 1);
    }

    // Put the index of entry `index`, whose key no slot holds, in the first
    // free slot of its search.
    fn place(var self, index: usize) {
        var bits = hash(__zeru_hash_bits(self.entries[index].0));
        var mask = self.groups.len() / 2 - 1;
        var at = (bits >> 32) as usize & mask;
        var stride: usize = 0;
        var free = self.free_slots(at);
        while free == 0 {
            stride += 1;
            at = (at + stride) & mask;
            free = self.free_slots(at);
        }
        var slot = at * 16 + lowest(free);
        if self.control(slot) == EMPTY {
            self.room -= 1;
        }
        self.set_control(slot, bits >> 57);
        self.slots[slot] = index as u32;
    }

    // Returns a reference to the value under `key`, or None when there is none.
    //
    // `*` reads the value through the reference; `.copy()` on the result gives
    // a `V?` holding a copy.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.hashmap::{HashMap};
    //
    // var names: HashMap<i32, str> = HashMap.new();
    // names.insert(1, "ann");
    // println("{}", *names.get(&1).unwrap()); // ann
    // println("{}", names.get(&2).is_none()); // true
    // ```
    pub fn get(self, key: &K) (&V)? {
        var found = self.find(key);
        if found.is_none() {
            return None;
        }
        return &self.entries[self.slots[found.unwrap()] as usize].1;
    }

    // Returns whether there is a value under `key`.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.hashmap::{HashMap};
    //
    // var seen: HashMap<i32, bool> = HashMap.new();
    // seen.insert(3, true);
    // println("{} {}", seen.contains(&3), seen.contains(&4)); // true false
    // ```
    pub fn contains(self, key: &K) bool {
        return self.find(key).is_some();
    }

    // Removes the entry under `key` and returns its value, or None when
    // there was none.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.hashmap::{HashMap};
    //
    // var ages: HashMap<i32, i32> = HashMap.new();
    // ages.insert(5, 40);
    // println("{}", ages.remove(&5)); // 40
    // println("{}", ages.remove(&5).is_none()); // true
    // ```
    //
    // A removed slot goes back to never used only when its group still has
    // one, since then no search ever went past that group.
    pub fn remove(var self, key: &K) V? {
        var found = self.find(key);
        if found.is_none() {
            return None;
        }
        var slot = found.unwrap();
        var index = self.slots[slot] as usize;
        if self.scan(slot / 16, 0).1 != 0 {
            self.set_control(slot, EMPTY);
            self.room += 1;
        } else {
            self.set_control(slot, DELETED);
        }
        var last = self.entries.len() - 1;
        if index != last {
            var moved = self.find(&self.entries[last].0).unwrap();
            self.slots[moved] = index as u32;
            self.entries.swap(index, last);
        }
        var (_, value) = self.entries.pop().unwrap();
        return value;
    }

    // Removes every entry.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.hashmap::{HashMap};
    //
    // var cache: HashMap<i32, i32> = HashMap.new();
    // cache.insert(1, 1);
    // cache.clear();
    // println("{}", cache.is_empty()); // true
    // ```
    pub fn clear(var self) {
        self.groups.clear();
        self.slots.clear();
        self.entries.clear();
        self.room = 0;
    }

    // Returns how many entries the map holds.
    pub fn len(self) usize {
        return self.entries.len();
    }

    // Returns whether the map holds no entries.
    pub fn is_empty(self) bool {
        return self.entries.is_empty();
    }

    // The slot holding `key`: groups are searched in a triangular sequence
    // until one has a slot never used.
    fn find(self, key: &K) usize? {
        if self.groups.is_empty() {
            return None;
        }
        var bits = hash(__zeru_hash_bits(*key));
        var top = (bits >> 57) as u32;
        var mask = self.groups.len() / 2 - 1;
        var at = (bits >> 32) as usize & mask;
        var stride: usize = 0;
        while true {
            var found = self.scan(at, top);
            var hits = found.0;
            while hits != 0 {
                var slot = at * 16 + lowest(hits);
                if self.entries[self.slots[slot] as usize].0 == *key {
                    return slot;
                }
                hits = hits & (hits - 1);
            }
            if found.1 != 0 {
                return None;
            }
            stride += 1;
            at = (at + stride) & mask;
        }
    }

    fn scan(self, group: usize, byte: u32) (u32, u32) {
        return scan(self.groups[group * 2], self.groups[group * 2 + 1], byte);
    }

    fn free_slots(self, group: usize) u32 {
        return free_slots(self.groups[group * 2], self.groups[group * 2 + 1]);
    }

    fn control(self, slot: usize) u64 {
        return (self.groups[slot / 8] >> ((slot % 8) * 8) as u64) & 255;
    }

    fn set_control(var self, slot: usize, control: u64) {
        var shift = ((slot % 8) * 8) as u64;
        var word = slot / 8;
        self.groups[word] = (self.groups[word] & !(255 << shift)) | (control << shift);
    }

    // Twice the groups when half or more of the slots hold entries, as many
    // otherwise, or one to start; seven slots in eight may be taken.
    fn grow(var self) {
        var count: usize = self.groups.len() / 2;
        if self.entries.len() * 2 >= count * 16 {
            count *= 2;
        }
        if count == 0 {
            count = 1;
        }
        self.groups.clear();
        for _ in 0..count * 2 {
            self.groups.push(18446744073709551615);
        }
        self.slots.clear();
        for _ in 0..count * 16 {
            self.slots.push(0);
        }
        self.room = count * 14;
        for index in 0..self.entries.len() {
            self.place(index);
        }
    }
}
