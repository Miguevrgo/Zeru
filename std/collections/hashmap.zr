// Zeru Standard Library - HashMap (i64 keys, i64 values)
// Fixed-capacity open-addressing hash map. 256 slots, ~192 usable (75% load).

const EMPTY: u8 = 0;
const OCCUPIED: u8 = 1;
const DELETED: u8 = 2;

// Where probing for `key` starts: the key folded to 32 bits, then the top
// byte of its product with 2^32 / phi (Fibonacci hashing). A 32-bit value
// times a 32-bit constant cannot overflow a u64, so no key trips the overflow
// check.
fn slot(key: i64) usize {
    var h: u64 = key as u64;
    h = (h ^ (h >> 32)) & 4294967295;
    return (((h * 2654435769) >> 24) & 255) as usize;
}

struct HashMap {
    keys: Array<i64, 256>,
    vals: Array<i64, 256>,
    state: Array<u8, 256>,
    len: usize,

    fn new() HashMap {
        return HashMap { keys: [0; 256], vals: [0; 256], state: [EMPTY; 256], len: 0 };
    }

    // The slot holding `key`. Probing stops at a slot never used; a deleted
    // one may still have the key past it.
    fn find(self, key: i64) usize? {
        var idx: usize = slot(key);
        var i: usize = 0;
        while i < 256 && self.state[idx] != EMPTY {
            if self.state[idx] == OCCUPIED && self.keys[idx] == key {
                return idx;
            }
            idx = (idx + 1) & 255;
            i += 1;
        }
        return None;
    }

    fn insert(var self, key: i64, val: i64) bool {
        var found = self.find(key);
        if found.is_some() {
            self.vals[found.unwrap()] = val;
            return true;
        }
        if self.len >= 192 {
            return false;
        }

        var idx: usize = slot(key);
        while self.state[idx] == OCCUPIED {
            idx = (idx + 1) & 255;
        }
        self.keys[idx] = key;
        self.vals[idx] = val;
        self.state[idx] = OCCUPIED;
        self.len += 1;
        return true;
    }

    fn get(self, key: i64) i64? {
        var found = self.find(key);
        if found.is_none() {
            return None;
        }
        return self.vals[found.unwrap()];
    }

    fn contains(self, key: i64) bool {
        return self.find(key).is_some();
    }

    fn remove(var self, key: i64) bool {
        var found = self.find(key);
        if found.is_none() {
            return false;
        }
        self.state[found.unwrap()] = DELETED;
        self.len -= 1;
        return true;
    }

    fn clear(var self) {
        var i: usize = 0;
        while i < 256 {
            self.state[i] = EMPTY;
            i += 1;
        }
        self.len = 0;
    }

    fn size(self) usize {
        return self.len;
    }

    fn is_empty(self) bool {
        return self.len == 0;
    }
}
