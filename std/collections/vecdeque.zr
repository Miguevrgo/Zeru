// Zeru Standard Library - VecDeque (double-ended queue)

// Move the bottom half of `from`, at least one value, to the empty `to`,
// reversed so `from`'s bottom value ends on top; so either end pops in
// amortized O(1).
fn shift<T>(from: &var Vec<T>, to: &var Vec<T>) {
    var kept: Vec<T> = Vec.new();
    while kept.len() + 1 < from.len() {
        kept.push(from.pop().unwrap());
    }
    while !from.is_empty() {
        to.push(from.pop().unwrap());
    }
    while !kept.is_empty() {
        from.push(kept.pop().unwrap());
    }
}

// A queue open at both ends, growing on the heap: two stacks back to back,
// `front` holding the first values in reverse and `back` the rest in order.
pub struct VecDeque<T> {
    front: Vec<T>,
    back: Vec<T>,

    // An empty queue; it allocates on the first push.
    pub fn new() VecDeque<T> {
        return VecDeque { front: Vec.new(), back: Vec.new() };
    }

    // Add `val` at the back.
    pub fn push_back(var self, val: T) {
        self.back.push(val);
    }

    // Add `val` at the front.
    pub fn push_front(var self, val: T) {
        self.front.push(val);
    }

    // Take out the front value; None when empty.
    pub fn pop_front(var self) T? {
        if self.front.is_empty() {
            shift(&var self.back, &var self.front);
        }
        return self.front.pop();
    }

    // Take out the back value; None when empty.
    pub fn pop_back(var self) T? {
        if self.back.is_empty() {
            shift(&var self.front, &var self.back);
        }
        return self.back.pop();
    }

    // The front value, left in place; None when empty.
    pub fn front(self) (&T)? {
        return self.at(0);
    }

    // The back value, left in place; None when empty.
    pub fn back(self) (&T)? {
        if self.is_empty() {
            return None;
        }
        return self.at(self.len() - 1);
    }

    // The value `index` places from the front; None past the end.
    pub fn at(self, index: usize) (&T)? {
        if index < self.front.len() {
            return &self.front[self.front.len() - 1 - index];
        }
        if index - self.front.len() < self.back.len() {
            return &self.back[index - self.front.len()];
        }
        return None;
    }

    // How many values it holds.
    pub fn len(self) usize {
        return self.front.len() + self.back.len();
    }

    // Whether it holds no values.
    pub fn is_empty(self) bool {
        return self.len() == 0;
    }

    // Drop every value.
    pub fn clear(var self) {
        self.front.clear();
        self.back.clear();
    }
}
