// Zeru Standard Library - VecDeque (double-ended queue)

// Move the bottom half of `from`, at least one value, to the empty `to`,
// reversed so `from`'s bottom value ends on top; so either end pops in
// amortized O(1).
fn shift<T>(from: &var Vec<T>, to: &var Vec<T>) {
    var kept: Vec<T> = Vec.new();
    while kept.len() + 1 < from.len() {
        kept.push(from.pop().unwrap());
    }
    while !from.is_empty() {
        to.push(from.pop().unwrap());
    }
    while !kept.is_empty() {
        from.push(kept.pop().unwrap());
    }
}

// A queue that adds and takes values at both ends, growing on the heap.
//
// `push_back` and `pop_front` make it a first in, first out queue;
// `push_back` and `pop_back` a stack. Every push and pop takes O(1) time
// on average.
//
// # Examples
//
// ```zeru
// import std.collections.vecdeque::{VecDeque};
//
// var queue: VecDeque<str> = VecDeque.new();
// queue.push_back("second");
// queue.push_back("third");
// queue.push_front("first");
// println("{}", queue.pop_front().unwrap()); // first
// println("{}", queue.pop_back().unwrap()); // third
// println("{}", queue.len()); // 1
// ```
//
// It is two stacks back to back: `front` holds the first values in
// reverse and `back` the rest in order.
pub struct VecDeque<T> {
    front: Vec<T>,
    back: Vec<T>,

    // Returns an empty queue.
    //
    // It allocates nothing until the first push.
    pub fn new() VecDeque<T> {
        return VecDeque { front: Vec.new(), back: Vec.new() };
    }

    // Adds `val` at the back.
    pub fn push_back(var self, val: T) {
        self.back.push(val);
    }

    // Adds `val` at the front.
    pub fn push_front(var self, val: T) {
        self.front.push(val);
    }

    // Removes the front value and returns it, or None when the queue is empty.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.vecdeque::{VecDeque};
    //
    // var jobs: VecDeque<i32> = VecDeque.new();
    // jobs.push_back(1);
    // jobs.push_back(2);
    // println("{}", jobs.pop_front().unwrap()); // 1
    // println("{}", jobs.pop_front().unwrap()); // 2
    // println("{}", jobs.pop_front().is_none()); // true
    // ```
    pub fn pop_front(var self) T? {
        if self.front.is_empty() {
            shift(&var self.back, &var self.front);
        }
        return self.front.pop();
    }

    // Removes the back value and returns it, or None when the queue is empty.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.vecdeque::{VecDeque};
    //
    // var undo: VecDeque<i32> = VecDeque.new();
    // undo.push_back(1);
    // undo.push_back(2);
    // println("{}", undo.pop_back().unwrap()); // 2
    // ```
    pub fn pop_back(var self) T? {
        if self.back.is_empty() {
            shift(&var self.front, &var self.back);
        }
        return self.back.pop();
    }

    // Returns a reference to the front value, or None when the queue is empty.
    //
    // The value stays in the queue.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.vecdeque::{VecDeque};
    //
    // var line: VecDeque<i32> = VecDeque.new();
    // line.push_back(8);
    // line.push_back(9);
    // println("{} {}", *line.front().unwrap(), line.len()); // 8 2
    // ```
    pub fn front(self) (&T)? {
        return self.at(0);
    }

    // Returns a reference to the back value, or None when the queue is empty.
    //
    // The value stays in the queue.
    pub fn back(self) (&T)? {
        if self.is_empty() {
            return None;
        }
        return self.at(self.len() - 1);
    }

    // Returns a reference to the value `index` places from the front, or None
    // past the end.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.vecdeque::{VecDeque};
    //
    // var q: VecDeque<i32> = VecDeque.new();
    // q.push_back(2);
    // q.push_front(1);
    // println("{} {}", *q.at(1).unwrap(), q.at(2).is_none()); // 2 true
    // ```
    pub fn at(self, index: usize) (&T)? {
        if index < self.front.len() {
            return &self.front[self.front.len() - 1 - index];
        }
        if index - self.front.len() < self.back.len() {
            return &self.back[index - self.front.len()];
        }
        return None;
    }

    // Returns how many values the queue holds.
    pub fn len(self) usize {
        return self.front.len() + self.back.len();
    }

    // Returns whether the queue holds no values.
    pub fn is_empty(self) bool {
        return self.len() == 0;
    }

    // Removes every value.
    pub fn clear(var self) {
        self.front.clear();
        self.back.clear();
    }
}
