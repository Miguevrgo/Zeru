// Zeru Standard Library - BinaryHeap (max-heap)

// A max-heap growing on the heap, the largest value always on top.
pub struct BinaryHeap<T: Ord> {
    data: Vec<T>,

    // An empty heap; it allocates on the first push.
    pub fn new() BinaryHeap<T> {
        return BinaryHeap { data: Vec.new() };
    }

    // Add `val`.
    pub fn push(var self, val: T) {
        self.data.push(val);
        var idx = self.data.len() - 1;
        while idx > 0 {
            var parent = (idx - 1) / 2;
            if self.data[idx] <= self.data[parent] {
                break;
            }
            self.swap(idx, parent);
            idx = parent;
        }
    }

    // Take out the largest value; None when empty.
    pub fn pop(var self) T? {
        if self.data.len() > 1 {
            self.swap(0, self.data.len() - 1);
        }
        var max_val = self.data.pop();
        var idx: usize = 0;
        while true {
            var left = 2 * idx + 1;
            var right = 2 * idx + 2;
            var largest = idx;
            if left < self.data.len() && self.data[left] > self.data[largest] {
                largest = left;
            }
            if right < self.data.len() && self.data[right] > self.data[largest] {
                largest = right;
            }
            if largest == idx {
                break;
            }
            self.swap(idx, largest);
            idx = largest;
        }
        return max_val;
    }

    fn swap(var self, a: usize, b: usize) {
        var tmp = self.data[a];
        self.data[a] = self.data[b];
        self.data[b] = tmp;
    }

    // The largest value, left in place; None when empty.
    pub fn peek(self) (&T)? {
        if self.data.is_empty() {
            return None;
        }
        return &self.data[0];
    }

    // How many values it holds.
    pub fn len(self) usize {
        return self.data.len();
    }

    // Whether it holds no values.
    pub fn is_empty(self) bool {
        return self.data.is_empty();
    }

    // Drop every value.
    pub fn clear(var self) {
        self.data.clear();
    }
}
