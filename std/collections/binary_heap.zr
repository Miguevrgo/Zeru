// Zeru Standard Library - BinaryHeap (max-heap)

// A collection that always gives back its largest value first, growing on
// the heap.
//
// Values are any type `<` compares. `push` and `pop` take O(log n) time,
// `peek` O(1). It suits picking the most urgent task or the biggest scores
// without sorting everything.
//
// # Examples
//
// ```zeru
// import std.collections.binary_heap::{BinaryHeap};
//
// var heap: BinaryHeap<i32> = BinaryHeap.new();
// for n in [3, 10, 1, 7] {
//     heap.push(n);
// }
// println("{}", heap.pop().unwrap()); // 10
// println("{}", heap.pop().unwrap()); // 7
// println("{}", heap.len()); // 2
// ```
pub struct BinaryHeap<T: Ord> {
    data: Vec<T>,

    // Returns an empty heap.
    //
    // It allocates nothing until the first `push`.
    pub fn new() BinaryHeap<T> {
        return BinaryHeap { data: Vec.new() };
    }

    // Adds `val`.
    pub fn push(var self, val: T) {
        self.data.push(val);
        var idx = self.data.len() - 1;
        while idx > 0 {
            var parent = (idx - 1) / 2;
            if self.data[idx] <= self.data[parent] {
                break;
            }
            self.swap(idx, parent);
            idx = parent;
        }
    }

    // Removes the largest value and returns it, or None when the heap is empty.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.binary_heap::{BinaryHeap};
    //
    // var heap: BinaryHeap<f64> = BinaryHeap.new();
    // heap.push(1.5);
    // heap.push(4.0);
    // println("{}", heap.pop().unwrap()); // 4.0
    // println("{}", heap.pop().unwrap()); // 1.5
    // println("{}", heap.pop().is_none()); // true
    // ```
    pub fn pop(var self) T? {
        if self.data.len() > 1 {
            self.swap(0, self.data.len() - 1);
        }
        var max_val = self.data.pop();
        var idx: usize = 0;
        while true {
            var left = 2 * idx + 1;
            var right = 2 * idx + 2;
            var largest = idx;
            if left < self.data.len() && self.data[left] > self.data[largest] {
                largest = left;
            }
            if right < self.data.len() && self.data[right] > self.data[largest] {
                largest = right;
            }
            if largest == idx {
                break;
            }
            self.swap(idx, largest);
            idx = largest;
        }
        return max_val;
    }

    fn swap(var self, a: usize, b: usize) {
        var tmp = self.data[a];
        self.data[a] = self.data[b];
        self.data[b] = tmp;
    }

    // Returns a reference to the largest value, or None when the heap is empty.
    //
    // The value stays in the heap.
    //
    // # Examples
    //
    // ```zeru
    // import std.collections.binary_heap::{BinaryHeap};
    //
    // var heap: BinaryHeap<i32> = BinaryHeap.new();
    // heap.push(5);
    // heap.push(9);
    // println("{} {}", *heap.peek().unwrap(), heap.len()); // 9 2
    // ```
    pub fn peek(self) (&T)? {
        if self.data.is_empty() {
            return None;
        }
        return &self.data[0];
    }

    // Returns how many values the heap holds.
    pub fn len(self) usize {
        return self.data.len();
    }

    // Returns whether the heap holds no values.
    pub fn is_empty(self) bool {
        return self.data.is_empty();
    }

    // Removes every value.
    pub fn clear(var self) {
        self.data.clear();
    }
}
