// Zeru Standard Library - Network (Linux x86_64)

pub const AF_INET: i64 = 2;
pub const AF_INET6: i64 = 10;
pub const SOCK_STREAM: i64 = 1;
pub const SOCK_DGRAM: i64 = 2;
pub const SHUT_RD: i64 = 0;
pub const SHUT_WR: i64 = 1;
pub const SHUT_RDWR: i64 = 2;

// Build IPv4 address from octets: ip4(127, 0, 0, 1)
pub fn ip4(a: u32, b: u32, c: u32, d: u32) u32 {
    return (a << 24) | (b << 16) | (c << 8) | d;
}

// Build sockaddr_in (16 bytes) for bind/connect.
pub fn make_addr(ip: u32, port: u16) Array<u8, 16> {
    var addr: Array<u8, 16> = [0; 16];
    addr[0] = AF_INET as u8;
    addr[1] = 0;
    addr[2] = ((port >> 8) & 255) as u8;
    addr[3] = (port & 255) as u8;
    addr[4] = ((ip >> 24) & 255) as u8;
    addr[5] = ((ip >> 16) & 255) as u8;
    addr[6] = ((ip >> 8) & 255) as u8;
    addr[7] = (ip & 255) as u8;
    return addr;
}


pub struct TcpListener {
    fd: i64,

    pub fn bind(ip: u32, port: u16) i64! {
        var fd = try sys_result(syscall3(41, AF_INET, SOCK_STREAM, 0));
        var one: i32 = 1;
        syscall5(54, fd, 1, 2, (&one) as i64, 4);
        var addr = make_addr(ip, port);
        var r: i64 = syscall3(49, fd, (&addr[0]) as i64, 16);
        if r < 0 { syscall1(3, fd); return sys_result(r); }
        r = syscall2(50, fd, 128);
        if r < 0 { syscall1(3, fd); return sys_result(r); }
        return Ok(fd);
    }

    pub fn accept(self) i64! {
        return sys_result(syscall3(43, self.fd, 0, 0));
    }

    pub fn close(self) i64! {
        return sys_result(syscall1(3, self.fd));
    }
}


pub struct TcpStream {
    fd: i64,

    pub fn connect(ip: u32, port: u16) i64! {
        var fd = try sys_result(syscall3(41, AF_INET, SOCK_STREAM, 0));
        var addr = make_addr(ip, port);
        var r: i64 = syscall3(42, fd, (&addr[0]) as i64, 16);
        if r < 0 { syscall1(3, fd); return sys_result(r); }
        return Ok(fd);
    }

    pub fn read(self, buf: *u8, len: usize) i64! {
        return sys_result(syscall3(0, self.fd, buf as i64, len as i64));
    }

    pub fn write(self, buf: *u8, len: usize) i64! {
        return sys_result(syscall3(1, self.fd, buf as i64, len as i64));
    }

    pub fn write_all(var self, buf: *u8, len: usize) i64! {
        var total: i64 = 0;
        var remaining: usize = len;
        while remaining > 0 {
            var n = try sys_result(syscall3(1, self.fd, (buf + total as usize) as i64, remaining as i64));
            total = total + n;
            remaining = remaining - n as usize;
        }
        return Ok(total);
    }

    pub fn read_all(var self, buf: *u8, buf_size: usize) i64! {
        var total: i64 = 0;
        var remaining: usize = buf_size;
        while remaining > 0 {
            var n = try sys_result(syscall3(0, self.fd, (buf + total as usize) as i64, remaining as i64));
            if n == 0 { break; }
            total = total + n;
            remaining = remaining - n as usize;
        }
        return Ok(total);
    }

    pub fn shutdown(self, how: i64) i64! {
        return sys_result(syscall2(48, self.fd, how));
    }

    pub fn close(self) i64! {
        return sys_result(syscall1(3, self.fd));
    }
}


pub struct UdpSocket {
    fd: i64,

    pub fn bind(ip: u32, port: u16) i64! {
        var fd = try sys_result(syscall3(41, AF_INET, SOCK_DGRAM, 0));
        var addr = make_addr(ip, port);
        var r: i64 = syscall3(49, fd, (&addr[0]) as i64, 16);
        if r < 0 { syscall1(3, fd); return sys_result(r); }
        return Ok(fd);
    }

    pub fn send_to(self, buf: *u8, len: usize, ip: u32, port: u16) i64! {
        var addr = make_addr(ip, port);
        return sys_result(syscall6(44, self.fd, buf as i64, len as i64, 0, (&addr[0]) as i64, 16));
    }

    pub fn recv(self, buf: *u8, len: usize) i64! {
        return sys_result(syscall6(45, self.fd, buf as i64, len as i64, 0, 0, 0));
    }

    pub fn close(self) i64! {
        return sys_result(syscall1(3, self.fd));
    }
}
