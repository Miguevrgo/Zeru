// Zeru Standard Library - OS (Linux x86_64)

const SYS_NANOSLEEP: i64 = 35;
const SYS_GETPID: i64 = 39;
const SYS_UNAME: i64 = 63;
const SYS_GETUID: i64 = 102;
const SYS_GETGID: i64 = 104;
const SYS_GETEUID: i64 = 107;
const SYS_GETEGID: i64 = 108;
const SYS_GETPPID: i64 = 110;
const SYS_CLOCK_GETTIME: i64 = 228;

// Returns the command line the program was started with.
//
// The first element is the path the program was run as, so the arguments
// the user typed start at index 1. The strings point into the process's
// own memory and stay valid for the whole run.
//
// # Examples
//
// ```zeru
// import std.os;
//
// var args = os::args();
// if args.len() < 2 {
//     eprintln("usage: {} <name>", args[0]);
//     return;
// }
// println("hello, {}", args[1]);
// ```
pub fn args() Vec<str> {
    var stack: i64 = 0;
    asm ("movq __zeru_stack(%rip), $0" : "=r" (stack));
    var count = *(stack as *i64);
    var out: Vec<str> = Vec.with_capacity(count as usize);
    for i in 1..count + 1 {
        var text = *((stack + 8 * i) as *i64) as *u8;
        var len: usize = 0;
        while *(text + len) != 0 {
            len += 1;
        }
        var parts = (text, len);
        out.push(*((&parts) as *str));
    }
    return out;
}

// Returns the id of this process.
pub fn getpid() i64 { return syscall1(SYS_GETPID, 0); }
// Returns the id of the process that started this one.
pub fn getppid() i64 { return syscall1(SYS_GETPPID, 0); }
// Returns the id of the user running the program, 0 for root.
pub fn getuid() i64 { return syscall1(SYS_GETUID, 0); }
// Returns the id of the group running the program.
pub fn getgid() i64 { return syscall1(SYS_GETGID, 0); }
// Returns the effective user id, the one permissions are checked against.
//
// It differs from `getuid` only in programs installed setuid.
pub fn geteuid() i64 { return syscall1(SYS_GETEUID, 0); }
// Returns the effective group id, the one permissions are checked against.
//
// It differs from `getgid` only in programs installed setgid.
pub fn getegid() i64 { return syscall1(SYS_GETEGID, 0); }

// Pauses the program for `ms` milliseconds, returning 0.
//
// # Errors
//
// The errno: 22 (EINVAL) for a negative `ms`, 4 (EINTR) when a signal
// wakes it early.
//
// # Examples
//
// ```zeru
// import std.os;
//
// var start = os::clock_ns().unwrap();
// os::sleep_ms(20).unwrap();
// println("{}", os::clock_ns().unwrap() - start >= 20_000_000); // true
// ```
pub fn sleep_ms(ms: i64) i64! {
    var ts: Array<i64, 2> = [ms / 1000, (ms % 1000) * 1000000];
    return sys_result(syscall2(SYS_NANOSLEEP, (&ts[0]) as i64, 0));
}

// Returns a time in nanoseconds for measuring how long something takes.
//
// The clock only moves forward and is not the time of day; only the
// difference between two calls means anything. `time` gives the time of
// day.
//
// # Errors
//
// The errno; it does not fail on Linux.
//
// # Examples
//
// ```zeru
// import std.os;
//
// var start = os::clock_ns().unwrap();
// var total = 0;
// for i in 0..1000 {
//     total += i;
// }
// var elapsed = os::clock_ns().unwrap() - start;
// println("{} {}", total, elapsed >= 0); // 499500 true
// ```
pub fn clock_ns() i64! {
    var ts: Array<i64, 2> = [0; 2];
    sys_result(syscall2(SYS_CLOCK_GETTIME, 1, (&ts[0]) as i64))!;
    return Ok(ts[0] * 1000000000 + ts[1]);
}

// Returns the time of day as whole seconds since 1970-01-01 00:00 UTC.
//
// It follows the system clock, which may be set back or forward; use
// `clock_ns` to measure durations.
//
// # Errors
//
// The errno; it does not fail on Linux.
//
// # Examples
//
// ```zeru
// import std.os;
//
// var now = os::time().unwrap();
// println("{}", now / 86400 > 20000); // true
// ```
pub fn time() i64! {
    var ts: Array<i64, 2> = [0; 2];
    sys_result(syscall2(SYS_CLOCK_GETTIME, 0, (&ts[0]) as i64))!;
    return Ok(ts[0]);
}

// Writes the name of the machine to `buf` and returns 0.
//
// `buf` gets the name and a closing NUL, cut to `size - 1` bytes when
// longer. 65 bytes fit any host name. A `size` of 0 writes nothing.
//
// # Errors
//
// The errno; it does not fail on Linux.
//
// # Examples
//
// ```zeru
// import std.os;
//
// var buf: Array<u8, 65> = [0; 65];
// os::hostname(&buf[0], 65).unwrap();
// println("{}", buf[0] != 0); // true
// ```
pub fn hostname(buf: *u8, size: usize) i64! {
    if size == 0 { return Ok(0); }
    var utsname: Array<u8, 390> = [0; 390];
    sys_result(syscall1(SYS_UNAME, (&utsname[0]) as i64))!;
    var i: usize = 0;
    while i < 64 && i < size - 1 {
        var src: *u8 = &utsname[65 + i];
        if *src == 0 { break; }
        var dst: *u8 = buf + i;
        *dst = *src;
        i += 1;
    }
    var term: *u8 = buf + i;
    *term = 0;
    return Ok(0);
}
