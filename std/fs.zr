// Zeru Standard Library - File System (Linux x86_64)

const SYS_OPEN: i64 = 2;
const SYS_STAT: i64 = 4;
const SYS_LSEEK: i64 = 8;
const SYS_ACCESS: i64 = 21;
const SYS_FSYNC: i64 = 74;
const SYS_TRUNCATE: i64 = 76;
const SYS_RENAME: i64 = 82;
const SYS_MKDIR: i64 = 83;
const SYS_RMDIR: i64 = 84;
const SYS_UNLINK: i64 = 87;

pub const O_RDONLY: i64 = 0;
pub const O_WRONLY: i64 = 1;
pub const O_RDWR: i64 = 2;
pub const O_CREAT: i64 = 64;
pub const O_TRUNC: i64 = 512;
pub const O_APPEND: i64 = 1024;
pub const O_EXCL: i64 = 128;

pub const SEEK_SET: i64 = 0;
pub const SEEK_CUR: i64 = 1;
pub const SEEK_END: i64 = 2;

pub const PERM_644: i64 = 420;
pub const PERM_755: i64 = 493;
pub const PERM_600: i64 = 384;
pub const PERM_700: i64 = 448;

pub fn open(path: *u8, flags: i64, mode: i64) i64! {
    return sys_result(syscall3(SYS_OPEN, path as i64, flags, mode));
}

pub fn close(fd: i64) i64! {
    return sys_result(syscall1(SYS_CLOSE, fd));
}

pub fn read(fd: i64, buf: *u8, count: usize) i64! {
    return sys_result(syscall3(SYS_READ, fd, buf as i64, count as i64));
}

pub fn write(fd: i64, buf: *u8, count: usize) i64! {
    return sys_result(syscall3(SYS_WRITE, fd, buf as i64, count as i64));
}

pub fn lseek(fd: i64, offset: i64, whence: i64) i64! {
    return sys_result(syscall3(SYS_LSEEK, fd, offset, whence));
}

pub fn mkdir(path: *u8, mode: i64) i64! {
    return sys_result(syscall2(SYS_MKDIR, path as i64, mode));
}

pub fn rmdir(path: *u8) i64! {
    return sys_result(syscall1(SYS_RMDIR, path as i64));
}

pub fn unlink(path: *u8) i64! {
    return sys_result(syscall1(SYS_UNLINK, path as i64));
}

pub fn rename(old_path: *u8, new_path: *u8) i64! {
    return sys_result(syscall2(SYS_RENAME, old_path as i64, new_path as i64));
}

pub fn file_size(path: *u8) i64! {
    var buf: Array<u8, 144> = [0; 144];
    var ptr: *u8 = &buf[0];
    sys_result(syscall2(SYS_STAT, path as i64, ptr as i64))!;
    var size_ptr: *i64 = (&buf[48]) as *i64;
    return Ok(*size_ptr);
}

pub fn exists(path: *u8) bool {
    return syscall2(SYS_ACCESS, path as i64, 0) == 0;
}

pub fn truncate(path: *u8, length: i64) i64! {
    return sys_result(syscall2(SYS_TRUNCATE, path as i64, length));
}

pub fn fsync(fd: i64) i64! {
    return sys_result(syscall1(SYS_FSYNC, fd));
}

pub fn read_file(path: *u8, buf: *u8, buf_size: usize) i64! {
    var fd = open(path, O_RDONLY, 0)!;
    var total: usize = 0;
    while total < buf_size {
        var n = read(fd, buf + total, buf_size - total);
        if n.is_err() { close(fd); return n; }
        if n.unwrap() == 0 { break; }
        total += n.unwrap() as usize;
    }
    close(fd);
    return Ok(total as i64);
}

pub fn write_file(path: *u8, data: *u8, len: usize) i64! {
    var fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, PERM_644)!;
    var total: usize = 0;
    while total < len {
        var n = write(fd, data + total, len - total);
        if n.is_err() { close(fd); return n; }
        total += n.unwrap() as usize;
    }
    close(fd);
    return Ok(total as i64);
}
