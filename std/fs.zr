// Zeru Standard Library - File System (Linux x86_64)

const SYS_OPEN: i64 = 2;
const SYS_STAT: i64 = 4;
const SYS_FSTAT: i64 = 5;
const SYS_LSTAT: i64 = 6;
const SYS_LSEEK: i64 = 8;
const SYS_SENDFILE: i64 = 40;
const SYS_CHDIR: i64 = 80;
const SYS_GETCWD: i64 = 79;
const SYS_FTRUNCATE: i64 = 77;
const SYS_RENAME: i64 = 82;
const SYS_MKDIR: i64 = 83;
const SYS_RMDIR: i64 = 84;
const SYS_LINK: i64 = 86;
const SYS_UNLINK: i64 = 87;
const SYS_SYMLINK: i64 = 88;
const SYS_READLINK: i64 = 89;
const SYS_CHMOD: i64 = 90;
const SYS_FCHMOD: i64 = 91;
const SYS_CHOWN: i64 = 92;
const SYS_GETDENTS64: i64 = 217;
const SYS_NEWFSTATAT: i64 = 262;
const SYS_UTIMENSAT: i64 = 280;

const O_RDONLY: i64 = 0;
const O_WRONLY: i64 = 1;
const O_CREAT: i64 = 64;
const O_EXCL: i64 = 128;
const O_TRUNC: i64 = 512;
const O_APPEND: i64 = 1024;
const O_DIRECTORY: i64 = 65536;
const O_PATH: i64 = 2097152;
const AT_FDCWD: i64 = -100;
const AT_SYMLINK_NOFOLLOW: i64 = 256;
const UTIME_OMIT: i64 = 1073741822;

// Longest path Linux takes, its closing NUL included.
const PATH_MAX: usize = 4096;

// Bytes a `File` asks the kernel for at a time when reading lines.
const CHUNK: usize = 4096;

// Room for the entries of a directory that one getdents64 call fills.
const DIR_BATCH: usize = 65536;

// `path` and a closing NUL in `buf`, as a syscall takes it; `buf` as an
// address, or the error code: 36 (ENAMETOOLONG) when it does not fit, 22
// (EINVAL) when it holds a NUL, which would end it early.
fn c_path(path: str, buf: *u8) i64! {
    if path.len() >= PATH_MAX {
        return Err(36);
    }
    for byte in path {
        if byte == 0 {
            return Err(22);
        }
    }
    __zeru_copy_bytes(buf, path as *u8, path.len());
    *(buf + path.len()) = 0;
    return Ok(buf as i64);
}

// A syscall that takes one path and returns 0 on success.
fn on_path(nr: i64, path: str, arg: i64) ! {
    var buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var p = c_path(path, &buf[0])!;
    sys_result(syscall2(nr, p, arg))!;
}

// A syscall that takes two paths and returns 0 on success.
fn on_paths(nr: i64, first: str, second: str) ! {
    var first_buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var second_buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var a = c_path(first, &first_buf[0])!;
    var b = c_path(second, &second_buf[0])!;
    sys_result(syscall2(nr, a, b))!;
}

// What kind of thing a path names.
pub enum Kind {
    File,
    Dir,
    Symlink,
    Other,
}

fn kind_of(mode: u32) Kind {
    var format = mode & 0o170000;
    if format == 0o100000 {
        return Kind::File;
    }
    if format == 0o040000 {
        return Kind::Dir;
    }
    if format == 0o120000 {
        return Kind::Symlink;
    }
    return Kind::Other;
}

// What the file system knows about a file, directory or link.
//
// `mode` holds the permissions, as `0o644`. `accessed` and `modified` are
// nanoseconds since 1970-01-01 00:00 UTC.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("data.txt", "12345").unwrap();
// var meta = fs::metadata("data.txt").unwrap();
// println("{} {}", meta.size, meta.mode == 0o644); // 5 true
// match meta.kind {
//     fs::Kind::File => println("a file"), // a file
//     default => println("something else"),
// }
// ```
pub struct Metadata {
    kind: Kind,
    size: usize,
    mode: u32,
    uid: u32,
    gid: u32,
    accessed: i64,
    modified: i64,
}

// Metadata from the `struct stat` a stat syscall fills.
fn metadata_of(stat: Array<i64, 18>) Metadata {
    var mode = ((stat[3] as u64) & 0xffffffff) as u32;
    return Metadata {
        kind: kind_of(mode),
        size: stat[6] as usize,
        mode: mode & 0o7777,
        uid: ((stat[3] as u64) >> 32) as u32,
        gid: ((stat[4] as u64) & 0xffffffff) as u32,
        accessed: stat[9] * 1000000000 + stat[10],
        modified: stat[11] * 1000000000 + stat[12],
    };
}

fn stat_path(nr: i64, path: str) Metadata! {
    var buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var p = c_path(path, &buf[0])!;
    var stat: Array<i64, 18> = [0; 18];
    sys_result(syscall2(nr, p, (&stat[0]) as i64))!;
    return Ok(metadata_of(stat));
}

fn open_path(path: str, flags: i64, mode: i64) i64! {
    var buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var p = c_path(path, &buf[0])!;
    return sys_result(syscall3(SYS_OPEN, p, flags, mode));
}

// Write all of `data` to `fd`.
fn write_all(fd: i64, data: str) ! {
    var done: usize = 0;
    while done < data.len() {
        var n = sys_result(
            syscall3(SYS_WRITE, fd, ((data as *u8) + done) as i64, (data.len() - done) as i64),
        )!;
        done += n as usize;
    }
}

// Write `data` to the file `open` gives, and close it.
fn write_to(path: str, flags: i64, data: str) ! {
    var fd = open_path(path, flags, 0o644)!;
    var wrote = write_all(fd, data);
    syscall1(SYS_CLOSE, fd);
    wrote!;
}

// Reads the whole file at `path` and returns its contents.
//
// An empty file gives an empty String. `File` reads a part, or a line at a
// time.
//
// # Errors
//
// The errno: 2 (ENOENT) when the file is missing, 13 (EACCES) without
// permission, 21 (EISDIR) for a directory.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("hello.txt", "one\ntwo\n").unwrap();
// var text = fs::read_file("hello.txt").unwrap();
// var lines = text.lines();
// println("{} {}", lines.len(), lines[1]); // 2 two
// println("{}", fs::read_file("missing.txt").unwrap_err()); // 2
// ```
pub fn read_file(path: str) String! {
    var file = File.open(path)!;
    var stat: Array<i64, 18> = [0; 18];
    sys_result(syscall2(SYS_FSTAT, file.fd, (&stat[0]) as i64))!;
    var size = stat[6] as usize;
    var text = String.new();
    while true {
        var want = CHUNK;
        if text.len() < size {
            want = size - text.len();
        }
        if file.read(&var text, want)! == 0 {
            break;
        }
    }
    return Ok(text);
}

// Writes `data` to the file at `path`, creating it or replacing what it
// held.
//
// A new file gets permissions `0o644`.
//
// # Errors
//
// The errno: 2 (ENOENT) when the directory it goes in is missing, 13
// (EACCES) without permission, 21 (EISDIR) when `path` is a directory, 28
// (ENOSPC) when the disk is full.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("note.txt", "remember").unwrap();
// println("{}", fs::read_file("note.txt").unwrap()); // remember
// ```
pub fn write_file(path: str, data: str) ! {
    write_to(path, O_WRONLY | O_CREAT | O_TRUNC, data)!;
}

// Adds `data` at the end of the file at `path`, creating it when missing.
//
// A new file gets permissions `0o644`.
//
// # Errors
//
// The errno: 2 (ENOENT) when the directory it goes in is missing, 13
// (EACCES) without permission, 21 (EISDIR) when `path` is a directory.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::append_file("log.txt", "start\n").unwrap();
// fs::append_file("log.txt", "stop\n").unwrap();
// var log = fs::read_file("log.txt").unwrap();
// println("{}", log.lines().len()); // 2
// ```
pub fn append_file(path: str, data: str) ! {
    write_to(path, O_WRONLY | O_CREAT | O_APPEND, data)!;
}

// An open file, to read or write a part at a time.
//
// Open one with `File.open` to read, or `File.create`, `File.create_new`
// or `File.append` to write. It closes when it goes out of scope.
// `read_file` and `write_file` do a whole file in one call.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// var out = fs::File.create("list.txt").unwrap();
// out.write("apples\npears\n").unwrap();
// var input = fs::File.open("list.txt").unwrap();
// println("{}", input.read_line().unwrap().unwrap()); // apples
// println("{}", input.read_line().unwrap().unwrap()); // pears
// println("{}", input.read_line().unwrap().is_none()); // true
// ```
pub struct File {
    fd: i64,
    buffer: Vec<u8>,
    start: usize,

    // Opens the file at `path` for reading.
    //
    // # Errors
    //
    // The errno: 2 (ENOENT) when the file is missing, 13 (EACCES) without
    // permission.
    //
    // # Examples
    //
    // ```zeru
    // import std.fs;
    //
    // println("{}", fs::File.open("missing.txt").is_err()); // true
    // ```
    pub fn open(path: str) File! {
        var fd = open_path(path, O_RDONLY, 0)!;
        return Ok(File { fd: fd, buffer: Vec.new(), start: 0 });
    }

    // Opens the file at `path` for writing, creating it or emptying what it
    // held.
    //
    // A new file gets permissions `0o644`.
    //
    // # Errors
    //
    // The errno: 2 (ENOENT) when the directory it goes in is missing, 13
    // (EACCES) without permission, 21 (EISDIR) when `path` is a directory.
    pub fn create(path: str) File! {
        var fd = open_path(path, O_WRONLY | O_CREAT | O_TRUNC, 0o644)!;
        return Ok(File { fd: fd, buffer: Vec.new(), start: 0 });
    }

    // Creates a file at `path` for writing, failing when one is there.
    //
    // Two programs racing to create the same file cannot both succeed,
    // which makes it right for lock files. A new file gets permissions
    // `0o644`.
    //
    // # Errors
    //
    // The errno: 17 (EEXIST) when something is at `path`, 2 (ENOENT) when the
    // directory it goes in is missing.
    //
    // # Examples
    //
    // ```zeru
    // import std.fs;
    //
    // println("{}", fs::File.create_new("app.lock").is_ok()); // true
    // println("{}", fs::File.create_new("app.lock").unwrap_err()); // 17
    // ```
    pub fn create_new(path: str) File! {
        var fd = open_path(path, O_WRONLY | O_CREAT | O_EXCL, 0o644)!;
        return Ok(File { fd: fd, buffer: Vec.new(), start: 0 });
    }

    // Opens the file at `path` to write at its end, creating it when
    // missing.
    //
    // A new file gets permissions `0o644`.
    //
    // # Errors
    //
    // The errno: 2 (ENOENT) when the directory it goes in is missing, 13
    // (EACCES) without permission.
    //
    // # Examples
    //
    // ```zeru
    // import std.fs;
    //
    // fs::write_file("log.txt", "one\n").unwrap();
    // var log = fs::File.append("log.txt").unwrap();
    // log.write("two\n").unwrap();
    // println("{}", fs::read_file("log.txt").unwrap().len()); // 8
    // ```
    pub fn append(path: str) File! {
        var fd = open_path(path, O_WRONLY | O_CREAT | O_APPEND, 0o644)!;
        return Ok(File { fd: fd, buffer: Vec.new(), start: 0 });
    }

    // Reads up to `count` bytes, adds them at the end of `buf` and returns
    // how many came.
    //
    // It may read fewer than `count`, so call it again for the rest; 0 means
    // the end of the file.
    //
    // # Errors
    //
    // The errno: 9 (EBADF) when the file is open for writing only, 21
    // (EISDIR) for a directory.
    //
    // # Examples
    //
    // ```zeru
    // import std.fs;
    //
    // fs::write_file("data.bin", "abcdef").unwrap();
    // var file = fs::File.open("data.bin").unwrap();
    // var buf = String.new();
    // println("{}", file.read(&var buf, 4).unwrap()); // 4
    // println("{}", file.read(&var buf, 4).unwrap()); // 2
    // println("{} {}", buf.len(), buf[5] == 'f'); // 6 true
    // ```
    pub fn read(var self, buf: &var String, count: usize) usize! {
        var end = __zeru_room(buf, count);
        var held = self.buffer.len() - self.start;
        if held > 0 {
            var n = count;
            if held < n {
                n = held;
            }
            __zeru_copy_bytes(end, &self.buffer[self.start], n);
            self.start += n;
            __zeru_filled(buf, n);
            return Ok(n);
        }
        var n = sys_result(syscall3(SYS_READ, self.fd, end as i64, count as i64))! as usize;
        __zeru_filled(buf, n);
        return Ok(n);
    }

    // Reads the next line, without its "\n" or "\r\n", or None at the end
    // of the file.
    //
    // The line is a String of its own, kept as long as needed. A last line
    // without "\n" still counts.
    //
    // # Errors
    //
    // The errno: 9 (EBADF) when the file is open for writing only.
    //
    // # Examples
    //
    // ```zeru
    // import std.fs;
    //
    // fs::write_file("names.txt", "ann\r\nbob").unwrap();
    // var file = fs::File.open("names.txt").unwrap();
    // var count = 0;
    // while true {
    //     var line = file.read_line().unwrap();
    //     if line.is_none() {
    //         break;
    //     }
    //     count += 1;
    // }
    // println("{}", count); // 2
    // ```
    pub fn read_line(var self) (String?)! {
        var at = self.start;
        while true {
            while at < self.buffer.len() {
                if self.buffer[at] == '\n' {
                    var line = self.take(at, true);
                    self.start = at + 1;
                    return Ok(line);
                }
                at += 1;
            }
            if self.start > 0 {
                var kept = self.buffer.len() - self.start;
                for i in 0..kept {
                    self.buffer[i] = self.buffer[self.start + i];
                }
                while self.buffer.len() > kept {
                    self.buffer.pop();
                }
                at = kept;
                self.start = 0;
            }
            var end = __zeru_room(&var self.buffer, CHUNK);
            var n = sys_result(syscall3(SYS_READ, self.fd, end as i64, CHUNK as i64))! as usize;
            __zeru_filled(&var self.buffer, n);
            if n == 0 {
                if self.buffer.len() == 0 {
                    return Ok(None);
                }
                var last = self.take(self.buffer.len(), false);
                self.start = self.buffer.len();
                return Ok(last);
            }
        }
        return Ok(None);
    }

    // The buffered bytes from `start` up to `end`, without the "\r" of a
    // "\r\n" when `newline` says a "\n" is at `end`.
    fn take(self, end: usize, newline: bool) String? {
        var stop = end;
        if newline && stop > self.start && self.buffer[stop - 1] == '\r' {
            stop -= 1;
        }
        if stop == self.start {
            return String.new();
        }
        return String.from(self.buffer[self.start..stop]);
    }

    // Moves to `offset` bytes from the start, where the next read or write
    // happens.
    //
    // # Errors
    //
    // The errno: 29 (ESPIPE) for a pipe or socket.
    //
    // # Examples
    //
    // ```zeru
    // import std.fs;
    //
    // fs::write_file("abc.txt", "abcdef").unwrap();
    // var file = fs::File.open("abc.txt").unwrap();
    // file.seek(4).unwrap();
    // println("{}", file.read_line().unwrap().unwrap()); // ef
    // ```
    pub fn seek(var self, offset: usize) ! {
        sys_result(syscall3(SYS_LSEEK, self.fd, offset as i64, 0))!;
        self.buffer.clear();
        self.start = 0;
    }

    // Writes all of `data`.
    //
    // # Errors
    //
    // The errno: 9 (EBADF) when the file is open for reading only, 28
    // (ENOSPC) when the disk is full.
    //
    // # Examples
    //
    // ```zeru
    // import std.fs;
    //
    // var file = fs::File.create("out.txt").unwrap();
    // file.write("a").unwrap();
    // file.write("bc").unwrap();
    // println("{}", fs::read_file("out.txt").unwrap()); // abc
    // ```
    pub fn write(var self, data: str) ! {
        write_all(self.fd, data)!;
    }

    fn drop(var self) {
        if self.fd > 2 {
            syscall1(SYS_CLOSE, self.fd);
        }
    }
}

// Deletes the file at `path`.
//
// For files and links; `remove_dir` removes directories. A file still open
// elsewhere stays readable there until it is closed.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there, 21 (EISDIR) for a directory,
// 13 (EACCES) without permission.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("old.txt", "bye").unwrap();
// fs::remove_file("old.txt").unwrap();
// println("{}", fs::remove_file("old.txt").unwrap_err()); // 2
// ```
pub fn remove_file(path: str) ! {
    on_path(SYS_UNLINK, path, 0)!;
}

// Moves the file or directory at `from` to `to`.
//
// What is already at `to` is replaced, unless it is a directory that is not
// empty. Both must be on the same file system; `copy_file` and
// `remove_file` move a file between them.
//
// # Errors
//
// The errno: 2 (ENOENT) when `from` does not exist, 18 (EXDEV) when the
// paths are on different file systems, 13 (EACCES) without permission.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("draft.txt", "text").unwrap();
// fs::rename("draft.txt", "final.txt").unwrap();
// println("{} {}", fs::exists("draft.txt"), fs::exists("final.txt")); // false true
// ```
pub fn rename(from: str, to: str) ! {
    on_paths(SYS_RENAME, from, to)!;
}

// Copies the contents and permissions of the file at `from` to `to`,
// replacing what `to` held.
//
// # Errors
//
// The errno: 2 (ENOENT) when `from` is missing, 21 (EISDIR) when either is
// a directory, 28 (ENOSPC) when the disk is full, 22 (EINVAL) when both
// paths name the same file, which is left as it was.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("a.txt", "same").unwrap();
// fs::copy_file("a.txt", "b.txt").unwrap();
// println("{}", fs::read_file("b.txt").unwrap()); // same
// ```
pub fn copy_file(from: str, to: str) ! {
    var source = File.open(from)!;
    var target = File {
        fd: open_path(to, O_WRONLY | O_CREAT, 0o644)!,
        buffer: Vec.new(),
        start: 0,
    };
    var read: Array<i64, 18> = [0; 18];
    var written: Array<i64, 18> = [0; 18];
    sys_result(syscall2(SYS_FSTAT, source.fd, (&read[0]) as i64))!;
    sys_result(syscall2(SYS_FSTAT, target.fd, (&written[0]) as i64))!;
    if read[0] == written[0] && read[1] == written[1] {
        return Err(22);
    }
    sys_result(syscall2(SYS_FTRUNCATE, target.fd, 0))!;
    sys_result(syscall2(SYS_FCHMOD, target.fd, metadata_of(read).mode as i64))!;
    while true {
        var n = sys_result(syscall5(SYS_SENDFILE, target.fd, source.fd, 0, 1073741824, 0))!;
        if n == 0 {
            break;
        }
    }
}

// Returns whether there is a file, directory or anything else at `path`.
//
// Any error, such as no permission to look, gives false.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("here.txt", "").unwrap();
// println("{} {}", fs::exists("here.txt"), fs::exists("nowhere.txt")); // true false
// ```
pub fn exists(path: str) bool {
    return symlink_metadata(path).is_ok();
}

// Returns whether `path` is a file, following symlinks.
//
// Any error, such as nothing being there, gives false.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("x.txt", "").unwrap();
// println("{} {}", fs::is_file("x.txt"), fs::is_file(".")); // true false
// ```
pub fn is_file(path: str) bool {
    var meta = metadata(path);
    return meta.is_ok() && meta.unwrap().kind == Kind::File;
}

// Returns whether `path` is a directory, following symlinks.
//
// Any error, such as nothing being there, gives false.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// println("{} {}", fs::is_dir("."), fs::is_dir("nowhere")); // true false
// ```
pub fn is_dir(path: str) bool {
    var meta = metadata(path);
    return meta.is_ok() && meta.unwrap().kind == Kind::Dir;
}

// Returns what the file system knows about `path`, following symlinks.
//
// `symlink_metadata` describes a link itself.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there, 13 (EACCES) without
// permission to look.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("five.txt", "12345").unwrap();
// println("{}", fs::metadata("five.txt").unwrap().size); // 5
// println("{}", fs::metadata("missing.txt").unwrap_err()); // 2
// ```
pub fn metadata(path: str) Metadata! {
    return stat_path(SYS_STAT, path);
}

// Returns what the file system knows about `path` without following a
// symlink there, so a link gives `Kind::Symlink`.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there, 13 (EACCES) without
// permission to look.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("real.txt", "").unwrap();
// fs::symlink("real.txt", "alias.txt").unwrap();
// match fs::symlink_metadata("alias.txt").unwrap().kind {
//     fs::Kind::Symlink => println("a link"), // a link
//     default => println("not a link"),
// }
// ```
pub fn symlink_metadata(path: str) Metadata! {
    return stat_path(SYS_LSTAT, path);
}

// Sets the permissions of `path`, as `0o644` or `0o755`.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there, 1 (EPERM) when the file is
// not yours.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("run.sh", "echo hi\n").unwrap();
// fs::set_permissions("run.sh", 0o755).unwrap();
// println("{}", fs::metadata("run.sh").unwrap().mode == 0o755); // true
// ```
pub fn set_permissions(path: str, mode: u32) ! {
    on_path(SYS_CHMOD, path, mode as i64)!;
}

// Sets the user and group that own `path`; None leaves that one as it is.
//
// Only root may give a file away; others may only change its group to one
// of their own.
//
// # Errors
//
// The errno: 1 (EPERM) without the right to, 2 (ENOENT) when nothing is
// there.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("mine.txt", "").unwrap();
// var meta = fs::metadata("mine.txt").unwrap();
// fs::set_owner("mine.txt", None, meta.gid).unwrap();
// println("{}", fs::set_owner("mine.txt", 0, None).is_ok() == (meta.uid == 0)); // true
// ```
pub fn set_owner(path: str, uid: u32?, gid: u32?) ! {
    var buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var p = c_path(path, &buf[0])!;
    var user: i64 = -1;
    var group: i64 = -1;
    if uid.is_some() {
        user = uid.unwrap() as i64;
    }
    if gid.is_some() {
        group = gid.unwrap() as i64;
    }
    sys_result(syscall3(SYS_CHOWN, p, user, group))!;
}

// Sets when `path` was last accessed and modified, in nanoseconds since
// 1970-01-01 00:00 UTC; None leaves that one as it is.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there, 1 (EPERM) when the file is
// not yours.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("old.txt", "").unwrap();
// fs::set_times("old.txt", None, 1000000000).unwrap();
// println("{}", fs::metadata("old.txt").unwrap().modified); // 1000000000
// ```
pub fn set_times(path: str, accessed: i64?, modified: i64?) ! {
    var buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var p = c_path(path, &buf[0])!;
    var times: Array<i64, 4> = [0, UTIME_OMIT, 0, UTIME_OMIT];
    if accessed.is_some() {
        var time = timespec(accessed.unwrap());
        times[0] = time.0;
        times[1] = time.1;
    }
    if modified.is_some() {
        var time = timespec(modified.unwrap());
        times[2] = time.0;
        times[3] = time.1;
    }
    sys_result(syscall5(SYS_UTIMENSAT, AT_FDCWD, p, (&times[0]) as i64, 0, 0))!;
}

// Nanoseconds since 1970 as the seconds and nanoseconds a syscall takes,
// the nanoseconds never negative, even before 1970.
fn timespec(ns: i64) (i64, i64) {
    var seconds = ns / 1000000000;
    var rest = ns % 1000000000;
    if rest < 0 {
        seconds -= 1;
        rest += 1000000000;
    }
    return (seconds, rest);
}

// One thing in a directory: its name and what kind of thing it is.
pub struct Entry {
    name: String,
    kind: Kind,
}

// Returns the files, directories and links inside the directory at `path`.
//
// "." and ".." are left out, and the order is the file system's own, not
// sorted. A symlink counts as `Kind::Symlink`, not as what it points to.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there, 20 (ENOTDIR) when it is not
// a directory, 13 (EACCES) without permission.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::create_dir("box").unwrap();
// fs::write_file("box/a.txt", "").unwrap();
// fs::create_dir("box/inner").unwrap();
// var files = 0;
// for entry in fs::read_dir("box").unwrap() {
//     match entry.kind {
//         fs::Kind::File => files += 1,
//         default => {}
//     }
// }
// println("{} {}", fs::read_dir("box").unwrap().len(), files); // 2 1
// ```
pub fn read_dir(path: str) Vec<Entry>! {
    var dir = File { fd: open_path(path, O_RDONLY | O_DIRECTORY, 0)!, buffer: Vec.new(), start: 0 };
    var fd = dir.fd;
    var entries: Vec<Entry> = Vec.new();
    var space = String.new();
    var batch = __zeru_room(&var space, DIR_BATCH);
    while true {
        var got = sys_result(
            syscall3(SYS_GETDENTS64, fd, batch as i64, DIR_BATCH as i64),
        )! as usize;
        if got == 0 {
            break;
        }
        var at: usize = 0;
        while at < got {
            var record = batch + at;
            var size = *((record + 16) as *u16) as usize;
            var name = record + 19;
            var text = __zeru_c_text(name);
            at += size;
            if text == "." || text == ".." {
                continue;
            }
            var tag = *(record + 18);
            var kind = kind_of((tag as u32) << 12);
            if tag == 0 {
                var stat: Array<i64, 18> = [0; 18];
                var looked = syscall5(
                    SYS_NEWFSTATAT,
                    fd,
                    name as i64,
                    (&stat[0]) as i64,
                    AT_SYMLINK_NOFOLLOW,
                    0,
                );
                if looked == 0 {
                    kind = metadata_of(stat).kind;
                }
            }
            entries.push(Entry { name: String.from(text), kind: kind });
        }
    }
    return Ok(entries);
}

// Creates a directory at `path`.
//
// The directory above it must exist already. It gets permissions `0o777`
// less the process's umask, usually `0o755`.
//
// # Errors
//
// The errno: 17 (EEXIST) when something is there already, 2 (ENOENT) when
// the directory above is missing, 13 (EACCES) without permission.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::create_dir("cache").unwrap();
// println("{}", fs::create_dir("cache").unwrap_err()); // 17
// ```
pub fn create_dir(path: str) ! {
    on_path(SYS_MKDIR, path, 0o777)!;
}

// Removes the empty directory at `path`.
//
// # Errors
//
// The errno: 39 (ENOTEMPTY) when it holds anything, 2 (ENOENT) when it does
// not exist, 20 (ENOTDIR) when it is not a directory.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::create_dir("tmp").unwrap();
// fs::remove_dir("tmp").unwrap();
// println("{}", fs::exists("tmp")); // false
// ```
pub fn remove_dir(path: str) ! {
    on_path(SYS_RMDIR, path, 0)!;
}

// Creates a symlink at `path` that points to `target`, in the order of
// `ln -s`.
//
// `target` is stored as written; it may not exist, and a relative one is
// read from the directory the link is in.
//
// # Errors
//
// The errno: 17 (EEXIST) when something is at `path`, 2 (ENOENT) when the
// directory it goes in is missing.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("config.txt", "on").unwrap();
// fs::symlink("config.txt", "current.txt").unwrap();
// println("{}", fs::read_file("current.txt").unwrap()); // on
// ```
pub fn symlink(target: str, path: str) ! {
    on_paths(SYS_SYMLINK, target, path)!;
}

// Returns what the symlink at `path` points to, as it was written.
//
// # Errors
//
// The errno: 22 (EINVAL) when `path` is not a symlink, 2 (ENOENT) when
// nothing is there.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::symlink("../data/file.txt", "link").unwrap();
// println("{}", fs::read_link("link").unwrap()); // ../data/file.txt
// ```
pub fn read_link(path: str) String! {
    var buf: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var p = c_path(path, &buf[0])!;
    var text: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var len = sys_result(syscall3(SYS_READLINK, p, (&text[0]) as i64, PATH_MAX as i64))!;
    return Ok(String.from(text[..len as usize]));
}

// Creates `path` as a second name for the file `target`, in the order of
// `ln`.
//
// Both names lead to the same data, which stays until every name is
// removed. Both must be on the same file system, and `target` cannot be a
// directory.
//
// # Errors
//
// The errno: 17 (EEXIST) when something is at `path`, 2 (ENOENT) when
// `target` is missing, 18 (EXDEV) across file systems.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::write_file("first.txt", "shared").unwrap();
// fs::hard_link("first.txt", "second.txt").unwrap();
// fs::remove_file("first.txt").unwrap();
// println("{}", fs::read_file("second.txt").unwrap()); // shared
// ```
pub fn hard_link(target: str, path: str) ! {
    on_paths(SYS_LINK, target, path)!;
}

// Returns the absolute path of `path`, with every symlink, "." and ".."
// resolved.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::create_dir("deep").unwrap();
// var path = fs::real_path("deep/../deep").unwrap();
// println("{} {}", path.starts_with("/"), path.ends_with("/deep")); // true true
// ```
pub fn real_path(path: str) String! {
    var opened = File { fd: open_path(path, O_PATH, 0)!, buffer: Vec.new(), start: 0 };
    var fd = opened.fd;
    var link: Array<u8, 32> = [0; 32];
    var prefix = "/proc/self/fd/";
    __zeru_copy_bytes(&link[0], prefix as *u8, prefix.len());
    var digits: Array<u8, 20> = [0; 20];
    var count: usize = 0;
    var rest = fd;
    while true {
        digits[count] = '0' + (rest % 10) as u8;
        count += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    for i in 0..count {
        link[prefix.len() + i] = digits[count - 1 - i];
    }
    var text: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var len = sys_result(
        syscall3(SYS_READLINK, (&link[0]) as i64, (&text[0]) as i64, PATH_MAX as i64),
    )!;
    return Ok(String.from(text[..len as usize]));
}

// Returns the working directory, which relative paths start from.
//
// # Errors
//
// The errno: 2 (ENOENT) when the directory was removed.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// println("{}", fs::current_dir().unwrap().starts_with("/")); // true
// ```
pub fn current_dir() String! {
    var text: Array<u8, PATH_MAX> = [0; PATH_MAX];
    var len = sys_result(syscall2(SYS_GETCWD, (&text[0]) as i64, PATH_MAX as i64))!;
    return Ok(String.from(text[..len as usize - 1]));
}

// Makes `path` the working directory, which relative paths start from.
//
// # Errors
//
// The errno: 2 (ENOENT) when nothing is there, 20 (ENOTDIR) when it is not
// a directory.
//
// # Examples
//
// ```zeru
// import std.fs;
//
// fs::create_dir("work").unwrap();
// fs::set_current_dir("work").unwrap();
// println("{}", fs::current_dir().unwrap().ends_with("/work")); // true
// ```
pub fn set_current_dir(path: str) ! {
    on_path(SYS_CHDIR, path, 0)!;
}
