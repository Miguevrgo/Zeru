// Zeru Standard Library - File System (Linux x86_64)

pub const O_RDONLY: i64 = 0;
pub const O_WRONLY: i64 = 1;
pub const O_RDWR: i64 = 2;
pub const O_CREAT: i64 = 64;
pub const O_TRUNC: i64 = 512;
pub const O_APPEND: i64 = 1024;
pub const O_EXCL: i64 = 128;

pub const SEEK_SET: i64 = 0;
pub const SEEK_CUR: i64 = 1;
pub const SEEK_END: i64 = 2;

pub const PERM_644: i64 = 420;
pub const PERM_755: i64 = 493;
pub const PERM_600: i64 = 384;
pub const PERM_700: i64 = 448;

pub fn open(path: *u8, flags: i64, mode: i64) i64! {
    return sys_result(syscall3(2, path as i64, flags, mode));
}

pub fn close(fd: i64) i64! {
    return sys_result(syscall1(3, fd));
}

pub fn read(fd: i64, buf: *u8, count: usize) i64! {
    return sys_result(syscall3(0, fd, buf as i64, count as i64));
}

pub fn write(fd: i64, buf: *u8, count: usize) i64! {
    return sys_result(syscall3(1, fd, buf as i64, count as i64));
}

pub fn lseek(fd: i64, offset: i64, whence: i64) i64! {
    return sys_result(syscall3(8, fd, offset, whence));
}

pub fn mkdir(path: *u8, mode: i64) i64! {
    return sys_result(syscall2(83, path as i64, mode));
}

pub fn rmdir(path: *u8) i64! {
    return sys_result(syscall1(84, path as i64));
}

pub fn unlink(path: *u8) i64! {
    return sys_result(syscall1(87, path as i64));
}

pub fn rename(old_path: *u8, new_path: *u8) i64! {
    return sys_result(syscall2(82, old_path as i64, new_path as i64));
}

pub fn file_size(path: *u8) i64! {
    var buf: Array<u8, 144> = [0; 144];
    var ptr: *u8 = &buf[0];
    try sys_result(syscall2(4, path as i64, ptr as i64));
    var size_ptr: *i64 = (&buf[48]) as *i64;
    return Ok(*size_ptr);
}

pub fn exists(path: *u8) bool {
    return syscall2(21, path as i64, 0) == 0;
}

pub fn truncate(path: *u8, length: i64) i64! {
    return sys_result(syscall2(76, path as i64, length));
}

pub fn fsync(fd: i64) i64! {
    return sys_result(syscall1(74, fd));
}

pub fn read_file(path: *u8, buf: *u8, buf_size: usize) i64! {
    var fd = try open(path, O_RDONLY, 0);

    var total: i64 = 0;
    var remaining: usize = buf_size;
    while remaining > 0 {
        var n: i64 = syscall3(0, fd, (buf + total as usize) as i64, remaining as i64);
        if n < 0 { syscall1(3, fd); return sys_result(n); }
        if n == 0 { break; }
        total = total + n;
        remaining = remaining - n as usize;
    }
    syscall1(3, fd);
    return Ok(total);
}

pub fn write_file(path: *u8, data: *u8, len: usize) i64! {
    var fd = try open(path, O_WRONLY | O_CREAT | O_TRUNC, PERM_644);

    var total: i64 = 0;
    var remaining: usize = len;
    while remaining > 0 {
        var n: i64 = syscall3(1, fd, (data + total as usize) as i64, remaining as i64);
        if n < 0 { syscall1(3, fd); return sys_result(n); }
        total = total + n;
        remaining = remaining - n as usize;
    }
    syscall1(3, fd);
    return Ok(total);
}
