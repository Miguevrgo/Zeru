// Zeru Standard Library - File System (Linux x86_64)

const SYS_OPEN: i64 = 2;
const SYS_STAT: i64 = 4;
const SYS_LSEEK: i64 = 8;
const SYS_ACCESS: i64 = 21;
const SYS_FSYNC: i64 = 74;
const SYS_TRUNCATE: i64 = 76;
const SYS_RENAME: i64 = 82;
const SYS_MKDIR: i64 = 83;
const SYS_RMDIR: i64 = 84;
const SYS_UNLINK: i64 = 87;

// `open` flag: reading only.
pub const O_RDONLY: i64 = 0;
// `open` flag: writing only.
pub const O_WRONLY: i64 = 1;
// `open` flag: reading and writing.
pub const O_RDWR: i64 = 2;
// `open` flag: create the file if it is missing, with `open`'s `mode`.
pub const O_CREAT: i64 = 64;
// `open` flag: empty the file when writing to it.
pub const O_TRUNC: i64 = 512;
// `open` flag: every write goes to the end of the file.
pub const O_APPEND: i64 = 1024;
// `open` flag: with `O_CREAT`, fail with 17 (EEXIST) if the file exists.
pub const O_EXCL: i64 = 128;

// `lseek` from the start of the file.
pub const SEEK_SET: i64 = 0;
// `lseek` from the current offset.
pub const SEEK_CUR: i64 = 1;
// `lseek` from the end of the file.
pub const SEEK_END: i64 = 2;

// rw-r--r--: the owner reads and writes, everyone else reads.
pub const PERM_644: i64 = 420;
// rwxr-xr-x: the owner does everything, everyone else reads and runs.
pub const PERM_755: i64 = 493;
// rw-------: only the owner reads and writes.
pub const PERM_600: i64 = 384;
// rwx------: only the owner, for everything.
pub const PERM_700: i64 = 448;

// Longest path Linux takes, its closing NUL included.
const PATH_MAX: usize = 4096;

// `path` and a closing NUL in `buf`, as a syscall takes it; `buf` as an
// address, or the error code: 36 (ENAMETOOLONG) when it does not fit, 22
// (EINVAL) when it holds a NUL, which would end it early.
fn c_path(path: str, buf: *u8) i64! {
    if path.len() >= PATH_MAX {
        return Err(36);
    }
    for byte in path {
        if byte == 0 {
            return Err(22);
        }
    }
    __zeru_copy_bytes(buf, path as *u8, path.len());
    *(buf + path.len()) = 0;
    return Ok(buf as i64);
}

// Open `path` with `O_*` flags and `mode` as a created file's permissions;
// the fd, or the errno as the error code.
pub fn open(path: str, flags: i64, mode: i64) i64! {
    var buf: Array<u8, 4096> = [0; 4096];
    var p = c_path(path, &buf[0])!;
    return sys_result(syscall3(SYS_OPEN, p, flags, mode));
}

// Close `fd`; 0, or the errno as the error code.
pub fn close(fd: i64) i64! {
    return sys_result(syscall1(SYS_CLOSE, fd));
}

// Read up to `count` bytes into `buf`; how many, 0 at the end of the file,
// or the errno as the error code.
pub fn read(fd: i64, buf: *u8, count: usize) usize! {
    var n = sys_result(syscall3(SYS_READ, fd, buf as i64, count as i64))!;
    return Ok(n as usize);
}

// Write up to `count` bytes of `buf`; how many, which may be fewer, or the
// errno as the error code.
pub fn write(fd: i64, buf: *u8, count: usize) usize! {
    var n = sys_result(syscall3(SYS_WRITE, fd, buf as i64, count as i64))!;
    return Ok(n as usize);
}

// Move `fd`'s offset to `offset` bytes from `whence`, a `SEEK_*`; the new
// offset from the start, or the errno as the error code.
pub fn lseek(fd: i64, offset: i64, whence: i64) i64! {
    return sys_result(syscall3(SYS_LSEEK, fd, offset, whence));
}

// Create a directory at `path` with permissions `mode`; 0, or the errno as
// the error code.
pub fn mkdir(path: str, mode: i64) i64! {
    var buf: Array<u8, 4096> = [0; 4096];
    var p = c_path(path, &buf[0])!;
    return sys_result(syscall2(SYS_MKDIR, p, mode));
}

// Remove the empty directory at `path`; 0, or the errno as the error code.
pub fn rmdir(path: str) i64! {
    var buf: Array<u8, 4096> = [0; 4096];
    var p = c_path(path, &buf[0])!;
    return sys_result(syscall1(SYS_RMDIR, p));
}

// Delete the file at `path`; not for directories. 0, or the errno as the
// error code.
pub fn unlink(path: str) i64! {
    var buf: Array<u8, 4096> = [0; 4096];
    var p = c_path(path, &buf[0])!;
    return sys_result(syscall1(SYS_UNLINK, p));
}

// Move `old_path` to `new_path`, replacing a file already there; 0, or the
// errno as the error code.
pub fn rename(old_path: str, new_path: str) i64! {
    var old_buf: Array<u8, 4096> = [0; 4096];
    var new_buf: Array<u8, 4096> = [0; 4096];
    var old = c_path(old_path, &old_buf[0])!;
    var new = c_path(new_path, &new_buf[0])!;
    return sys_result(syscall2(SYS_RENAME, old, new));
}

// The size in bytes of the file at `path`, following symlinks; the errno as
// the error code, 2 (ENOENT) when missing.
pub fn file_size(path: str) usize! {
    var buf: Array<u8, 4096> = [0; 4096];
    var p = c_path(path, &buf[0])!;
    var stat: Array<i64, 18> = [0; 18];
    sys_result(syscall2(SYS_STAT, p, (&stat[0]) as i64))!;
    return Ok(stat[6] as usize);
}

// Whether something exists at `path`; false on any error, such as no
// permission to look.
pub fn exists(path: str) bool {
    var buf: Array<u8, 4096> = [0; 4096];
    var p = c_path(path, &buf[0]);
    return p.is_ok() && syscall2(SYS_ACCESS, p.unwrap(), 0) == 0;
}

// Cut or zero-extend the file at `path` to `length` bytes; 0, or the errno
// as the error code.
pub fn truncate(path: str, length: i64) i64! {
    var buf: Array<u8, 4096> = [0; 4096];
    var p = c_path(path, &buf[0])!;
    return sys_result(syscall2(SYS_TRUNCATE, p, length));
}

// Wait until what was written to `fd` is on disk; 0, or the errno as the
// error code.
pub fn fsync(fd: i64) i64! {
    return sys_result(syscall1(SYS_FSYNC, fd));
}

// The contents of the file at `path`, as many bytes as its size, in memory
// that is never freed; the errno as the error code.
pub fn read_file(path: str) str! {
    var size = file_size(path)!;
    if size == 0 {
        return Ok("");
    }
    var fd = open(path, O_RDONLY, 0)!;
    var data = __zeru_map(size);
    var total: usize = 0;
    while total < size {
        var n = read(fd, data + total, size - total);
        if n.is_err() { close(fd); return Err(n.unwrap_err()); }
        if n.unwrap() == 0 { break; }
        total += n.unwrap();
    }
    close(fd);
    var parts = (data, total);
    return Ok(*((&parts) as *str));
}

// Create or replace the file at `path` with `data`, as `PERM_644`; how many
// bytes, or the errno as the error code.
pub fn write_file(path: str, data: str) usize! {
    var fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, PERM_644)!;
    var total: usize = 0;
    while total < data.len() {
        var n = write(fd, (data as *u8) + total, data.len() - total);
        if n.is_err() { close(fd); return n; }
        total += n.unwrap();
    }
    close(fd);
    return Ok(total);
}
