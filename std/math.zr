// The ratio of a circle's circumference to its diameter, 3.14159...
pub const PI: f64 = 3.14159265358979323846;
// Euler's number, the base of the natural logarithm, 2.71828...
pub const E: f64 = 2.71828182845904523536;
// A full turn in radians, 2 * `PI`.
pub const TAU: f64 = 6.28318530717958647692;

// The smaller of `a` and `b`; `b` when they are equal.
pub fn min<T>(a: T, b: T) T {
    if a < b {
        return a;
    }
    return b;
}

// The larger of `a` and `b`; `b` when they are equal.
pub fn max<T>(a: T, b: T) T {
    if a > b {
        return a;
    }
    return b;
}

// `value` held between `low` and `high`, both included; expects `low <= high`.
pub fn clamp<T>(value: T, low: T, high: T) T {
    if value < low {
        return low;
    }
    if value > high {
        return high;
    }
    return value;
}

// `num` without its sign; -0.0 gives 0.0. Signed types only, and it panics
// on the most negative integer, which has no positive.
pub fn abs<T>(num: T) T {
    if num < 0 {
        return -num;
    }
    if num == 0 {
        return 0;
    }
    return num;
}

// `base` to the power `exp`, by squaring; 1 when `exp` is 0. Panics on
// overflow.
pub fn pow<T>(base: T, exp: u32) T {
    var result: T = 1;
    var b: T = base;
    var e: u32 = exp;
    while e > 0 {
        if (e % 2) == 1 {
            result = result * b;
        }
        if e > 1 {
            b = b * b;
        }
        e = e / 2;
    }
    return result;
}

// Whether `n` is 1, 2, 4, 8 and so on; false for 0.
pub fn is_power_of_two(n: u64) bool {
    return n != 0 && (n & (n - 1)) == 0;
}

// Integer division whose remainder, `mod_euclid`, is never negative:
// -7 by 2 gives -4. Panics when `b` is 0. Integers only.
pub fn div_euclid<T>(a: T, b: T) T {
    var q: T = a / b;
    var r: T = a % b;
    if r < 0 {
        if b > 0 {
            return q - 1;
        } else {
            return q + 1;
        }
    }
    return q;
}

// The remainder of `a` by `b`, never negative: -7 by 2 gives 1. Panics when
// an integer `b` is 0.
pub fn mod_euclid<T>(a: T, b: T) T {
    var r: T = a % b;
    if r < 0 {
        if b > 0 {
            return r + b;
        } else {
            return r - b;
        }
    }
    return r;
}
