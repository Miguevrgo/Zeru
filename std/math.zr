// The ratio of a circle's circumference to its diameter, 3.14159...
pub const PI: f64 = 3.14159265358979323846;
// Euler's number, the base of the natural logarithm, 2.71828...
pub const E: f64 = 2.71828182845904523536;
// A full turn in radians, 2 * `PI`.
pub const TAU: f64 = 6.28318530717958647692;

// Returns the smaller of `a` and `b`.
//
// Works for any type `<` compares, integers and floats alike. When both are
// equal it returns `b`.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", math::min(3, -2)); // -2
// println("{}", math::min(1.5, 2.5)); // 1.5
// ```
pub fn min<T: Ord>(a: T, b: T) T {
    if a < b {
        return a;
    }
    return b;
}

// Returns the larger of `a` and `b`.
//
// Works for any type `>` compares, integers and floats alike. When both are
// equal it returns `b`.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", math::max(3, -2)); // 3
// println("{}", math::max(1.5, 2.5)); // 2.5
// ```
pub fn max<T: Ord>(a: T, b: T) T {
    if a > b {
        return a;
    }
    return b;
}

// Returns `value` held between `low` and `high`, both included.
//
// Below `low` gives `low`, above `high` gives `high`, anything between comes
// back unchanged. Expects `low <= high`.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", math::clamp(15, 0, 10)); // 10
// println("{}", math::clamp(-3, 0, 10)); // 0
// println("{}", math::clamp(7, 0, 10)); // 7
// ```
pub fn clamp<T: Ord>(value: T, low: T, high: T) T {
    if value < low {
        return low;
    }
    if value > high {
        return high;
    }
    return value;
}

// Returns `num` without its sign.
//
// For signed integers and floats; `-0.0` gives `0.0`.
//
// # Panics
//
// On the most negative integer of its type, as `-128` for an `i8`, which
// has no positive.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", math::abs(-7)); // 7
// println("{}", math::abs(2.5)); // 2.5
// println("{}", math::abs(-0.0)); // 0.0
// ```
pub fn abs<T: Num>(num: T) T {
    if num < 0 {
        return -num;
    }
    if num == 0 {
        return 0;
    }
    return num;
}

// Returns `base` raised to the power `exp`.
//
// Takes O(log exp) multiplications. Any number to the power 0 is 1.
//
// # Panics
//
// When an integer result does not fit its type.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", math::pow(3, 4)); // 81
// println("{}", math::pow(2.0, 10)); // 1024.0
// println("{}", math::pow(5, 0)); // 1
// ```
pub fn pow<T: Num>(base: T, exp: u32) T {
    var result: T = 1;
    var b: T = base;
    var e: u32 = exp;
    while e > 0 {
        if (e % 2) == 1 {
            result = result * b;
        }
        if e > 1 {
            b = b * b;
        }
        e = e / 2;
    }
    return result;
}

// Returns whether `n` is a power of two: 1, 2, 4, 8 and so on.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", math::is_power_of_two(64)); // true
// println("{}", math::is_power_of_two(48)); // false
// println("{}", math::is_power_of_two(0)); // false
// ```
pub fn is_power_of_two(n: u64) bool {
    return n != 0 && (n & (n - 1)) == 0;
}

// Divides `a` by `b`, rounding so the remainder is never negative.
//
// `a / b` rounds toward zero, so `-7 / 2` is `-3` with remainder `-1`.
// `div_euclid` rounds down instead when `b` is positive, giving `-4` with
// remainder `1`, the `mod_euclid` of the same numbers. Integers only.
//
// # Panics
//
// When `b` is 0.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", math::div_euclid(7, 2)); // 3
// println("{}", math::div_euclid(-7, 2)); // -4
// println("{}", math::div_euclid(-7, -2)); // 4
// ```
pub fn div_euclid<T: Num>(a: T, b: T) T {
    var q: T = a / b;
    var r: T = a % b;
    if r < 0 {
        if b > 0 {
            return q - 1;
        } else {
            return q + 1;
        }
    }
    return q;
}

// Returns the remainder of `a` by `b`, never negative.
//
// Unlike `a % b`, which takes the sign of `a`, the result is always between
// 0 and `b` without its sign, as wrapping around needs: a position `-1` in a
// ring of 5 is `4`.
//
// # Panics
//
// When `b` is an integer 0.
//
// # Examples
//
// ```zeru
// import std.math;
//
// println("{}", -7 % 5); // -2
// println("{}", math::mod_euclid(-7, 5)); // 3
// println("{}", math::mod_euclid(-1, 5)); // 4
// ```
pub fn mod_euclid<T: Num>(a: T, b: T) T {
    var r: T = a % b;
    if r < 0 {
        if b > 0 {
            return r + b;
        } else {
            return r - b;
        }
    }
    return r;
}
