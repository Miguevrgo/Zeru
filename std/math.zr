const PI: f64 = 3.14159265358979323846;
const E: f64 = 2.71828182845904523536;
const TAU: f64 = 6.28318530717958647692;

fn min<T>(a: T, b: T) T {
    if a < b {
        return a;
    }
    return b;
}

fn max<T>(a: T, b: T) T {
    if a > b {
        return a;
    }
    return b;
}

fn clamp<T>(value: T, low: T, high: T) T {
    if value < low {
        return low;
    }
    if value > high {
        return high;
    }
    return value;
}

fn abs<T>(num: T) T {
    if num < 0 {
        return -num;
    }
    return num;
}

fn pow<T>(base: T, exp: u32) T {
    var result: T = 1;
    var b: T = base;
    var e: u32 = exp;
    while e > 0 {
        if (e % 2) == 1 {
            result = result * b;
        }
        b = b * b;
        e = e / 2;
    }
    return result;
}

fn is_power_of_two(n: u64) bool {
    return n != 0 && (n & (n - 1)) == 0;
}

fn div_euclid<T>(a: T, b: T) T {
    var q: T = a / b;
    var r: T = a % b;
    if r < 0 {
        if b > 0 {
            return q - 1;
        } else {
            return q + 1;
        }
    }
    return q;
}

fn mod_euclid<T>(a: T, b: T) T {
    var r: T = a % b;
    if r < 0 {
        if b > 0 {
            return r + b;
        } else {
            return r - b;
        }
    }
    return r;
}
