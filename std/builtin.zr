// Zeru Standard Library - prelude, part of every program
// Linux x86_64 syscall wrappers, the output streams and the allocator.
//
// x86_64 Linux syscall convention:
// - rax: syscall number
// - rdi, rsi, rdx, r10, r8, r9: arguments 1-6
// - rax: return value
// - rcx, r11: clobbered by syscall
//
// print(), println(), eprint(), eprintln() are compiler built-ins
// that use implicit OutStream buffers (4KB each for stdout/stderr).
// println/eprintln automatically flush after writing.

const SYS_READ: i64 = 0;
const SYS_WRITE: i64 = 1;
const SYS_CLOSE: i64 = 3;
const SYS_MMAP: i64 = 9;
const SYS_MREMAP: i64 = 25;
const SYS_MUNMAP: i64 = 11;
const SYS_EXIT: i64 = 60;

const PROT_READ: i64 = 1;
const PROT_WRITE: i64 = 2;
const MAP_PRIVATE: i64 = 2;
const MAP_ANONYMOUS: i64 = 32;

const MREMAP_MAYMOVE: i64 = 1;

fn syscall1(nr: i64, arg1: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        : "={rax}" (result)
        : "{rax}" (nr), "{rdi}" (arg1)
        : "rcx", "r11", "memory"
    );
    return result;
}

// A raw syscall return as a result: negative values are -errno.
fn sys_result(r: i64) i64! {
    if r < 0 {
        return Err((-r) as i32);
    }
    return r;
}

// No file or directory by that name.
pub const ENOENT: i32 = 2;
// Not allowed: the permissions forbid it, or a port under 1024 without root.
pub const EACCES: i32 = 13;
// It exists already.
pub const EEXIST: i32 = 17;
// A part of the path is not a directory.
pub const ENOTDIR: i32 = 20;
// A directory, where a file was wanted.
pub const EISDIR: i32 = 21;
// A wrong argument, as an address that does not parse.
pub const EINVAL: i32 = 22;
// Writing to a pipe or connection the other end has closed.
pub const EPIPE: i32 = 32;
// The directory is not empty.
pub const ENOTEMPTY: i32 = 39;
// The address or port is taken by another socket.
pub const EADDRINUSE: i32 = 98;
// No network reaches the address.
pub const ENETUNREACH: i32 = 101;
// The other end dropped the connection.
pub const ECONNRESET: i32 = 104;
// The time given ran out, or the other end never answered.
pub const ETIMEDOUT: i32 = 110;
// Nothing listens at that address.
pub const ECONNREFUSED: i32 = 111;
// No route reaches that machine.
pub const EHOSTUNREACH: i32 = 113;

// End the process, after writing out what print left buffered. The OS
// keeps only the low 8 bits of `code`.
pub fn exit(code: i32) {
    __zeru_flush();
    syscall1(SYS_EXIT, code as i64);
}

fn syscall2(nr: i64, arg1: i64, arg2: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        : "={rax}" (result)
        : "{rax}" (nr), "{rdi}" (arg1), "{rsi}" (arg2)
        : "rcx", "r11", "memory"
    );
    return result;
}

fn syscall3(nr: i64, arg1: i64, arg2: i64, arg3: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        :   "={rax}" (result)
        :   "{rax}" (nr),
            "{rdi}" (arg1),
            "{rsi}" (arg2),
            "{rdx}" (arg3)
        : "rcx", "r11", "memory"
    );
    return result;
}

fn syscall5(nr: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64, arg5: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        :   "={rax}" (result)
        :   "{rax}" (nr),
            "{rdi}" (arg1),
            "{rsi}" (arg2),
            "{rdx}" (arg3),
            "{r10}" (arg4),
            "{r8}" (arg5)
        : "rcx", "r11", "memory"
    );
    return result;
}

fn syscall6(nr: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64, arg5: i64, arg6: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        :   "={rax}" (result)
        :   "{rax}" (nr),
            "{rdi}" (arg1),
            "{rsi}" (arg2),
            "{rdx}" (arg3),
            "{r10}" (arg4),
            "{r8}" (arg5),
            "{r9}" (arg6)
        : "rcx", "r11", "memory"
    );
    return result;
}

struct OutStream {
    fd: i32,
    buffer: Array<u8, 4096>,
    index: usize,

    fn flush(var self) i64 {
        var buf_ptr: *u8 = &self.buffer[0];
        var done: usize = 0;
        while done < self.index {
            var written = syscall3(
                SYS_WRITE,
                self.fd as i64,
                (buf_ptr + done) as i64,
                (self.index - done) as i64,
            );
            if written < 0 {
                self.index = 0;
                return -1;
            }
            done += written as usize;
        }
        self.index = 0;
        return done as i64;
    }

    fn write_bytes(var self, bytes: *u8, count: usize) i64 {
        var src_index: usize = 0;
        var remaining: usize = count;

        while remaining > 0 {
            var space_left: usize = 4096 - self.index;
            var to_copy: usize = remaining;

            if space_left < remaining {
                to_copy = space_left;
            }

            __zeru_copy_bytes(&self.buffer[self.index], bytes + src_index, to_copy);

            self.index += to_copy;
            src_index += to_copy;
            remaining -= to_copy;

            if self.index == 4096 {
                var flush_result: i64 = self.flush();
                if flush_result < 0 {
                    return flush_result;
                }
            }
        }

        return count as i64;
    }

    fn write_text(var self, text: str) {
        self.write_bytes(text as *u8, text.len());
    }

    fn write_uint(var self, value: u64) {
        var digits: Array<u8, 20> = [0; 20];
        var at: usize = 20;
        var rest = value;
        while true {
            at -= 1;
            digits[at] = '0' + (rest % 10) as u8;
            rest /= 10;
            if rest == 0 {
                break;
            }
        }
        self.write_bytes(&digits[at], 20 - at);
    }

    fn write_int(var self, value: i64) {
        if value < 0 {
            self.write_text("-");
            self.write_uint(0 -% (value as u64));
            return;
        }
        self.write_uint(value as u64);
    }

    // The shortest digits that read back as `value`, in plain notation with
    // at least one decimal: 0.1, 3.0, 0.0000001. `single` prints an f32 at
    // its own precision.
    fn write_float(var self, value: f64, single: bool) {
        if value != value {
            self.write_text("NaN");
            return;
        }
        var rest = value;
        if rest < 0 || 1 / rest < 0 {
            self.write_text("-");
            rest = -rest;
        }
        if rest > 1.7976931348623157e308 {
            self.write_text("inf");
            return;
        }
        if rest == 0 {
            self.write_text("0.0");
            return;
        }
        var mantissa: u64 = 0;
        var exponent: i64 = 0;
        var hidden: u64 = 0;
        var lowest: i64 = 0;
        if single {
            var narrow: f32 = rest as f32;
            var bits = *((&narrow) as *u32) as u64;
            hidden = 1 << 23;
            lowest = -149;
            mantissa = bits & (hidden - 1);
            exponent = ((bits >> 23) & 255) as i64;
        } else {
            var wide = rest;
            var bits = *((&wide) as *u64);
            hidden = 1 << 52;
            lowest = -1074;
            mantissa = bits & (hidden - 1);
            exponent = ((bits >> 52) & 2047) as i64;
        }
        if exponent == 0 {
            exponent = lowest;
        } else {
            mantissa = mantissa | hidden;
            exponent = exponent + lowest - 1;
        }

        var digits: Array<u8, 24> = [0; 24];
        var count: usize = 0;
        var point = __zeru_shortest(rest, mantissa, exponent, hidden, lowest, &digits[0], &count);
        if point <= 0 {
            self.write_text("0.");
            for at in 0..(0 - point) {
                self.write_text("0");
            }
            self.write_bytes(&digits[0], count);
        } else if point as usize >= count {
            self.write_bytes(&digits[0], count);
            for at in 0..(point - count as i64) {
                self.write_text("0");
            }
            self.write_text(".0");
        } else {
            self.write_bytes(&digits[0], point as usize);
            self.write_text(".");
            self.write_bytes(&digits[point as usize], count - point as usize);
        }
    }

    // `value` in base `radix`, from 2 to 16, its digits past 9 as letters,
    // capitals when `upper`.
    fn write_radix(var self, value: u64, radix: u64, upper: bool) {
        var digits: Array<u8, 64> = [0; 64];
        var at: usize = 64;
        var rest = value;
        var letters: u8 = 'a';
        if upper {
            letters = 'A';
        }
        while true {
            at -= 1;
            var digit = (rest % radix) as u8;
            if digit < 10 {
                digits[at] = '0' + digit;
            } else {
                digits[at] = letters + digit - 10;
            }
            rest /= radix;
            if rest == 0 {
                break;
            }
        }
        self.write_bytes(&digits[at], 64 - at);
    }

    // `value` with `precision` decimals: of the numbers with that many, the
    // nearest to its exact value, and on a tie the one ending in an even
    // digit.
    fn write_fixed(var self, value: f64, precision: usize) {
        if value != value {
            self.write_text("NaN");
            return;
        }
        var rest = value;
        if rest < 0 || 1 / rest < 0 {
            self.write_text("-");
            rest = -rest;
        }
        if rest > 1.7976931348623157e308 {
            self.write_text("inf");
            return;
        }
        var hidden: u64 = 1 << 52;
        var bits = *((&rest) as *u64);
        var mantissa = bits & (hidden - 1);
        var exponent = ((bits >> 52) & 2047) as i64;
        if exponent == 0 {
            exponent = -1074;
        } else {
            mantissa = mantissa | hidden;
            exponent -= 1075;
        }
        var scaled = __zeru_big(mantissa);
        scaled.mul_pow10(precision as i64);
        if exponent >= 0 {
            scaled.mul_pow2(exponent);
        } else {
            scaled.div_pow2_round(0 - exponent);
        }
        var digits: Array<u8, 512> = [0; 512];
        var count: usize = 0;
        while scaled.len > 0 || count <= precision {
            count += 1;
            digits[512 - count] = '0' + scaled.div_small(10) as u8;
        }
        self.write_bytes(&digits[512 - count], count - precision);
        if precision > 0 {
            self.write_text(".");
            self.write_bytes(&digits[512 - precision], precision);
        }
    }
}

// A natural number in 32-bit limbs, least significant first, wide enough for
// the numbers printing a float works with.
struct ZeruBig {
    limbs: Array<u32, 48>,
    len: usize,

    fn mul_small(var self, factor: u32) {
        var carry: u64 = 0;
        var at: usize = 0;
        while at < self.len {
            var product = (self.limbs[at] as u64) * (factor as u64) + carry;
            self.limbs[at] = product as u32;
            carry = product >> 32;
            at += 1;
        }
        if carry > 0 {
            self.limbs[self.len] = carry as u32;
            self.len += 1;
        }
    }

    fn mul_pow2(var self, power: i64) {
        var left = power;
        while left >= 31 {
            self.mul_small(2147483648);
            left -= 31;
        }
        self.mul_small((1 << left) as u32);
    }

    fn mul_pow10(var self, power: i64) {
        var left = power;
        while left >= 9 {
            self.mul_small(1000000000);
            left -= 9;
        }
        while left > 0 {
            self.mul_small(10);
            left -= 1;
        }
    }

    fn add(var self, other: &ZeruBig) {
        var carry: u64 = 0;
        var at: usize = 0;
        while at < self.len || at < other.len || carry > 0 {
            var sum = carry;
            if at < self.len {
                sum += self.limbs[at] as u64;
            }
            if at < other.len {
                sum += other.limbs[at] as u64;
            }
            self.limbs[at] = sum as u32;
            carry = sum >> 32;
            at += 1;
        }
        if at > self.len {
            self.len = at;
        }
    }

    // Divide by `divisor`, giving back the remainder.
    fn div_small(var self, divisor: u32) u32 {
        var rest: u64 = 0;
        var at = self.len;
        while at > 0 {
            at -= 1;
            var current = (rest << 32) | self.limbs[at] as u64;
            self.limbs[at] = (current / divisor as u64) as u32;
            rest = current % divisor as u64;
        }
        while self.len > 0 && self.limbs[self.len - 1] == 0 {
            self.len -= 1;
        }
        return rest as u32;
    }

    // Divide by 2^power, rounding to the nearest and a tie to even.
    fn div_pow2_round(var self, power: i64) {
        var left = power;
        var below = false;
        while left > 1 {
            var step = left - 1;
            if step > 31 {
                step = 31;
            }
            var dropped = self.div_small((1 << step) as u32);
            below = below || dropped != 0;
            left -= step;
        }
        var half = self.div_small(2) == 1;
        if half && (below || self.len > 0 && self.limbs[0] % 2 == 1) {
            var one = __zeru_big(1);
            self.add(&one);
        }
    }

    // Subtract `other`, which is no greater.
    fn sub(var self, other: &ZeruBig) {
        var borrow: u64 = 0;
        var at: usize = 0;
        while at < self.len {
            var take = borrow;
            if at < other.len {
                take += other.limbs[at] as u64;
            }
            var have = self.limbs[at] as u64;
            borrow = 0;
            if have < take {
                have += 4294967296;
                borrow = 1;
            }
            self.limbs[at] = (have - take) as u32;
            at += 1;
        }
        while self.len > 0 && self.limbs[self.len - 1] == 0 {
            self.len -= 1;
        }
    }

    // -1, 0 or 1 as self is below, equal to or above `other`.
    fn cmp(self, other: &ZeruBig) i32 {
        if self.len != other.len {
            if self.len < other.len {
                return -1;
            }
            return 1;
        }
        var at = self.len;
        while at > 0 {
            at -= 1;
            if self.limbs[at] != other.limbs[at] {
                if self.limbs[at] < other.limbs[at] {
                    return -1;
                }
                return 1;
            }
        }
        return 0;
    }
}

fn __zeru_big(value: u64) ZeruBig {
    var big = ZeruBig { limbs: [0; 48], len: 0 };
    var rest = value;
    while rest > 0 {
        big.limbs[big.len] = rest as u32;
        big.len += 1;
        rest = rest >> 32;
    }
    return big;
}

// Whether `low` is at or under `high`, or strictly under unless `inclusive`.
fn __zeru_under(low: &ZeruBig, high: &ZeruBig, inclusive: bool) bool {
    var order = low.cmp(high);
    return order < 0 || inclusive && order == 0;
}

// The fewest digits that read back as mantissa * 2^exponent, the float
// `value`, by Burger and Dybvig's free-format algorithm, the closest of
// them and on a tie the even one, written to
// `digits` with their number in `count`. Returns where the point goes:
// the value is 0.digits * 10^point.
fn __zeru_shortest(
    value: f64,
    mantissa: u64,
    exponent: i64,
    hidden: u64,
    lowest: i64,
    digits: *u8,
    count: *usize,
) i64 {
    var even = mantissa % 2 == 0;
    var uneven_gaps = mantissa == hidden && exponent > lowest;
    var r = __zeru_big(mantissa);
    var s = __zeru_big(1);
    var plus = __zeru_big(1);
    var minus = __zeru_big(1);
    if exponent >= 0 {
        plus.mul_pow2(exponent);
        minus.mul_pow2(exponent);
        r.mul_pow2(exponent + 1);
        s.mul_small(2);
    } else {
        r.mul_small(2);
        s.mul_pow2(1 - exponent);
    }
    if uneven_gaps {
        plus.mul_small(2);
        r.mul_small(2);
        s.mul_small(2);
    }

    var point: i64 = 0;
    var probe = value;
    while probe >= 1 {
        probe /= 10;
        point += 1;
    }
    while probe < 0.1 {
        probe *= 10;
        point -= 1;
    }
    if point >= 0 {
        s.mul_pow10(point);
    } else {
        r.mul_pow10(0 - point);
        plus.mul_pow10(0 - point);
        minus.mul_pow10(0 - point);
    }
    while true {
        var high = r;
        high.add(&plus);
        if __zeru_under(&high, &s, !even) {
            break;
        }
        s.mul_small(10);
        point += 1;
    }
    while true {
        var high = r;
        high.add(&plus);
        high.mul_small(10);
        if !__zeru_under(&high, &s, !even) {
            break;
        }
        r.mul_small(10);
        plus.mul_small(10);
        minus.mul_small(10);
        point -= 1;
    }

    var used: usize = 0;
    while true {
        r.mul_small(10);
        plus.mul_small(10);
        minus.mul_small(10);
        var digit: u8 = 0;
        while !__zeru_under(&r, &s, false) {
            r.sub(&s);
            digit += 1;
        }
        var high = r;
        high.add(&plus);
        var low_reached = __zeru_under(&r, &minus, even);
        var high_reached = !__zeru_under(&high, &s, !even);
        if low_reached && high_reached {
            var twice = r;
            twice.mul_small(2);
            var order = twice.cmp(&s);
            if order > 0 || order == 0 && digit % 2 == 1 {
                digit += 1;
            }
        } else if high_reached {
            digit += 1;
        }
        *(digits + used) = '0' + digit;
        used += 1;
        if low_reached || high_reached {
            break;
        }
    }
    *count = used;
    return point;
}

fn __zeru_out_of_memory() {
    eprintln("panic: out of memory");
    exit(134);
}

// What `{:spec}` writes for an integer: `value`, or its bits read unsigned
// when `unsigned`, in base `radix`, padded as `__zeru_pad` does.
fn __zeru_format_int(
    value: i64,
    unsigned: bool,
    radix: u64,
    upper: bool,
    fill: u8,
    align: u8,
    zero: bool,
    width: usize,
) String {
    var out = OutStream { fd: -1, buffer: [0; 4096], index: 0 };
    if unsigned || value >= 0 {
        out.write_radix(value as u64, radix, upper);
    } else {
        out.write_text("-");
        out.write_radix(0 -% (value as u64), radix, upper);
    }
    return __zeru_pad(out.buffer[..out.index], fill, align, zero, width);
}

// What `{:spec}` writes for a float: with `precision` decimals, or the
// fewest digits that read back as `value` when `precision` is below 0,
// padded as `__zeru_pad` does.
fn __zeru_format_float(
    value: f64,
    single: bool,
    precision: i64,
    fill: u8,
    align: u8,
    zero: bool,
    width: usize,
) String {
    var out = OutStream { fd: -1, buffer: [0; 4096], index: 0 };
    if precision < 0 {
        out.write_float(value, single);
    } else {
        out.write_fixed(value, precision as usize);
    }
    return __zeru_pad(out.buffer[..out.index], fill, align, zero, width);
}

// `text` in quotes, written as a literal would be: `"`, `\\` and line
// breaks, tabs, returns and zero bytes escaped.
fn __zeru_quoted(text: str) String {
    var out = String.from("\"");
    for byte in text {
        match byte {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\t' => out.push_str("\\t"),
            '\r' => out.push_str("\\r"),
            0 => out.push_str("\\0"),
            default => out.push(byte),
        }
    }
    out.push('"');
    return out;
}

// `text` padded to `width` characters with `fill`, before it when `align`
// is '>', after it when '<', on both sides when '^'; or with zeros after
// its sign when `zero`.
fn __zeru_pad(text: str, fill: u8, align: u8, zero: bool, width: usize) String {
    var count: usize = 0;
    for byte in text {
        if (byte & 192) != 128 {
            count += 1;
        }
    }
    var gap: usize = 0;
    if width > count {
        gap = width - count;
    }
    var padded = String.new();
    var pad = fill;
    var before = gap;
    var start: usize = 0;
    if zero {
        pad = '0';
        if text.len() > 0 && (text[0] == '-' || text[0] == '+') {
            padded.push(text[0]);
            start = 1;
        }
    } else if align == '<' {
        before = 0;
    } else if align == '^' {
        before = gap / 2;
    }
    for i in 0..before {
        padded.push(pad);
    }
    padded.push_str(text[start..]);
    for i in before..gap {
        padded.push(pad);
    }
    return padded;
}

// "true" or "false", for a bool `{:spec}` pads.
fn __zeru_bool_text(flag: bool) str {
    if flag {
        return "true";
    }
    return "false";
}

// Whether two strings hold the same bytes, for `==` and `!=` on str.
fn __zeru_str_eq(a: str, b: str) bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

// How `a` and `b` order, for `<` on str: -1, 0 or 1. The first byte that
// differs decides, and a text goes before those it starts.
fn __zeru_str_cmp(a: str, b: str) i32 {
    var shorter = a.len();
    if b.len() < shorter {
        shorter = b.len();
    }
    for i in 0..shorter {
        if a[i] != b[i] {
            if a[i] < b[i] {
                return -1;
            }
            return 1;
        }
    }
    if a.len() == b.len() {
        return 0;
    }
    if a.len() < b.len() {
        return -1;
    }
    return 1;
}

// The NUL-terminated text at `text`, without its NUL, as the kernel hands
// over the program's arguments and the names in a directory.
fn __zeru_c_text(text: *u8) str {
    var len: usize = 0;
    while *(text + len) != 0 {
        len += 1;
    }
    var parts = (text, len);
    return *((&parts) as *str);
}

// The test `zeru test` runs: the number its first argument holds.
fn __zeru_test_index() i64 {
    var stack: i64 = 0;
    asm ("movq __zeru_stack(%rip), $0" : "=r" (stack));
    return __zeru_str_parse_int(__zeru_c_text(*((stack as *i64) + 2) as *u8)).unwrap();
}

// `s.split(sep)`: the parts of `s` between each `sep`; an empty `sep` gives
// `s` whole.
fn __zeru_str_split(s: str, sep: str) Vec<str> {
    var parts: Vec<str> = Vec.new();
    var start: usize = 0;
    var i: usize = 0;
    while sep.len() > 0 && i + sep.len() <= s.len() {
        if s[i..i + sep.len()] == sep {
            parts.push(s[start..i]);
            i += sep.len();
            start = i;
        } else {
            i += 1;
        }
    }
    parts.push(s[start..]);
    return parts;
}

// `s.find(t)`: where `t` first starts in `s`, or None.
fn __zeru_str_find(s: str, t: str) usize? {
    if t.len() > s.len() {
        return None;
    }
    for at in 0..s.len() - t.len() + 1 {
        if s[at..at + t.len()] == t {
            return at;
        }
    }
    return None;
}

// `s.contains(t)`: whether `t` appears in `s`.
fn __zeru_str_contains(s: str, t: str) bool {
    return __zeru_str_find(s, t).is_some();
}

// `s.split()`: the parts of `s` between runs of spaces, tabs and line
// breaks, never an empty one.
fn __zeru_str_split_blank(s: str) Vec<str> {
    var parts: Vec<str> = Vec.new();
    var start: usize = 0;
    for i in 0..s.len() + 1 {
        if i == s.len() || __zeru_is_space(s[i]) {
            if i > start {
                parts.push(s[start..i]);
            }
            start = i + 1;
        }
    }
    return parts;
}

// `s.lines()`: the lines of `s` without their "\n" or "\r\n"; a closing
// "\n" starts no empty line.
fn __zeru_str_lines(s: str) Vec<str> {
    var lines: Vec<str> = Vec.new();
    var start: usize = 0;
    for i in 0..s.len() + 1 {
        if i == s.len() && start == s.len() {
            break;
        }
        if i == s.len() || s[i] == '\n' {
            var end = i;
            if i < s.len() && end > start && s[end - 1] == '\r' {
                end -= 1;
            }
            lines.push(s[start..end]);
            start = i + 1;
        }
    }
    return lines;
}

// `s.trim()`: `s` without the spaces, tabs and line breaks at either end.
fn __zeru_str_trim(s: str) str {
    var start: usize = 0;
    var end = s.len();
    while start < end && __zeru_is_space(s[start]) {
        start += 1;
    }
    while end > start && __zeru_is_space(s[end - 1]) {
        end -= 1;
    }
    return s[start..end];
}

fn __zeru_is_space(byte: u8) bool {
    return byte == ' ' || byte == '\t' || byte == '\n' || byte == '\r';
}

// `s.starts_with(prefix)`: whether `s` begins with `prefix`.
fn __zeru_str_starts_with(s: str, prefix: str) bool {
    return prefix.len() <= s.len() && s[..prefix.len()] == prefix;
}

// `s.ends_with(suffix)`: whether `s` ends with `suffix`.
fn __zeru_str_ends_with(s: str, suffix: str) bool {
    return suffix.len() <= s.len() && s[s.len() - suffix.len()..] == suffix;
}

// `s.parse_int()`: the integer `s` spells, with an optional sign; 22
// (EINVAL) as the error code when it spells none, 34 (ERANGE) when it does
// not fit an i64.
fn __zeru_str_parse_int(s: str) i64! {
    var negative = s.len() > 0 && s[0] == '-';
    var start: usize = 0;
    if s.len() > 0 && (s[0] == '-' || s[0] == '+') {
        start = 1;
    }
    if start == s.len() {
        return Err(22);
    }
    var limit: u64 = 9223372036854775807;
    if negative {
        limit += 1;
    }
    var value: u64 = 0;
    for i in start..s.len() {
        if s[i] < '0' || s[i] > '9' {
            return Err(22);
        }
        var digit = (s[i] - '0') as u64;
        if value > (limit - digit) / 10 {
            return Err(34);
        }
        value = value * 10 + digit;
    }
    if negative {
        var zero: u64 = 0;
        return (zero -% value) as i64;
    }
    return value as i64;
}

// `s.parse_float()`: the number `s` spells, as `-12.5` or `3e-4`, rounded
// to the nearest f64; 22 (EINVAL) as the error code when it spells none.
fn __zeru_str_parse_float(s: str) f64! {
    var at: usize = 0;
    var negative = s.len() > 0 && s[0] == '-';
    if s.len() > 0 && (s[0] == '-' || s[0] == '+') {
        at = 1;
    }
    var mantissa: u64 = 0;
    var digits: i64 = 0;
    var exponent: i64 = 0;
    var seen = false;
    var point = false;
    var inexact = false;
    while at < s.len() {
        if s[at] == '.' && !point {
            point = true;
        } else if s[at] >= '0' && s[at] <= '9' {
            seen = true;
            if digits < 19 {
                mantissa = mantissa * 10 + (s[at] - '0') as u64;
                if mantissa > 0 {
                    digits += 1;
                }
                if point {
                    exponent -= 1;
                }
            } else {
                inexact = inexact || s[at] != '0';
                if !point {
                    exponent += 1;
                }
            }
        } else {
            break;
        }
        at += 1;
    }
    if !seen {
        return Err(22);
    }
    if at < s.len() && (s[at] == 'e' || s[at] == 'E') {
        var power = __zeru_str_parse_int(s[at + 1..])!;
        if power > 1000 {
            power = 1000;
        } else if power < -1000 {
            power = -1000;
        }
        exponent += power;
        at = s.len();
    }
    if at != s.len() {
        return Err(22);
    }
    var value: f64 = 0.0;
    if mantissa != 0 && exponent > 309 {
        value = 1.0 / 0.0;
    } else if mantissa != 0 && exponent >= -343 {
        value = __zeru_nearest(mantissa, exponent, inexact);
    }
    if negative {
        value = -value;
    }
    return value;
}

const POW10: Array<f64, 23> = [
    1e0,
    1e1,
    1e2,
    1e3,
    1e4,
    1e5,
    1e6,
    1e7,
    1e8,
    1e9,
    1e10,
    1e11,
    1e12,
    1e13,
    1e14,
    1e15,
    1e16,
    1e17,
    1e18,
    1e19,
    1e20,
    1e21,
    1e22,
];

// The f64 nearest mantissa * 10^exponent, a tie going to the even one, or
// up when `inexact` says digits past the mantissa were dropped: a guess
// within a few ulps, then moved an ulp at a time by exact comparisons with
// the halfway points around it.
fn __zeru_nearest(mantissa: u64, exponent: i64, inexact: bool) f64 {
    var value = mantissa as f64;
    var left = exponent;
    while left > 0 {
        var step = left;
        if step > 22 {
            step = 22;
        }
        value *= POW10[step];
        left -= step;
    }
    while left < 0 {
        var step = 0 - left;
        if step > 22 {
            step = 22;
        }
        value /= POW10[step];
        left += step;
    }
    if exponent >= -22 && exponent <= 22 && mantissa < 9007199254740992 && !inexact {
        return value;
    }
    if value > 1.7976931348623157e308 {
        value = 1.7976931348623157e308;
    }
    while true {
        var bits = *((&value) as *u64);
        var m = bits & 4503599627370495;
        var k: i64 = -1074;
        if bits >> 52 != 0 {
            m = m | 4503599627370496;
            k = (bits >> 52) as i64 - 1075;
        }
        var up = __zeru_order(mantissa, exponent, 2 * m + 1, k - 1);
        if up > 0 || up == 0 && (inexact || m % 2 == 1) {
            bits += 1;
            value = *((&bits) as *f64);
            if bits >> 52 == 2047 {
                break;
            }
            continue;
        }
        if m == 0 {
            break;
        }
        var down = 0;
        if m == 4503599627370496 && k > -1074 {
            down = __zeru_order(mantissa, exponent, 4 * m - 1, k - 2);
        } else {
            down = __zeru_order(mantissa, exponent, 2 * m - 1, k - 1);
        }
        if down < 0 || down == 0 && !inexact && m % 2 == 1 {
            bits -= 1;
            value = *((&bits) as *f64);
            continue;
        }
        break;
    }
    return value;
}

// -1, 0 or 1 as a * 10^ten is below, equal to or above b * 2^two.
fn __zeru_order(a: u64, ten: i64, b: u64, two: i64) i32 {
    var left = __zeru_big(a);
    var right = __zeru_big(b);
    if ten >= 0 {
        left.mul_pow10(ten);
    } else {
        right.mul_pow10(0 - ten);
    }
    if two >= 0 {
        right.mul_pow2(two);
    } else {
        left.mul_pow2(0 - two);
    }
    return left.cmp(&right);
}

// `v.sort()`: `v` in ascending order, by introsort: quicksort around a
// median of three, insertion sort for short runs, and heapsort for a run
// that keeps splitting badly, so it never takes more than n log n steps.
fn __zeru_vec_sort<T: Ord>(v: &var [T]) {
    var depth: usize = 0;
    var n = v.len();
    while n > 1 {
        depth += 2;
        n /= 2;
    }
    __zeru_quick(v, 0, v.len(), depth);
}

// Sort `v[low..high]`, falling back on heapsort once `depth` splits are
// spent. Elements only trade places and are compared where they are, so
// those that own memory sort too.
fn __zeru_quick<T: Ord>(v: &var [T], low: usize, high: usize, depth: usize) {
    var lo = low;
    var hi = high;
    var left = depth;
    while hi - lo > 16 {
        if left == 0 {
            __zeru_heap(v, lo, hi);
            return;
        }
        left -= 1;
        var mid = lo + (hi - lo) / 2;
        if v[mid] < v[lo] {
            __zeru_vec_swap(v, mid, lo);
        }
        if v[hi - 1] < v[lo] {
            __zeru_vec_swap(v, hi - 1, lo);
        }
        if v[hi - 1] < v[mid] {
            __zeru_vec_swap(v, hi - 1, mid);
        }
        __zeru_vec_swap(v, lo, mid);
        var i = lo;
        var j = hi;
        while true {
            i += 1;
            while i < hi && v[i] < v[lo] {
                i += 1;
            }
            j -= 1;
            while v[lo] < v[j] {
                j -= 1;
            }
            if i >= j {
                break;
            }
            __zeru_vec_swap(v, i, j);
        }
        __zeru_vec_swap(v, lo, j);
        if j - lo < hi - j - 1 {
            __zeru_quick(v, lo, j, left);
            lo = j + 1;
        } else {
            __zeru_quick(v, j + 1, hi, left);
            hi = j;
        }
    }
    for k in lo + 1..hi {
        var at = k;
        while at > lo && v[at] < v[at - 1] {
            __zeru_vec_swap(v, at, at - 1);
            at -= 1;
        }
    }
}

// Heapsort `v[low..high]`.
fn __zeru_heap<T: Ord>(v: &var [T], low: usize, high: usize) {
    var count = high - low;
    var start = count / 2;
    while start > 0 {
        start -= 1;
        __zeru_sift(v, low, start, count);
    }
    var end = count;
    while end > 1 {
        end -= 1;
        __zeru_vec_swap(v, low, low + end);
        __zeru_sift(v, low, 0, end);
    }
}

// Sink element `root` below the larger of its children, in the heap of
// `end` elements that starts at `v[base]`.
fn __zeru_sift<T: Ord>(v: &var [T], base: usize, root: usize, end: usize) {
    var at = root;
    while 2 * at + 1 < end {
        var child = 2 * at + 1;
        if child + 1 < end && v[base + child] < v[base + child + 1] {
            child += 1;
        }
        if v[base + at] >= v[base + child] {
            return;
        }
        __zeru_vec_swap(v, base + at, base + child);
        at = child;
    }
}

// `v.reverse()`: the elements in the opposite order.
fn __zeru_vec_reverse<T>(v: &var [T]) {
    __zeru_flip(v, 0, v.len());
}

// The elements of `v` from `low` up to `high` in the opposite order.
fn __zeru_flip<T>(v: &var [T], low: usize, high: usize) {
    for i in 0..(high - low) / 2 {
        __zeru_vec_swap(v, low + i, high - 1 - i);
    }
}

// `v.rotate_left(n)`: every element `n` places to the left, those that fall
// off the start coming back at the end.
fn __zeru_vec_rotate_left<T>(v: &var [T], n: usize) {
    if v.len() == 0 {
        return;
    }
    var at = n % v.len();
    __zeru_flip(v, 0, at);
    __zeru_flip(v, at, v.len());
    __zeru_flip(v, 0, v.len());
}

// `v.rotate_right(n)`: every element `n` places to the right, those that
// fall off the end coming back at the start.
fn __zeru_vec_rotate_right<T>(v: &var [T], n: usize) {
    if v.len() == 0 {
        return;
    }
    __zeru_vec_rotate_left(v, v.len() - n % v.len());
}

// `v.dedup()`: each run of equal elements next to each other cut down to
// its first; the others are dropped.
fn __zeru_vec_dedup<T: Eq>(v: &var Vec<T>) {
    if v.len() == 0 {
        return;
    }
    var kept: usize = 0;
    for i in 1..v.len() {
        if v[i] != v[kept] {
            kept += 1;
            __zeru_vec_swap(v, kept, i);
        }
    }
    while v.len() > kept + 1 {
        v.pop();
    }
}

// `v.windows(n)`: a view of every run of `n` elements next to each other,
// each starting one element after the one before; none when `v` is
// shorter than `n`.
fn __zeru_vec_windows<T>(v: &[T], n: usize) Vec<&[T]> {
    assert(n > 0, "windows takes a size above 0");
    var parts: Vec<&[T]> = Vec.new();
    var start: usize = 0;
    while start + n <= v.len() {
        parts.push(v[start..start + n]);
        start += 1;
    }
    return parts;
}

// `v.chunks(n)`: views of `v`'s elements `n` at a time, the last one
// shorter when they do not divide evenly.
fn __zeru_vec_chunks<T>(v: &[T], n: usize) Vec<&[T]> {
    assert(n > 0, "chunks takes a size above 0");
    var parts: Vec<&[T]> = Vec.new();
    var start: usize = 0;
    while start < v.len() {
        var end = start + n;
        if end > v.len() {
            end = v.len();
        }
        parts.push(v[start..end]);
        start = end;
    }
    return parts;
}

// `v.swap(i, j)`: exchange two elements. Their bytes trade places, so it
// works for elements that own memory, which cannot be copied out.
fn __zeru_vec_swap<T>(v: &var [T], i: usize, j: usize) {
    var a = (&v[i]) as *u8;
    var b = (&v[j]) as *u8;
    if i == j {
        return;
    }
    var gap: usize = 0;
    if i < j {
        gap = j - i;
    } else {
        var held = a;
        a = b;
        b = held;
        gap = i - j;
    }
    var size = (b as usize - a as usize) / gap;
    for k in 0..size {
        var byte = *(a + k);
        *(a + k) = *(b + k);
        *(b + k) = byte;
    }
}

// `String.from(text)`: a String holding a copy of `text`.
fn __zeru_string_from(text: str) String {
    var s = String.new();
    s.push_str(text);
    return s;
}

// `s.push_str(text)`: `text` added at the end of the String `s`.
fn __zeru_vec_push_str<T>(v: &var Vec<T>, text: str) {
    __zeru_copy_bytes(__zeru_room(v, text.len()), text as *u8, text.len());
    __zeru_filled(v, text.len());
}

// The address of room for `count` more bytes at the end of the String `v`,
// to fill before `__zeru_filled` counts them.
fn __zeru_room<T>(v: &var Vec<T>, count: usize) *u8 {
    v.reserve(count);
    var header = v as *usize;
    return *(header as **u8) + *(header + 1);
}

// Count `count` more bytes of the String `v` as written.
fn __zeru_filled<T>(v: &var Vec<T>, count: usize) {
    var header = v as *usize;
    *(header + 1) += count;
}

// How two Strings order, for comparing tuples holding them.
fn __zeru_string_cmp(a: &String, b: &String) i32 {
    return __zeru_str_cmp(*a, *b);
}

// `v.contains(value)`: whether an element equals `value`.
fn __zeru_vec_contains<T: Eq>(v: &[T], value: T) bool {
    for x in v {
        if x == value {
            return true;
        }
    }
    return false;
}

// `v.sum()`: the elements added up; 0 when there are none.
fn __zeru_vec_sum<T: Num>(v: &[T]) T {
    var total = 0 as T;
    for x in v {
        total += x;
    }
    return total;
}

// `v.min()`: the smallest element; None when there are none.
fn __zeru_vec_min<T: Ord>(v: &[T]) T? {
    if v.len() == 0 {
        return None;
    }
    var best = v[0];
    for x in v {
        if x < best {
            best = x;
        }
    }
    return best;
}

// `v.max()`: the largest element; None when there are none.
fn __zeru_vec_max<T: Ord>(v: &[T]) T? {
    if v.len() == 0 {
        return None;
    }
    var best = v[0];
    for x in v {
        if x > best {
            best = x;
        }
    }
    return best;
}

// Blocks up to this many bytes come from the heap's size classes; larger
// ones are mapped whole.
const HEAP_LARGEST: usize = 1048576;
// How much the heap maps at a time to carve small blocks from.
const HEAP_CHUNK: usize = 4194304;

// Map `size` fresh bytes.
fn __zeru_map(size: usize) *u8 {
    var prot: i64 = PROT_READ + PROT_WRITE;
    var flags: i64 = MAP_PRIVATE + MAP_ANONYMOUS;
    var result: i64 = syscall6(SYS_MMAP, 0, size as i64, prot, flags, -1, 0);
    if result < 0 {
        __zeru_out_of_memory();
    }
    return result as *u8;
}

// The program's memory: a block of
// up to HEAP_LARGEST bytes takes the power of two from 16 bytes that fits
// it, and a freed one waits in its class's list, linked through its first
// bytes, for the next allocation of that class. New blocks are carved from
// mapped chunks. Larger blocks are mapped and unmapped whole. The compiler
// makes one zeroed Heap and passes every allocation through it.
struct Heap {
    free: Array<*u8, 17>,
    next: *u8,
    end: *u8,

    // Bytes for `size` or less, or null for none.
    fn alloc(var self, size: usize) *u8 {
        if size == 0 {
            return 0 as *u8;
        }
        if size > HEAP_LARGEST {
            return __zeru_map(size);
        }
        var class = Heap.class_of(size);
        var bytes: usize = 16 << class;
        var head = self.free[class];
        if head as usize != 0 {
            self.free[class] = *(head as **u8);
            return head;
        }
        if self.next as usize + bytes > self.end as usize {
            self.next = __zeru_map(HEAP_CHUNK);
            self.end = self.next + HEAP_CHUNK;
        }
        var block = self.next;
        self.next = self.next + bytes;
        return block;
    }

    // Move the `old_size` bytes at `old` to a block of `new_size`, freeing
    // the old one; a size of 0 is no block.
    fn realloc(var self, old: *u8, old_size: usize, new_size: usize) *u8 {
        if old_size > HEAP_LARGEST && new_size > HEAP_LARGEST {
            var moved: i64 = syscall5(
                SYS_MREMAP,
                old as i64,
                old_size as i64,
                new_size as i64,
                MREMAP_MAYMOVE,
                0,
            );
            if moved < 0 {
                __zeru_out_of_memory();
            }
            return moved as *u8;
        }
        if old_size > 0 && new_size > 0 && old_size <= HEAP_LARGEST && new_size <= HEAP_LARGEST
            && Heap.class_of(old_size) == Heap.class_of(new_size) {
            return old;
        }
        var new = self.alloc(new_size);
        var kept = old_size;
        if new_size < kept {
            kept = new_size;
        }
        __zeru_copy_bytes(new, old, kept);
        if old_size > HEAP_LARGEST {
            syscall2(SYS_MUNMAP, old as i64, old_size as i64);
        } else if old_size > 0 {
            var class = Heap.class_of(old_size);
            *(old as **u8) = self.free[class];
            self.free[class] = old;
        }
        return new;
    }

    fn class_of(size: usize) usize {
        var class: usize = 0;
        var bytes: usize = 16;
        while bytes < size {
            bytes = bytes << 1;
            class += 1;
        }
        return class;
    }
}
