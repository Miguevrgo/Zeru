// Zeru Standard Library - Linux x86_64 System Calls
// This module provides low-level syscall wrappers using inline assembly.
// It also provides I/O operations as importing is not yet supported
//
// x86_64 Linux syscall convention:
// - rax: syscall number
// - rdi, rsi, rdx, r10, r8, r9: arguments 1-6
// - rax: return value
// - rcx, r11: clobbered by syscall
//
// print(), println(), eprint(), eprintln() are compiler built-ins
// that use implicit OutStream buffers (4KB each for stdout/stderr).
// println/eprintln automatically flush after writing.


const SYS_READ: i64 = 0;
const SYS_WRITE: i64 = 1;
const SYS_MMAP: i64 = 9;
const SYS_MREMAP: i64 = 25;
const SYS_MUNMAP: i64 = 11;
const SYS_EXIT: i64 = 60;

// mmap flags
const PROT_READ: i64 = 1;
const PROT_WRITE: i64 = 2;
const MAP_PRIVATE: i64 = 2;
const MAP_ANONYMOUS: i64 = 32;

// mremap flags
const MREMAP_MAYMOVE: i64 = 1;

fn syscall1(nr: i64, arg1: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        : "={rax}" (result)
        : "{rax}" (nr), "{rdi}" (arg1)
        : "rcx", "r11", "memory"
    );
    return result;
}

fn exit(code: i32) {
    syscall1(SYS_EXIT, code as i64);
}

fn syscall2(nr: i64, arg1: i64, arg2: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        : "={rax}" (result)
        : "{rax}" (nr), "{rdi}" (arg1), "{rsi}" (arg2)
        : "rcx", "r11", "memory"
    );
    return result;
}

fn syscall3(nr: i64, arg1: i64, arg2: i64, arg3: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        :   "={rax}" (result)
        :   "{rax}" (nr),
            "{rdi}" (arg1),
            "{rsi}" (arg2),
            "{rdx}" (arg3)
        : "rcx", "r11", "memory"
    );
    return result;
}

fn syscall5(nr: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64, arg5: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        :   "={rax}" (result)
        :   "{rax}" (nr),
            "{rdi}" (arg1),
            "{rsi}" (arg2),
            "{rdx}" (arg3),
            "{r10}" (arg4),
            "{r8}" (arg5)
        : "rcx", "r11", "memory"
    );
    return result;
}

fn syscall6(nr: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64, arg5: i64, arg6: i64) i64 {
    var result: i64 = 0;
    asm volatile (
        "syscall"
        :   "={rax}" (result)
        :   "{rax}" (nr),
            "{rdi}" (arg1),
            "{rsi}" (arg2),
            "{rdx}" (arg3),
            "{r10}" (arg4),
            "{r8}" (arg5),
            "{r9}" (arg6)
        : "rcx", "r11", "memory"
    );
    return result;
}

struct OutStream {
    fd: i32,
    buffer: Array<u8, 4096>,
    index: usize,

    fn flush(var self) i64 {
        if self.index == 0 {
            return 0;
        }

        var buf_ptr: *u8 = &self.buffer[0];
        var amount_written: i64 = syscall3(SYS_WRITE, self.fd as i64, buf_ptr as i64, self.index as i64);
        self.index = 0;

        if amount_written < 0 {
            return -1;
        }
        return amount_written;
    }

    fn write_bytes(var self, bytes: *u8, count: usize) i64 {
        var src_index: usize = 0;
        var remaining: usize = count;

        while remaining > 0 {
            var space_left: usize = 4096 - self.index;
            var to_copy: usize = remaining;

            if space_left < remaining {
                to_copy = space_left;
            }

            var copy_idx: usize = 0;
            while copy_idx < to_copy {
                var src_ptr: *u8 = bytes + src_index + copy_idx;
                self.buffer[self.index + copy_idx] = *src_ptr;
                copy_idx += 1;
            }

            self.index += to_copy;
            src_index += to_copy;
            remaining -= to_copy;

            if self.index == 4096 {
                var flush_result: i64 = self.flush();
                if flush_result < 0 {
                    return flush_result;
                }
            }
        }

        return count as i64;
    }

    fn write_text(var self, text: str) {
        self.write_bytes(text as *u8, text.len());
    }

    // A whole number in decimal.
    fn write_uint(var self, value: u64) {
        var digits: Array<u8, 20> = [0; 20];
        var at: usize = 20;
        var rest = value;
        while true {
            at -= 1;
            digits[at] = '0' + (rest % 10) as u8;
            rest /= 10;
            if rest == 0 {
                break;
            }
        }
        self.write_bytes(&digits[at], 20 - at);
    }

    fn write_int(var self, value: i64) {
        if value < 0 {
            self.write_text("-");
            // Wrapping keeps the most negative value, whose magnitude no i64 holds.
            self.write_uint(0 -% (value as u64));
            return;
        }
        self.write_uint(value as u64);
    }

    // At most six decimals, rounded, without trailing zeros: 2.5, 0.1, 3.0.
    // ponytail: not the shortest round-trip form; past 1e18, 1e-6 precision.
    fn write_float(var self, value: f64) {
        if value != value {
            self.write_text("NaN");
            return;
        }
        var rest = value;
        if rest < 0 {
            self.write_text("-");
            rest = -rest;
        }
        if rest > 18446744073709551615.0 {
            self.write_text("inf");
            return;
        }
        var whole = rest as u64;
        var millionths = ((rest - whole as f64) * 1000000 + 0.5) as u64;
        if millionths == 1000000 {
            whole += 1;
            millionths = 0;
        }
        self.write_uint(whole);
        self.write_text(".");

        var digits: Array<u8, 6> = [0; 6];
        var at: usize = 6;
        while at > 0 {
            at -= 1;
            digits[at] = '0' + (millionths % 10) as u8;
            millionths /= 10;
        }
        var used: usize = 6;
        while used > 1 && digits[used - 1] == '0' {
            used -= 1;
        }
        self.write_bytes(&digits[0], used);
    }
}

// =============================================================================
// Memory Allocation Functions
// These functions are called by the compiler for Vec<T> operations.
// =============================================================================

// Allocate `size` bytes of memory using mmap.
// Returns a pointer to the allocated memory, or null (0) on failure.
fn __zeru_alloc(size: usize) *u8 {
    // mmap(addr=NULL, length=size, prot=READ|WRITE, flags=PRIVATE|ANONYMOUS, fd=-1, offset=0)
    var prot: i64 = PROT_READ + PROT_WRITE;
    var flags: i64 = MAP_PRIVATE + MAP_ANONYMOUS;
    var result: i64 = syscall6(SYS_MMAP, 0, size as i64, prot, flags, -1, 0);

    // mmap returns -errno on failure (negative value)
    if result < 0 {
        return 0 as *u8;
    }
    return result as *u8;
}

// Reallocate memory: allocate new_size, copy old data, free old memory.
// Returns pointer to new memory, or null on failure.
fn __zeru_realloc(old_ptr: *u8, old_size: usize, new_size: usize) *u8 {
    if new_size == 0 {
        syscall2(SYS_MUNMAP, old_ptr as i64, old_size as i64);
        return 0 as *u8;
    }
    if old_size == 0 {
        return __zeru_alloc(new_size);
    }
    // Reallocate memory
    var new_ptr: *u8 = syscall5(
        SYS_MREMAP,
        old_ptr as i64,
        old_size as i64,
        new_size as i64,
        MREMAP_MAYMOVE,
        0
    ) as *u8;

    // Check for failure
    if new_ptr as i64 < 0 {
        return 0 as *u8;
    }

    return new_ptr;
}

// Copy n bytes from src to dest. The two may overlap: copying runs backwards
// when dest is above src, so nothing is overwritten before it is read.
fn __zeru_memmove(dest: *u8, src: *u8, n: usize) {
    var i: usize = 0;
    while i < n {
        var at: usize = i;
        if dest > src {
            at = n - 1 - i;
        }
        var dest_ptr: *u8 = dest + at;
        var src_ptr: *u8 = src + at;
        *dest_ptr = *src_ptr;
        i += 1;
    }
}
