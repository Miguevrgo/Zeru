// Result type (T!) integration test
// Tests is_ok, is_err, unwrap, unwrap_err, and propagation with ? and !
// Uses exit codes to verify behavior

const EMPTY: i32 = 1;
const NOT_DIGIT: i32 = 2;

fn digit(c: u8) i32! {
    if c < '0' || c > '9' {
        return Err(NOT_DIGIT);
    }
    return (c - '0') as i32;
}

// `!` hands an error back to the caller as it is.
fn number(text: str) i32! {
    if text.len() == 0 {
        return Err(EMPTY);
    }
    var total = 0;
    for i in 0..text.len() {
        total = total * 10 + digit(text[i])!;
    }
    return total;
}

fn first(items: Vec<i64>) i64? {
    if items.is_empty() {
        return None;
    }
    return items[0];
}

// `?` hands a missing value back to the caller.
fn first_doubled(items: Vec<i64>) i64? {
    return first(items)? * 2;
}

fn divide(a: i32, b: i32) i32! {
    if b == 0 {
        return Err(1);
    }
    return a / b;
}

fn name(n: i32) str? {
    if n == 0 {
        return None;
    }
    return "one";
}

fn pair() (i32, i32)? {
    return (1, 2);
}

fn sign(n: i32?) i32 {
    match n {
        Some(v) => {
            return v;
        }
        None => {
            return 0;
        }
    }
}

fn always_fail() i64! {
    return Err(42);
}

fn always_ok() i64! {
    var v: i64 = 100;
    return v;
}

fn main() {
    var r1: i32! = divide(10, 2);
    assert(r1.is_ok());
    assert(r1.is_ok());
    var val: i32 = r1.unwrap();
    assert(val == 5);

    var r2: i32! = divide(10, 0);
    assert(r2.is_err());
    assert(r2.is_err());
    var code: i32 = r2.unwrap_err();
    assert(code == 1);

    var r3: i64! = always_ok();
    assert(r3.is_ok());
    assert(r3.unwrap() == 100);

    var r4: i64! = always_fail();
    assert(r4.is_err());
    assert(r4.unwrap_err() == 42);

    var r5: i32! = divide(20, 4);
    assert(r5.unwrap() == 5);

    assert(number("123").unwrap() == 123);
    assert(number("1x").unwrap_err() == NOT_DIGIT);
    assert(number("").unwrap_err() == EMPTY);
    assert(number("9z").is_err() && number("42").unwrap() == 42);
    assert(first_doubled(Vec.new()).is_none() && first_doubled(Vec[3]).unwrap() == 6);
    assert(name(0).is_none() && name(1).is_some());
    assert(pair().unwrap().1 == 2 && sign(None) == 0);

    println("result: all tests passed");
}
