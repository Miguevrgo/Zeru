// A generic binary min-heap, used with integers and floats, then a list of
// values that own memory, moved around and dropped, with each drop counted.

struct MinHeap<T: Ord> {
    items: Vec<T>,

    fn new() MinHeap<T> {
        return MinHeap { items: Vec.new() };
    }

    fn len(self) usize {
        return self.items.len();
    }

    fn swap(var self, a: usize, b: usize) {
        var held = self.items[a];
        self.items[a] = self.items[b];
        self.items[b] = held;
    }

    fn push(var self, value: T) {
        self.items.push(value);
        var at = self.items.len() - 1;
        while at > 0 {
            var parent = (at - 1) / 2;
            if self.items[parent] <= self.items[at] {
                break;
            }
            self.swap(at, parent);
            at = parent;
        }
    }

    fn pop(var self) T? {
        if self.items.is_empty() {
            return None;
        }
        var last = self.items.len() - 1;
        self.swap(0, last);
        var top = self.items.pop();
        var at: usize = 0;
        while true {
            var smallest = at;
            for child in 2 * at + 1..2 * at + 3 {
                if child < self.items.len() && self.items[child] < self.items[smallest] {
                    smallest = child;
                }
            }
            if smallest == at {
                break;
            }
            self.swap(at, smallest);
            at = smallest;
        }
        return top;
    }
}

// Drain a heap into a Vec, smallest first.
fn sorted<T: Ord>(var heap: MinHeap<T>) Vec<T> {
    var out: Vec<T> = Vec.new();
    while heap.len() > 0 {
        out.push(heap.pop().unwrap());
    }
    return out;
}

// A shelf owns its list of item weights; dropping it is counted.
struct Shelf {
    label: str,
    weights: Vec<i64>,
    drops: *i32,

    fn total(self) i64 {
        var sum: i64 = 0;
        for w in self.weights {
            sum += w;
        }
        return sum;
    }

    fn drop(var self) {
        *self.drops += 1;
        println("  drop {} ({} items)", self.label, self.weights.len());
    }
}

fn shelf(label: str, n: i64, drops: *i32) Shelf {
    var s = Shelf { label: label, weights: Vec.new(), drops: drops };
    for i in 1..n + 1 {
        s.weights.push(i * i);
    }
    return s;
}

// Takes the shelf, so it is dropped here.
fn weigh(s: Shelf) i64 {
    return s.total();
}

fn main() {
    var ints: MinHeap<i64> = MinHeap.new();
    var seed: u64 = 12345;
    for i in 0..20 {
        seed = seed *% 6364136223846793005 +% 1442695040888963407;
        ints.push((seed >> 33) as i64 % 1000);
    }
    var floats: MinHeap<f64> = MinHeap.new();
    for x in [2.5, -1.0, 3.75, 0.5, -7.25, 2.5] {
        floats.push(x);
    }

    var ordered = sorted(ints);
    print("ints:");
    for v in ordered {
        print(" {}", v);
    }
    println("");
    for i in 1..ordered.len() {
        assert(ordered[i - 1] <= ordered[i]);
    }
    var fs = sorted(floats);
    println("floats: {} {} {} .. {}", fs[0], fs[1], fs[2], fs[5]);
    assert(ordered.len() == 20 && ordered[0] == 0 && ordered[19] == 950);
    assert(fs[0] == -7.25 && fs[5] == 3.75);

    var drops: i32 = 0;
    {
        var shelves: Vec<Shelf> = Vec.new();
        shelves.push(shelf("a", 3, &drops));
        shelves.push(shelf("b", 4, &drops));
        shelves.push(shelf("c", 5, &drops));
        println("built 3 shelves, drops {}", drops);

        var taken = shelves.remove(1);
        println("weigh b: {}", weigh(taken));
        assert(drops == 1);

        var moved = shelves.pop().unwrap();
        shelves.push(shelf("d", 2, &drops));
        var copy_of_a_weights = shelves[0].weights.copy();
        println("c weighs {}, a's weights copied: {}", moved.total(), copy_of_a_weights.len());

        shelves[0] = shelf("e", 1, &drops);
        assert(drops == 2);
        println("end of scope, drops {}", drops);
    }
    println("all dropped: {}", drops);
    assert(drops == 5);
}
