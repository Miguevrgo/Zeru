// Integer and floating point routines, each checked against a known answer.

import std.math;

const LIMIT: i32 = 3;

fn gcd(a: i64, b: i64) i64 {
    var x: i64 = a;
    var y: i64 = b;
    while y != 0 {
        var keep: i64 = y;
        y = x % y;
        x = keep;
    }
    return x;
}

fn lcm(a: i64, b: i64) i64 {
    return a / gcd(a, b) * b;
}

fn digit_sum(value: i64) i64 {
    var left: i64 = value;
    var total: i64 = 0;
    while left > 0 {
        total += left % 10;
        left = left / 10;
    }
    return total;
}

fn ones(value: u64) i32 {
    var seen: i32 = 0;
    var left: u64 = value;
    while left != 0 {
        if left & 1 == 1 {
            seen += 1;
        }
        left = left >> 1;
    }
    return seen;
}

// Sieve over a fixed array: mark composites, then count what is left.
fn count_primes_below(limit: usize) i32 {
    var composite: Array<bool, 50> = [false; 50];
    var found: i32 = 0;
    var n: usize = 2;
    while n < limit {
        if !composite[n] {
            found += 1;
            var multiple: usize = n * n;
            while multiple < limit {
                composite[multiple] = true;
                multiple += n;
            }
        }
        n += 1;
    }
    return found;
}

fn near(a: f64, b: f64) bool {
    return math::abs(a - b) < 0.0001;
}

fn sqrt(x: f64) f64 {
    if x <= 0.0 {
        return 0.0;
    }
    var guess: f64 = x;
    var step: i32 = 0;
    while step < 40 {
        guess = (guess + x / guess) / 2.0;
        step += 1;
    }
    return guess;
}

fn main() {
    assert(gcd(48, 18) == 6);
    assert(gcd(17, 5) == 1);
    assert(gcd(9, 0) == 9);
    assert(lcm(4, 6) == 12);

    assert(math::pow(2, 10) == 1024);
    assert(math::pow(3, 0) == 1);
    assert(math::pow(7, 1) == 7);

    assert(digit_sum(1234) == 10);
    assert(digit_sum(0) == 0);

    assert(ones(255) == 8);
    assert(ones(0) == 0);
    assert(ones(1024) == 1);

    assert(math::is_power_of_two(64));
    assert(!math::is_power_of_two(63));
    assert(!math::is_power_of_two(0));

    assert(count_primes_below(50) == 15);
    assert(count_primes_below(3) == 1);

    assert(near(sqrt(9.0), 3.0));
    assert(near(sqrt(2.0), 1.41421356));
    assert(sqrt(0.0) == 0.0);

    var precise = 3.14159265358979;
    var annotated: f64 = 3.14159265358979;
    assert(precise == annotated);

    var third: f64 = 1.0 / 3.0;
    assert(near(third * 3.0, 1.0));

    assert(2.9 as i32 == 2);
    assert(-2.9 as i32 == -2);

    var narrow: f32 = 1.5;
    assert(narrow as f64 == 1.5);

    var lowest: i64 = -9223372036854775808;
    assert(lowest + 1 == -9223372036854775807);
    var highest: u64 = 18446744073709551615;
    assert(highest - 1 == 18446744073709551614);

    assert(3 <= highest);
    var single: f32 = 1.5;
    assert(2.0 * single == 3.0);
    var rest: f64 = 7.5;
    var step: f64 = 2.0;
    assert(rest % step == 1.5);
    var counted = 0;
    for i in 0..LIMIT {
        counted += 1;
    }
    assert(counted == LIMIT);

    println("numeric: all tests passed");
    exit(0);
}
