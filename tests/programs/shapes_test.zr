// Structs put to work: a shape kind chosen by an enum, shapes held in an
// array and in a Vec, methods that return and that mutate.

enum Kind {
    Square,
    Rectangle,
    Circle,
}

struct Shape {
    kind: Kind,
    width: i32,
    height: i32,

    fn area(self) i32 {
        return match self.kind {
            Kind::Square => self.width * self.width,
            Kind::Rectangle => self.width * self.height,
            Kind::Circle => 3 * self.width * self.width,
        };
    }

    fn perimeter(self) i32 {
        return match self.kind {
            Kind::Square => 4 * self.width,
            Kind::Rectangle => 2 * (self.width + self.height),
            Kind::Circle => 6 * self.width,
        };
    }

    fn scaled(self, factor: i32) Shape {
        return Shape { kind: self.kind, width: self.width * factor, height: self.height * factor };
    }

    fn grow(var self, by: i32) {
        self.width += by;
        self.height += by;
    }
}

struct Drawing {
    shapes: Vec<Shape>,

    fn add(var self, shape: Shape) {
        self.shapes.push(shape);
    }

    fn total_area(self) i32 {
        var total: i32 = 0;
        var i: usize = 0;
        while i < self.shapes.len() {
            total += self.shapes[i].area();
            i += 1;
        }
        return total;
    }

    fn widest(self) Shape? {
        if self.shapes.is_empty() {
            return None;
        }
        var best: Shape = self.shapes[0];
        var i: usize = 1;
        while i < self.shapes.len() {
            if self.shapes[i].width > best.width {
                best = self.shapes[i];
            }
            i += 1;
        }
        return best;
    }
}

fn area_through_pointer(shape: *Shape) i32 {
    return shape.area();
}

fn main() {
    var square = Shape { kind: Kind::Square, width: 3, height: 3 };
    assert(square.area() == 9);
    assert(square.perimeter() == 12);

    var rect = Shape { kind: Kind::Rectangle, width: 4, height: 5 };
    assert(rect.area() == 20);
    assert(rect.perimeter() == 18);

    var circle = Shape { kind: Kind::Circle, width: 2, height: 0 };
    assert(circle.area() == 12);

    var bigger = square.scaled(2);
    assert(bigger.area() == 36);
    assert(square.area() == 9);

    rect.grow(1);
    assert(rect.width == 5);
    assert(rect.area() == 30);

    assert(area_through_pointer(&square) == 9);

    var row: Array<Shape, 3> = [
        Shape { kind: Kind::Square, width: 1, height: 1 },
        Shape { kind: Kind::Square, width: 2, height: 2 },
        Shape { kind: Kind::Square, width: 3, height: 3 },
    ];
    var sum: i32 = 0;
    for shape in row {
        sum += shape.area();
    }
    assert(sum == 14);
    row[1].width = 4;
    assert(row[1].area() == 16);

    var drawing = Drawing { shapes: Vec.new() };
    assert(drawing.total_area() == 0);
    assert(drawing.widest().is_none());

    drawing.add(Shape { kind: Kind::Square, width: 2, height: 2 });
    drawing.add(Shape { kind: Kind::Rectangle, width: 10, height: 1 });
    drawing.add(Shape { kind: Kind::Circle, width: 1, height: 0 });
    assert(drawing.shapes.len() == 3);
    assert(drawing.total_area() == 17);

    var widest = drawing.widest();
    assert(widest.is_some());
    assert(widest.unwrap().width == 10);

    drawing.shapes[0].grow(3);
    assert(drawing.shapes[0].area() == 25);
    assert(drawing.total_area() == 38);

    println("shapes: all tests passed");
    exit(0);
}
