// Vec<T> integration test
// Tests basic Vec operations: push, pop, len, clear, copy
// Uses exit codes to verify behavior

fn main() {
    var numbers: Vec<i64> = Vec.new();
    assert(numbers.len() == 0);

    numbers.push(10);
    numbers.push(20);
    numbers.push(30);
    assert(numbers.len() == 3);

    numbers.pop();
    assert(numbers.len() == 2);

    numbers.clear();
    assert(numbers.len() == 0);

    numbers.push(100);
    numbers.push(200);
    var copied = numbers.copy();
    assert(numbers.len() == 2);
    assert(copied.len() == 2);

    numbers.push(300);
    assert(numbers.len() == 3);
    assert(copied.len() == 2);

    var items: Vec<i64> = Vec.new();
    var n: i64 = 1;
    while n <= 4 {
        items.push(n);
        n += 1;
    }

    items[1] = 20;
    items[2] += 30;
    assert(items[1] == 20);
    assert(items[2] == 33);
    assert(items[0] == 1);

    var walked: i64 = 0;
    for item in items {
        walked += item;
    }
    assert(walked == 58);

    var empty: Vec<i64> = Vec.new();
    var turns: i32 = 0;
    for item in empty {
        turns += 1;
    }
    assert(turns == 0);

    var reserved: Vec<i64> = Vec.with_capacity(4);
    assert(reserved.capacity() == 4);
    reserved.push(7);
    assert(reserved.len() == 1 && reserved[0] == 7);
    assert(reserved.capacity() == 4);

    var listed: Vec<i64> = [1, 2, 4];
    listed.insert(2, 3);
    listed.insert(4, 5);
    listed.insert(0, 0);
    assert(listed.len() == 6);
    var at: usize = 0;
    while at < 6 {
        assert(listed[at] == at as i64);
        at += 1;
    }
    assert(listed.remove(0) == 0 && listed.remove(4) == 5 && listed.remove(1) == 2);
    assert(listed.len() == 3 && listed[0] == 1 && listed[1] == 3 && listed[2] == 4);

    var zeros: Vec<i64> = [0; 100];
    assert(zeros.len() == 100 && zeros[99] == 0);
    zeros.reserve(200);
    assert(zeros.capacity() >= 300 && zeros.len() == 100);
    zeros.shrink_to_fit();
    assert(zeros.capacity() == 100 && zeros[50] == 0);

    var grid: Vec<Vec<i64>> = [[1, 2], [3]];
    var twin = grid.copy();
    twin[0][0] = 9;
    twin[1].push(4);
    assert(grid[0][0] == 1 && grid[1].len() == 1);
    assert(twin[0][0] == 9 && twin[1].len() == 2);

    println("Vec tests passed!");
    exit(0);
}
