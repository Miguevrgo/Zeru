import std.fs;
import std.os;

fn main() {
    assert(os::pid() != 0 && os::parent_pid() != 0);
    assert(os::time() >= 1000000000);
    var clock = os::Clock.now();
    os::sleep(1);
    assert(clock.elapsed() >= 1000000);
    assert(fs::current_dir().unwrap().starts_with("/"));
    assert(os::run("true", []).unwrap() == 0);
    println("os: all tests passed");
}
