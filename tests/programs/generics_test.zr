// Generic structs: the type arguments come from the values, or from a written
// type when the values do not settle them.

trait Shape {
    fn area(self) i32;
}

struct Square {
    side: i32,
    fn area(self) i32 {
        return self.side * self.side;
    }
}

struct Pair<T: Eq> {
    first: T,
    second: T,

    fn swap(self) Pair<T> {
        return Pair { first: self.second, second: self.first };
    }
    fn same(self) bool {
        return self.first == self.second;
    }
    fn with<U>(self, extra: U) (T, U) {
        return (self.first, extra);
    }
}

struct Counter<T: Num> {
    value: T,
    step: T,

    fn bump(var self) {
        self.value = self.value + self.step;
    }
}

struct Holder<T> {
    items: Vec<T>,
    fallback: T,

    fn take(self, index: usize) T {
        var got = self.items.get(index).copy();
        if got.is_none() {
            return self.fallback;
        }
        return got.unwrap();
    }
}

struct Wrap<T: Shape> {
    inner: T,
    fn doubled(self) i32 {
        return self.inner.area() * 2;
    }
}

struct Kept {
    pair: Pair<i64>,
}

fn largest<T>(a: T, b: T) T {
    if a > b {
        return a;
    }
    return b;
}

fn identity<T>(x: T) T {
    return x;
}

fn first<T, U>(a: T, b: U) T {
    return a;
}

fn second<T, U>(a: T, b: U) U {
    return b;
}

fn head<T: Eq>(p: Pair<T>) T {
    return p.first;
}

fn make() Pair<i64> {
    return Pair { first: 10, second: 20 };
}

fn main() {
    var p = Pair { first: 1, second: 2 };
    assert(p.first == 1);
    assert(!p.same());

    var q = p.swap();
    assert(q.first == 2);
    assert(q.second == 1);

    var wide: Pair<i64> = Pair { first: 100, second: 200 };
    assert(wide.swap().first == 200);
    assert(largest(wide.first, wide.second) == 200);

    var narrow = Pair { first: 7, second: 7 };
    assert(narrow.same());
    assert(!wide.same());

    var made = make();
    assert(made.second == 20);

    var c = Counter { value: 0, step: 5 };
    c.bump();
    c.bump();
    assert(c.value == 10);

    var stepped: Counter<i64> = Counter { value: 1, step: 9 };
    stepped.bump();
    assert(stepped.value == 10);

    var fractional = Counter { value: 0.5, step: 0.25 };
    fractional.bump();
    assert(fractional.value == 0.75);

    var holder: Holder<i64> = Holder { items: Vec.new(), fallback: -1 };
    holder.items.push(3);
    holder.items.push(4);
    assert(holder.take(1) == 4);
    assert(holder.take(99) == -1);

    assert(identity(42) == 42);
    assert(identity(3.14) == 3.14);
    assert(identity(true));
    assert(identity(Square { side: 4 }).area() == 16);
    assert(first(10, 3.14) == 10);
    assert(second(true, 2.5) == 2.5);

    var big: u32 = 3000000000;
    var small: u32 = 1;
    assert(largest(big, small) == big);
    var wide: i64 = 5000000000;
    assert(largest(wide, 7) == wide);
    assert(largest(7, wide) == wide);
    assert(head(made) == 10);
    assert(made.with(true).1);
    assert(made.with(2.5).1 == 2.5);
    var kept = Kept { pair: make() };
    assert(kept.pair.with(true).1);

    var wrapped = Wrap { inner: Square { side: 3 } };
    assert(wrapped.inner.area() == 9);
    assert(wrapped.doubled() == 18);

    println("generics: all tests passed");
    exit(0);
}
