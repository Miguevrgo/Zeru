// Tuples: built, read and written by position, and carried around.

struct Span {
    range: (usize, usize),
    label: str,
}

fn pair_sum(p: (i32, i32)) i32 {
    return p.0 + p.1;
}

fn divide(a: i32, b: i32) (i32, i32) {
    return (a / b, a % b);
}

fn widen(narrow: (i32, i32)) (i64, i64) {
    return (narrow.0 as i64, narrow.1 as i64);
}

fn main() {
    var p: (i32, i32) = (3, 4);
    assert(p.0 == 3);
    assert(p.1 == 4);
    assert(pair_sum(p) == 7);

    p.0 = 10;
    assert(p.0 == 10);
    assert(p.1 == 4);
    p.1 += 6;
    assert(p.1 == 10);

    var mixed: (i32, i64) = (1, 2);
    assert(mixed.1 == 2);

    var divided = divide(17, 5);
    assert(divided.0 == 3);
    assert(divided.1 == 2);

    var wide = widen((1, 2));
    assert(wide.1 == 2);

    var nested: ((i32, i32), i32) = ((1, 2), 3);
    assert((nested.0).1 == 2);
    assert(nested.1 == 3);

    var cells: Array<(i32, i32), 2> = [(1, 2), (3, 4)];
    assert(cells[1].0 == 3);
    cells[0].1 = 9;
    assert(cells[0].1 == 9);

    var span = Span { range: (2, 5), label: "word" };
    assert(span.range.1 == 5);
    span.range.0 = 3;
    assert(span.range.0 == 3);
    println("{}", span.label);

    var spans: Vec<(usize, usize)> = Vec.new();
    spans.push((0, 1));
    spans.push((2, 3));
    var total: usize = 0;
    for range in spans {
        total += range.1 - range.0;
    }
    assert(total == 2);
    assert(spans[1].0 == 2);

    println("tuples: all tests passed");
}
