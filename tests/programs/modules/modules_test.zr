// Multi-file project: paths resolve from this file's directory, so `geom.area`
// means the same thing here and inside shapes.zr, which also imports it.
import geom.area;
import shapes;
import stock;

fn main() {
    assert(area::rectangle(3, 4) == 12);
    assert(area::scale(5, 3) == 15);

    var r = shapes::Rect { w: 2, h: 5 };
    assert(r.area() == 10);
    assert(shapes::doubled(r) == 20);

    var pile = stock::pile_of(7);
    assert(pile.first() == 7);
    assert(pile.level() == stock::Level::Low);
    assert(stock::capped(500, 20) == 20);
    assert(stock::limit() == 100);
    assert(stock::weigh(12) == 12);
    assert(stock::started() == 2);

    println("modules: all tests passed");
}
