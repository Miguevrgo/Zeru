import std.net;

fn main() {
    var bind_r = net::TcpListener.bind(0, 0);
    if bind_r.is_err() {
        exit(1);
    }
    var listener = bind_r.unwrap();

    listener.close();

    var ip: u32 = net::ip4(127, 0, 0, 1);
    if ip != 2130706433 {
        exit(3);
    }

    var addr = net::make_addr(ip, 8080);
    if addr[0] != 2 {
        exit(4);
    }
    if addr[2] != 31 {
        exit(5);
    }
    if addr[3] != 144 {
        exit(6);
    }

    var udp_r = net::UdpSocket.bind(0, 0);
    if udp_r.is_err() {
        exit(7);
    }
    var udp = udp_r.unwrap();
    udp.close();

    println("net: all tests passed");
}
