import std.fs;

fn main() {
    var path = "build/test_fs.txt";

    var wr = fs::write_file(path, "Hello from Zeru!");
    if wr.is_err() {
        exit(1);
    }
    if !fs::exists(path) {
        exit(2);
    }
    var meta = fs::metadata(path);
    if meta.is_err() {
        exit(3);
    }
    if meta.unwrap().size != 16 {
        exit(4);
    }

    var rd = fs::read_file(path);
    if rd.is_err() {
        exit(5);
    }
    if rd.unwrap().len() != 16 {
        exit(6);
    }
    if rd.unwrap()[0] != 'H' {
        exit(7);
    }

    var path2 = "build/test_fs2.txt";
    var file = fs::File.create(path2);
    if file.is_err() {
        exit(8);
    }
    var out = file.unwrap();
    if out.write("test").is_err() {
        exit(9);
    }
    if fs::read_file(path2).unwrap() != "test" {
        exit(10);
    }
    if fs::remove_file(path).is_err() {
        exit(11);
    }
    if fs::remove_file(path2).is_err() {
        exit(12);
    }
    if fs::exists(path) {
        exit(13);
    }

    println("fs: all tests passed");
}
