import std.fs;

fn main() {
    var path = "build/test_fs.txt";

    var wr = fs::write_file(path, "Hello from Zeru!");
    assert(wr.is_ok());
    assert(fs::exists(path));
    var meta = fs::metadata(path);
    assert(meta.is_ok());
    assert(meta.unwrap().size == 16);

    var rd = fs::read_file(path);
    assert(rd.is_ok());
    var text = rd.unwrap();
    assert(text.len() == 16);
    assert(text[0] == 'H');

    var path2 = "build/test_fs2.txt";
    var file = fs::File.create(path2);
    assert(file.is_ok());
    var out = file.unwrap();
    assert(out.write("test").is_ok());
    assert(fs::read_file(path2).unwrap() == "test");
    assert(fs::remove_file(path).is_ok());
    assert(fs::remove_file(path2).is_ok());
    assert(!fs::exists(path));

    println("fs: all tests passed");
}
