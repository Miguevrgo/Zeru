// Odd corners that are easy to break: constants, mutual recursion, optionals
// and results carrying aggregates, a large array, and shadowing in a loop.

const LIMIT: i32 = 10;
const RATIO: f64 = 1.5;
const ON: bool = true;
const GREETING: str = "hi";
const SPAN: i32 = LIMIT * 2 + 1;

struct Small {
    n: i32,
}

struct Maybe {
    value: i32?,
    tag: i32,
}

fn even(n: i32) bool {
    if n == 0 {
        return true;
    }
    return odd(n - 1);
}

fn odd(n: i32) bool {
    if n == 0 {
        return false;
    }
    return even(n - 1);
}

fn maybe_small(yes: bool) Small? {
    if yes {
        return Small { n: 3 };
    }
    return None;
}

fn wrapped(yes: bool) Small! {
    if yes {
        return Small { n: 4 };
    }
    return Err(9);
}

struct Growing {
    v: Vec<i64>,
    fn grow(var self) i64 {
        var i: i64 = 0;
        while i < 100000 {
            self.v.push(i);
            i += 1;
        }
        return 7;
    }
}

fn doubled(a: i64) i64? {
    return a * 2;
}

fn first_over(data: Array<i32, 5>, limit: i32) i32? {
    var i: usize = 0;
    while i < 5 {
        if data[i] > limit {
            return data[i];
        }
        i += 1;
    }
    return None;
}

fn main() {
    assert(LIMIT == 10);
    assert(RATIO == 1.5);
    assert(ON);
    assert(SPAN == 21);
    assert(GREETING.len() == 2);
    {
        var LIMIT: i32 = 3;
        assert(LIMIT == 3);
    }

    assert(even(8));
    assert(!even(7));
    assert(odd(9));

    var some = maybe_small(true);
    assert(some.is_some());
    assert(some.unwrap().n == 3);
    assert(maybe_small(false).is_none());

    var ok = wrapped(true);
    assert(ok.unwrap().n == 4);
    assert(wrapped(false).is_err());
    assert(wrapped(false).unwrap_err() == 9);

    var holder = Maybe { value: 5, tag: 1 };
    assert(holder.value.unwrap() == 5);
    var blank = Maybe { value: None, tag: 2 };
    assert(blank.value.is_none());

    var data: Array<i32, 5> = [1, 5, 9, 2, 7];
    assert(first_over(data, 4).unwrap() == 5);
    assert(first_over(data, 100).is_none());

    var big: Array<i64, 64> = [0; 64];
    var i: usize = 0;
    while i < 64 {
        big[i] = i as i64 * 2;
        i += 1;
    }
    assert(big[63] == 126);
    var total: i64 = 0;
    for value in big {
        total += value;
    }
    assert(total == 4032);

    var counter: i32 = 0;
    var round: i32 = 0;
    while round < 3 {
        var counter: i32 = 10;
        counter += 1;
        assert(counter == 11);
        round += 1;
    }
    assert(counter == 0);

    var a: i64 = 3;
    var sum: i64? = a + 4;
    var neg: i64? = -a;
    var n: i32 = 7;
    var p: *i32 = &n;
    var read: i32? = *p;
    assert(doubled(a).unwrap() == 6);
    assert(sum.unwrap() == 7 && neg.unwrap() == -3 && read.unwrap() == 7);

    var g = Growing { v: [1] };
    g.v[0] = g.grow();
    assert(g.v[0] == 7 && g.v.len() == 100001);

    println("corners: all tests passed");
    exit(0);
}
