// Raw strings, checked byte by byte: a backtick string keeps the backslashes
// and the quotes it is written with, where a quoted one reads them as escapes.

fn equal(left: str, right: str) bool {
    if left.len() != right.len() {
        return false;
    }
    var i: usize = 0;
    while i < left.len() {
        if left[i] != right[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

fn count(text: str, needle: u8) i32 {
    var seen: i32 = 0;
    var i: usize = 0;
    while i < text.len() {
        if text[i] == needle {
            seen += 1;
        }
        i += 1;
    }
    return seen;
}

fn main() {
    var escaped = "C:\\Users\\name.txt";
    var raw = `C:\Users\name.txt`;
    assert(escaped.len() == 17);
    assert(equal(escaped, raw));
    assert(count(raw, '\\') == 2);

    var json = `{"name": "Zeru"}`;
    assert(count(json, '"') == 4);
    assert(json[0] == '{');

    var pattern = `\d+\.\d+`;
    assert(pattern.len() == 8);
    assert(pattern[0] == '\\');
    assert(pattern[1] == 'd');

    var lines = `first
second`;
    assert(count(lines, '\n') == 1);
    assert(lines.len() == 12);

    var tabbed = "a\tb";
    assert(tabbed.len() == 3);
    assert(tabbed[1] == '\t');

    println("{}", raw);
    println("{}", json);
    println("raw strings: all tests passed");
}
