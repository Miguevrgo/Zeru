// A small linear algebra toolkit: one generic Matrix<T> for integers and
// floats, products and powers for both, then Gaussian elimination in f64 for
// a determinant, a linear solve and an inverse.

import std.math;

struct Matrix<T: Num> {
    rows: usize,
    cols: usize,
    data: Vec<T>,

    fn zero(rows: usize, cols: usize) Matrix<T> {
        var data: Vec<T> = Vec.with_capacity(rows * cols);
        for i in 0..rows * cols {
            data.push(0);
        }
        return Matrix { rows: rows, cols: cols, data: data };
    }

    fn identity(n: usize) Matrix<T> {
        var m: Matrix<T> = Matrix.zero(n, n);
        for i in 0..n {
            m.set(i, i, 1);
        }
        return m;
    }

    fn at(self, r: usize, c: usize) T {
        return self.data[r * self.cols + c];
    }

    fn set(var self, r: usize, c: usize, value: T) {
        self.data[r * self.cols + c] = value;
    }

    fn mul(self, other: &Matrix<T>) Matrix<T> {
        var out: Matrix<T> = Matrix.zero(self.rows, other.cols);
        for r in 0..self.rows {
            for c in 0..other.cols {
                var sum: T = 0;
                for k in 0..self.cols {
                    sum += self.at(r, k) * other.at(k, c);
                }
                out.set(r, c, sum);
            }
        }
        return out;
    }

    fn transpose(self) Matrix<T> {
        var out: Matrix<T> = Matrix.zero(self.cols, self.rows);
        for r in 0..self.rows {
            for c in 0..self.cols {
                out.set(c, r, self.at(r, c));
            }
        }
        return out;
    }

    // self^exp by repeated squaring; self is square.
    fn pow(self, exp: u32) Matrix<T> {
        var result: Matrix<T> = Matrix.identity(self.rows);
        var base = self.copy();
        var e = exp;
        while e > 0 {
            if e % 2 == 1 {
                result = result.mul(&base);
            }
            if e > 1 {
                base = base.mul(&base);
            }
            e /= 2;
        }
        return result;
    }

    fn trace(self) T {
        var sum: T = 0;
        for i in 0..self.rows {
            sum += self.at(i, i);
        }
        return sum;
    }

    fn show(self) {
        for r in 0..self.rows {
            print("  [");
            for c in 0..self.cols {
                if c > 0 {
                    print(", ");
                }
                print("{}", self.at(r, c));
            }
            println("]");
        }
    }
}

fn from_rows<T: Num>(rows: usize, cols: usize, values: Vec<T>) Matrix<T> {
    return Matrix { rows: rows, cols: cols, data: values };
}

// Row-reduce [a | b] with partial pivoting. Returns the determinant of `a`
// and leaves `b` holding the solution of a x = b, for every column of b.
fn eliminate(a: &var Matrix<f64>, b: &var Matrix<f64>) f64 {
    var n = a.rows;
    var det: f64 = 1;
    for col in 0..n {
        var pivot = col;
        for r in col + 1..n {
            if math::abs(a.at(r, col)) > math::abs(a.at(pivot, col)) {
                pivot = r;
            }
        }
        if math::abs(a.at(pivot, col)) < 1e-12 {
            return 0;
        }
        if pivot != col {
            det = -det;
            for c in 0..n {
                swap(a, pivot, col, c);
            }
            for c in 0..b.cols {
                swap(b, pivot, col, c);
            }
        }
        var p = a.at(col, col);
        det *= p;
        for r in 0..n {
            if r == col {
                continue;
            }
            var f = a.at(r, col) / p;
            for c in 0..n {
                a.set(r, c, a.at(r, c) - f * a.at(col, c));
            }
            for c in 0..b.cols {
                b.set(r, c, b.at(r, c) - f * b.at(col, c));
            }
        }
    }
    for r in 0..n {
        var p = a.at(r, r);
        for c in 0..b.cols {
            b.set(r, c, b.at(r, c) / p);
        }
    }
    return det;
}

fn swap(m: &var Matrix<f64>, r1: usize, r2: usize, c: usize) {
    var t = m.at(r1, c);
    m.set(r1, c, m.at(r2, c));
    m.set(r2, c, t);
}

fn close(a: f64, b: f64) bool {
    return math::abs(a - b) < 1e-9;
}

fn main() {
    var fib: Matrix<i64> = from_rows(2, 2, [1, 1, 1, 0]);
    var f90 = fib.pow(90);
    println("fib(90) = {}", f90.at(0, 1));

    var m: Matrix<i64> = from_rows(2, 3, [1, 2, 3, 4, 5, 6]);
    var mt = m.transpose();
    var gram = m.mul(&mt);
    println("m * m^T, trace {}:", gram.trace());
    gram.show();

    var a: Matrix<f64> = from_rows(3, 3, [2.0, 1.0, -1.0, -3.0, -1.0, 2.0, -2.0, 1.0, 2.0]);
    var b: Matrix<f64> = from_rows(3, 1, [8.0, -11.0, -3.0]);
    var work = a.copy();
    var det = eliminate(&var work, &var b);
    println("det = {}, x = ({}, {}, {})", det, b.at(0, 0), b.at(1, 0), b.at(2, 0));

    var inv: Matrix<f64> = Matrix.identity(3);
    work = a.copy();
    eliminate(&var work, &var inv);
    println("inverse:");
    inv.show();
    var check = a.mul(&inv);
    var max_err: f64 = 0;
    var eye: Matrix<f64> = Matrix.identity(3);
    for i in 0..9 {
        max_err = math::max(max_err, math::abs(check.data[i] - eye.data[i]));
    }
    println("max |a * inv - I| = {}", max_err);

    var h: Matrix<f64> = from_rows(2, 2, [0.5, 0.25, 0.25, 0.5]);
    var h8 = h.pow(8);
    println("h^8 trace {}", h8.trace());

    var ok = f90.at(0, 1) == 2880067194370816120 && gram.at(0, 1) == 32 && gram.trace() == 91
        && close(det, -1.0)
        && close(b.at(0, 0), 2.0)
        && close(b.at(1, 0), 3.0)
        && close(b.at(2, 0), -1.0)
        && close(inv.at(0, 0), 4.0)
        && max_err < 1e-12
        && close(
            h8.trace(),
            0.75 * 0.75 * 0.75 * 0.75 * 0.75 * 0.75 * 0.75 * 0.75
                + 0.25 * 0.25 * 0.25 * 0.25 * 0.25 * 0.25 * 0.25 * 0.25,
        );
    assert(ok);
    exit(0);
}
