// What a name still holds after it has been handed somewhere else: plain data
// copies, what owns memory moves, a pointer only looks, and `copy` keeps both.

struct Point {
    x: i32,
    y: i32,
}

struct Holder {
    cells: Vec<i32>,
}

fn consume(p: Point) i32 {
    return p.x;
}

fn peek(p: *Point) i32 {
    return p.x;
}

fn take_vec(list: Vec<i64>) usize {
    return list.len();
}

fn main() {
    var n: i32 = 42;
    var first: i32 = n;
    assert(first == 42 && n == 42);

    var point = Point { x: 10, y: 20 };
    var copied = point;
    copied.x = 11;
    assert(consume(point) == 10 && consume(point) == 10 && copied.x == 11);

    var cells: Array<i32, 3> = [4, 5, 6];
    var twin = cells;
    twin[0] = 0;
    assert(cells[0] == 4);

    var kept = Point { x: 7, y: 8 };
    assert(peek(&kept) == 7 && kept.y == 8);

    var list: Vec<i64> = Vec[1, 2];
    assert(take_vec(list.copy()) == 2);
    assert(list.len() == 2);

    var holder = Holder { cells: Vec[7, 8, 9] };
    var carried = holder;
    assert(carried.cells[2] == 9);
    holder = Holder { cells: Vec[1] };
    assert(holder.cells[0] == 1);

    var once: Vec<i64> = Vec[3];
    var taken: usize = 0;
    while true {
        taken = take_vec(once);
        break;
    }
    assert(taken == 1);

    println("move semantics: all tests passed");
}
