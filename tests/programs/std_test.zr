// The standard library put to work rather than merely compiled: every
// collection is built, filled, read and emptied through its own interface.

import std.math;
import std.collections.hashmap::{HashMap};
import std.collections.hashset::{HashSet};
import std.collections.binary_heap::{BinaryHeap};
import std.collections.vecdeque::{VecDeque};

enum Tone {
    Low,
    High,
}

fn main() {
    assert(math::abs(-4) == 4);
    assert(math::min(3, 5) == 3);
    assert(math::max(3, 5) == 5);
    assert(math::clamp(9, 0, 5) == 5);
    assert(math::clamp(-1, 0, 5) == 0);
    assert(math::pow(2, 10) == 1024);
    assert(math::is_power_of_two(64));
    assert(!math::is_power_of_two(63));
    assert(math::div_euclid(-7, 2) == -4);
    assert(math::mod_euclid(-7, 2) == 1);
    var top: u64 = 18446744073709551615;
    assert(math::min(top, 1) == 1);
    assert(math::max(top, 1) == top);

    var map: HashMap<i64, i64> = HashMap.new();
    assert(map.is_empty());
    map.insert(1, 100);
    map.insert(2, 200);
    assert(map.len() == 2);
    assert(*map.get(1).unwrap() == 100);
    assert(map.get(9).is_none());
    assert(map.contains(2));

    map.insert(1, 111);
    assert(*map.get(1).unwrap() == 111);
    assert(map.len() == 2);

    assert(map.remove(1).unwrap() == 111);
    assert(map.get(1).is_none());
    assert(map.remove(1).is_none());
    map.clear();
    assert(map.is_empty());

    var key: i64 = -2500;
    while key < 2500 {
        map.insert(key, key * 3);
        key += 1;
    }
    assert(map.len() == 5000);
    assert(*map.get(1234).unwrap() == 3702 && *map.get(-7).unwrap() == -21);

    key = -2500;
    while key < 2500 {
        map.remove(key);
        key += 2;
    }
    assert(map.len() == 2500 && !map.contains(0) && *map.get(1).unwrap() == 3);
    map.insert(1, 4);
    assert(map.len() == 2500);

    var lists: HashMap<Tone, Vec<i64>> = HashMap.new();
    lists.insert(Tone::Low, Vec[1, 2]);
    lists.insert(Tone::High, Vec[3]);
    lists.insert(Tone::Low, Vec[4, 5, 6]);
    assert(lists.len() == 2 && lists.contains(Tone::High));
    assert(lists.get(Tone::Low).unwrap().len() == 3);

    var seen: HashSet<i64> = HashSet.new();
    assert(seen.insert(5));
    seen.insert(5);
    assert(seen.len() == 1);
    assert(seen.contains(5));
    assert(!seen.contains(6));
    assert(seen.remove(5));
    assert(seen.is_empty());

    var heap: BinaryHeap<i64> = BinaryHeap.new();
    assert(heap.peek().is_none());
    heap.push(3);
    heap.push(9);
    heap.push(1);
    heap.push(7);
    assert(heap.len() == 4);
    assert(*heap.peek().unwrap() == 9);
    assert(heap.pop().unwrap() == 9);
    assert(heap.pop().unwrap() == 7);
    assert(heap.pop().unwrap() == 3);
    assert(heap.pop().unwrap() == 1);
    assert(heap.pop().is_none());

    var queue: VecDeque<i64> = VecDeque.new();
    queue.push_back(2);
    queue.push_back(3);
    queue.push_front(1);
    assert(queue.len() == 3);
    assert(*queue.front().unwrap() == 1);
    assert(*queue.back().unwrap() == 3);
    assert(*queue.at(1).unwrap() == 2);
    assert(queue.pop_front().unwrap() == 1);
    assert(queue.pop_back().unwrap() == 3);
    assert(queue.len() == 1);
    queue.clear();
    assert(queue.pop_front().is_none());

    println("std: all tests passed");
}
