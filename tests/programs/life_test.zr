// Conway's game of life on a small torus.

const W: usize = 8;
const H: usize = 6;

struct Grid {
    cells: Array<bool, 48>,

    fn at(self, x: usize, y: usize) bool {
        return self.cells[(y % H) * W + x % W];
    }

    fn neighbours(self, x: usize, y: usize) u8 {
        var count: u8 = 0;
        for dy in 0..3 as usize {
            for dx in 0..3 as usize {
                if dx == 1 && dy == 1 {
                    continue;
                }
                if self.at(x + W + dx - 1, y + H + dy - 1) {
                    count += 1;
                }
            }
        }
        return count;
    }

    fn step(self) Grid {
        var next = Grid { cells: [false; 48] };
        for y in 0..H {
            for x in 0..W {
                var n = self.neighbours(x, y);
                next.cells[y * W + x] = n == 3 || (n == 2 && self.at(x, y));
            }
        }
        return next;
    }

    fn print(self) {
        for y in 0..H {
            for x in 0..W {
                print("{}", match self.at(x, y) {
                    true => "#",
                    false => ".",
                });
            }
            println("");
        }
    }

    fn alive(self) usize {
        var total: usize = 0;
        for cell in self.cells {
            if cell {
                total += 1;
            }
        }
        return total;
    }
}

fn main() {
    var grid = Grid { cells: [false; 48] };
    grid.cells[1 * W + 2] = true;
    grid.cells[2 * W + 3] = true;
    grid.cells[3 * W + 1] = true;
    grid.cells[3 * W + 2] = true;
    grid.cells[3 * W + 3] = true;
    for _ in 0..4 {
        grid = grid.step();
    }
    grid.print();
    if grid.alive() != 5 {
        exit(1);
    }
    exit(0);
}
