// Language behaviour test. Every check exits with its own code, so a failure
// says exactly which one broke. Run by tests/ui.rs in all safety modes.

enum Color {
    Red,
    Green,
    Blue,
}

struct Point {
    x: i32,
    y: i32,

    fn sum(self) i32 {
        return self.x + self.y;
    }
    fn shift(var self, by: i32) {
        self.x = self.x + by;
    }
}

struct Wrapper {
    data: Array<i32, 3>,
    n: i32,
}

struct Bag {
    items: Vec<i64>,

    fn add(var self, v: i64) {
        self.items.push(v);
    }
    fn count(self) usize {
        return self.items.len();
    }
}

struct Chain {
    v: i32,
    fn point(self) Point {
        return Point { x: self.v, y: self.v };
    }
}

fn twice<T>(x: T) T {
    return x + x;
}

fn pick<T>(a: T, b: T) T {
    return a;
}

fn fib(n: i32) i32 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn divide(a: i32, b: i32) i32! {
    if b == 0 {
        return Err(1);
    }
    return a / b;
}

fn bump(p: *i32) bool {
    *p = *p + 1;
    return true;
}

fn sum3(a: Array<i32, 3>) i32 {
    return a[0] + a[1] + a[2];
}

fn read_through(p: *Point) i32 {
    return p.x;
}

fn shift_through(p: *Point) {
    p.shift(5);
}

enum Figure {
    Circle(f64),
    Rect(f64, f64),
    Empty,
}

const LOW: i32 = 10;
const HIGH: i32 = LOW + 1;

fn area(figure: Figure) f64 {
    return match figure {
        Figure::Circle(r) => 3.0 * r * r,
        Figure::Rect(w, h) => w * h,
        Figure::Empty => 0.0,
    };
}

fn band(n: i32) i32 {
    return match n {
        LOW => 1,
        HIGH => 2,
        default => 0,
    };
}

fn main() {
    var umax: u32 = 4294967295;
    var one: u32 = 1;
    assert(umax - one == 4294967294);
    assert(umax / 2 == 2147483647);
    assert(umax >= one);

    var neg: i32 = -5;
    assert(neg / 2 == -2);
    assert(neg % 2 == -1);
    assert(neg <= 1);

    var wide: i32 = -8;
    assert(wide >> 1 == -4);
    var uwide: u32 = 4294967288;
    assert(uwide >> 1 == 2147483644);

    var big: u64 = 18446744073709551615;
    assert(big != 0);
    assert(big / 2 == 9223372036854775807);

    var small: i32 = -1;
    assert(small as i64 == -1);
    var upos: u32 = 7;
    assert(upos as u64 == 7);
    var yes: bool = true;
    assert(yes as i32 == 1);
    var over: i32 = 300;
    assert(over as u8 == 44);
    var frac: f64 = -2.7;
    assert(frac as i32 == -2);
    var whole: i32 = 7;
    assert(whole as f64 as i32 == 7);

    var p = Point { x: 1, y: 2 };
    assert(p.sum() == 3);
    p.shift(10);
    assert(p.x == 11);
    assert(p.sum() == 13);
    var copy = p;
    assert(copy.x == 11);

    var chain = Chain { v: 5 };
    assert(chain.point().sum() == 10);

    var w = Wrapper { data: [1, 2, 3], n: 3 };
    assert(w.data[1] == 2);
    w.data[1] = 20;
    assert(w.data[1] == 20);
    assert(w.n == 3);

    var pts: Array<Point, 2> = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    assert(pts[1].x == 3);
    pts[0].y = 9;
    assert(pts[0].y == 9);

    var plain: Array<i32, 3> = [4, 5, 6];
    assert(sum3(plain) == 15);

    var through = Point { x: 4, y: 0 };
    assert(read_through(&through) == 4);
    shift_through(&through);
    assert(through.x == 9);

    var shadowed: i32 = 1;
    {
        var shadowed: i32 = 2;
        assert(shadowed == 2);
    }
    assert(shadowed == 1);

    var reused: i32 = 1;
    var reused: i32 = reused + 1;
    assert(reused == 2);
    var flag: i32 = 5;
    var flag: bool = flag > 0;
    assert(flag);

    var bits: u32 = 12;
    assert((bits & 4 == 4));

    assert(sum3([1, 2, 3]) == 6);
    assert((Point { x: 3, y: 4 }).sum() == 7);

    var target: i32 = 41;
    var ptr: *i32 = &target;
    *ptr = *ptr + 1;
    assert(target == 42);

    var cells: Array<i32, 3> = [1, 2, 3];
    var cell: *i32 = &cells[1];
    *cell = 99;
    assert(cells[1] == 99);
    assert(cells[0] == 1);
    assert(cells[2] == 3);

    var head: *i32 = &cells[0];
    assert(*(head + 2) == 3);
    *(head + 1) = 7;
    assert(cells[1] == 7);
    assert(cells[0] == 1);

    var octets: Array<u8, 4> = [1, 2, 3, 4];
    var byte: *u8 = &octets[0];
    assert(*(byte + 3) == 4);
    assert(*(byte + 3 - 2) == 2);

    var i: i32 = 0;
    var sum: i32 = 0;
    while i < 10 {
        i += 1;
        if i == 3 {
            continue;
        }
        if i == 8 {
            break;
        }
        sum += i;
    }
    assert(sum == 25);

    var rows: Array<i32, 3> = [1, 2, 3];
    var cols: Array<i32, 2> = [10, 20];
    var grid: i32 = 0;
    for r in rows {
        for c in cols {
            grid += r * c;
        }
    }
    assert(grid == 180);

    assert(fib(10) == 55);

    var calls: i32 = 0;
    var counter: *i32 = &calls;
    var no: bool = false;
    assert(!(no && bump(counter)));
    assert(calls == 0);
    if yes || bump(counter) {}
    assert(calls == 0);
    if yes && bump(counter) {}
    assert(calls == 1);

    assert(twice(3) == 6);
    var wide64: i64 = 10;
    assert(twice(wide64) == 20);

    var first = Point { x: 1, y: 1 };
    var second = Point { x: 2, y: 2 };
    assert(pick(first, second).sum() == 2);

    var color: Color = Color::Green;
    assert(color == Color::Green);
    var named = match color {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
    };
    assert(named == 2);
    var fallback = match color {
        Color::Red => 1,
        default => 9,
    };
    assert(fallback == 9);

    var flag = true;
    var flag_value = match flag {
        true => 1,
        false => 0,
    };
    assert(flag_value == 1);
    var byte: u8 = 200;
    var byte_class = match byte {
        200 => 1,
        default => 0,
    };
    assert(byte_class == 1);

    var ok: i32! = divide(10, 2);
    assert(ok.is_ok());
    assert(ok.unwrap() == 5);
    var bad: i32! = divide(10, 0);
    assert(bad.is_err());
    assert(bad.unwrap_err() == 1);

    var some: i32? = 5;
    var none: i32? = None;
    assert(some.is_some());
    assert(some.is_some());
    assert(some.unwrap() == 5);
    assert(none.is_none());
    assert(none.is_none());

    var list: Vec<i64> = Vec.new();
    var n: i64 = 0;
    while n < 20 {
        list.push(n);
        n += 1;
    }
    assert(list.len() == 20);

    var got = list.get(3);
    assert(got.is_some());
    assert(*got.unwrap() == 3);
    assert(list.get(99).is_none());

    var dropped = list.pop();
    assert(dropped.unwrap() == 19);
    assert(list.len() == 19);
    list.clear();
    assert(list.is_empty());

    var bag = Bag { items: Vec.new() };
    bag.add(4);
    bag.items.push(5);
    assert(bag.count() == 2);
    assert(*bag.items.get(1).unwrap() == 5);

    var bags: Array<Vec<i64>, 2> = [Vec.new(), Vec.new()];
    bags[0].push(1);
    assert(bags[0].len() == 1);
    assert(bags[1].len() == 0);

    var bytes = "a\0b\x41";
    assert(bytes.len() == 4 && bytes[1] == 0 && bytes[3] == 'A');
    assert('z' == 122 && '\n' == 10 && '\'' == 39);
    assert(1_000_000 == 1000000 && 0xFF_FF == 65535);
    var thousand = 1.5e3;
    var hundredth: f64 = 1e-2;
    assert(thousand == 1500.0 && hundredth == 0.01);
    var whole: f64 = 3;
    assert(whole / 2 == 1.5);
    var low: u8 = 0x0F;
    assert(!low == 0xF0);

    var counted = 0;
    for i in 0..5 {
        counted += i;
    }
    for i in 5..2 {
        assert(false, "an empty range ran");
    }
    var backwards = 0;
    for i in -3..0 {
        backwards += i;
    }
    assert(counted == 10 && backwards == -6);
    var scaled: Vec<i64> = Vec[1, 2, 3];
    for x in &var scaled {
        x *= 10;
    }
    assert(scaled[0] == 10 && scaled[2] == 30);
    var wrapped: u32 = 4294967295;
    wrapped +%= 2;
    var byte: u8 = 200;
    assert(wrapped == 1 && byte *% 2 == 144 && 0 -% byte == 56);

    var maybe: i64? = 5;
    var seen: i64 = 0;
    match maybe {
        Some(v) => {
            seen += v;
        }
        None => {
            assert(false, "a Some matched None");
        }
    }
    var failed: i32! = Err(4);
    var code = match failed {
        Ok(v) => v,
        Err(e) => e * 10,
    };
    assert(seen == 5 && code == 40);
    assert(area(Figure::Circle(2.0)) == 12.0 && area(Figure::Rect(2.0, 3.0)) == 6.0);
    assert(area(Figure::Empty) == 0.0 && band(10) == 1 && band(11) == 2 && band(3) == 0);

    println("lang: all tests passed");
}
