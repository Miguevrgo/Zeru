import std.collections.vecdeque::{VecDeque};
fn main() {
    var d = VecDeque.new();
    d.push_back(1);
    d.push_back(2);
    d.push_front(0);
    println("{} {} {} {}", d.len(), d.front().unwrap(), d.back().unwrap(), d.at(1).unwrap());
    println("{} {} {}", d.pop_front().unwrap(), d.pop_back().unwrap(), d.len());
}
