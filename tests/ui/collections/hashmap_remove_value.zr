import std.collections.hashmap::{HashMap};
import std.collections.hashset::{HashSet};

struct D {
    id: i32,
    fn drop(var self) {
        println("drop {}", self.id);
    }
}

fn main() {
    var ages: HashMap<i32, i32> = HashMap.new();
    ages.insert(5, 40);
    println("{}", ages.remove(5));
    println("{}", ages.remove(5).is_none());
    var owners: HashMap<i32, D> = HashMap.new();
    for i in 0..4 {
        owners.insert(i, D { id: i });
    }
    match owners.remove(2) {
        Some(d) => println("got {}", d.id),
        None => {}
    }
    owners.remove(0);
    var names: HashMap<i32, String> = HashMap.new();
    names.insert(1, String.from("one"));
    var one = names.remove(1).unwrap();
    println("{} {}", one, names.len());
    var s: HashSet<i32> = HashSet.new();
    s.insert(3);
    println("{} {}", s.remove(3), s.remove(3));
    println("end");
}
