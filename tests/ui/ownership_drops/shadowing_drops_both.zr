struct Probe {
    id: i64,
    log: *i64,
    fn drop(var self) {
        *self.log = *self.log * 10 + self.id;
    }
}
fn probe(id: i64, log: *i64) Probe {
    return Probe { id: id, log: log };
}
fn main() {
    var log: i64 = 0;
    const at: *i64 = &log;
    {
        const p = probe(1, at);
        const p = probe(2, at);
        println("shadowed");
    }
    println("dropped: {}", log);
}
