struct Probe {
    id: i64,
    log: *i64,

    fn drop(var self) {
        *self.log = *self.log * 10 + self.id;
    }
}
fn probe(id: i64, log: *i64) Probe {
    return Probe { id: id, log: log };
}
fn passed_through(at: *i64) Probe {
    const p = probe(5, at);
    return p;
}
fn main() {
    var log: i64 = 0;
    const at: *i64 = &log;
    {
        const p = passed_through(at);
        println("got {}", p.id);
    }
    println("dropped: {}", log);
}
