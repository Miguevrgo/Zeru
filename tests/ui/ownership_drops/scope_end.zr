struct Probe {
    id: i64,
    log: *i64,
    fn drop(var self) { *self.log = *self.log * 10 + self.id; }
}
fn probe(id: i64, log: *i64) Probe { return Probe { id: id, log: log }; }
fn main() {
    var log: i64 = 0;
    var at: *i64 = &log;
    {
        { var a = probe(1, at); var b = probe(2, at); }
        println("after block");
    }
    println("dropped: {}", log);
}
