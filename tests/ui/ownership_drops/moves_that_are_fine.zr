fn eat(v: Vec<i32>) {}
fn main() {
    const v: Vec<i32> = Vec.new();
    while true {
        eat(v);
        break;
    }
    var w: Vec<i32> = Vec.new();
    var i = 0;
    while i < 3 {
        eat(w);
        w = Vec.new();
        i += 1;
    }
    const x: Vec<i32> = Vec.new();
    const c = false;
    if c {
        eat(x);
        return;
    }
    eat(x);
    const a: Vec<i64> = Vec.new();
    const n = 1;
    const picked = match n {
        1 => a,
        default => a,
    };
    println("fine");
}
