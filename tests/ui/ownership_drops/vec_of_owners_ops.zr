struct Probe {
    id: i64,
    log: *i64,
    fn drop(var self) { *self.log = *self.log * 10 + self.id; }
}
fn probe(id: i64, log: *i64) Probe { return Probe { id: id, log: log }; }
fn main() {
    var log: i64 = 0;
    var at: *i64 = &log;
    {
        var v: Vec<Probe> = Vec.new();
        v.push(probe(1, at));
        v.push(probe(2, at));
        v.push(probe(3, at));
        var last = v.pop().unwrap();
        var mid = v.remove(1);
        v.insert(0, probe(4, at));
        println("len {}", v.len());
        v.clear();
        println("cleared");
    }
    println("dropped: {}", log);
}
