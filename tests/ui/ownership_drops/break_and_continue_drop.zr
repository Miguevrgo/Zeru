struct Probe {
    id: i64,
    log: *i64,
    fn drop(var self) {
        *self.log = *self.log * 10 + self.id;
    }
}
fn probe(id: i64, log: *i64) Probe {
    return Probe { id: id, log: log };
}
fn main() {
    var log: i64 = 0;
    var at: *i64 = &log;
    {
        var i: i64 = 0;
        while i < 3 {
            var p = probe(1 + i, at);
            i += 1;
            if i == 1 {
                continue;
            }
            if i == 2 {
                break;
            }
        }
        println("loop done");
    }
    println("dropped: {}", log);
}
