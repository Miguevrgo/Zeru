struct Probe {
    id: i64,
    log: *i64,
    fn drop(var self) {
        *self.log = *self.log * 10 + self.id;
    }
}
fn probe(id: i64, log: *i64) Probe {
    return Probe { id: id, log: log };
}
fn maybe(at: *i64) Probe? {
    return probe(9, at);
}
fn main() {
    var log: i64 = 0;
    var at: *i64 = &log;
    {
        while true {
            match maybe(at) {
                Some(p) => {
                    break;
                }
                None => {}
            }
        }
    }
    println("dropped: {}", log);
}
