struct Probe {
    id: i64,
    log: *i64,
    fn drop(var self) {
        *self.log = *self.log * 10 + self.id;
    }
}
fn probe(id: i64, log: *i64) Probe {
    return Probe { id: id, log: log };
}
fn main() {
    var log: i64 = 0;
    var at: *i64 = &log;
    {
        var o: Probe? = probe(1, at);
        match o {
            Some(p) => {
                println("some {}", p.id);
            }
            None => {}
        }
        println("after match");
    }
    println("dropped: {}", log);
}
