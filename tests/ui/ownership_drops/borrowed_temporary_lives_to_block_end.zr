struct Job {
    name: String,
    tags: Vec<String>,

    fn drop(var self) {
        println("drop {}", self.name);
    }
}
fn job(name: str) Job {
    return Job { name: String.from(name), tags: Vec[String.from("t")] };
}
fn make() Vec<i32> {
    return Vec[1, 2, 3];
}
fn main() {
    const r = &make();
    const w = &var make();
    w.push(4);
    const e = &make()[1];
    const j = &job("a");
    const t = &job("b").tags;
    for i in 0..2 {
        const k = &job("loop");
        println("{} {}", i, k.name);
    }
    if !r.is_empty() {
        const inner = &job("inner");
        println("{}", inner.name);
    }
    println("{} {} {} {} {}", r.len(), w.len(), *e, j.name, t.len());
}
