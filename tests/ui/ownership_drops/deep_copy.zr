struct Probe {
    id: i64,
    log: *i64,
    fn drop(var self) { *self.log = *self.log * 10 + self.id; }
}
fn probe(id: i64, log: *i64) Probe { return Probe { id: id, log: log }; }
fn main() {
    var log: i64 = 0;
    var at: *i64 = &log;
    {
        var p = probe(1, at);
        var twin = p.copy();
        twin.id = 2;
    }
    println("dropped: {}", log);
}
