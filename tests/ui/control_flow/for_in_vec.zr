fn main() {
    var v: Vec<i64> = Vec[5, 6, 7];
    for x in &var v {
        x += 1;
    }
    var s: i64 = 0;
    for x in v {
        s += x;
    }
    println("{}", s);
    const word = String.from("a");
    const inner: Vec<str> = Vec[word[..]];
    const list = &inner;
    var next: Vec<str> = Vec.new();
    for u in list {
        next.push(u);
    }
    println("{}", next[0]);
}
