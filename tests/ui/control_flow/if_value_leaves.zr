fn f(x: i32) i32 {
    var y = if x > 0 { x * 2 } else { return -1; };
    return y;
}

fn g(x: i32?) i32 {
    var v = if x.is_some() { x.unwrap() } else {
        println("none");
        return 0;
    };
    return v + 1;
}

fn main() {
    println("{} {} {} {}", f(3), f(-2), g(4), g(None));
    var total = 0;
    for i in 0..10 {
        var k = if i % 2 == 0 { continue; } else if i > 7 { break; } else { i };
        total += k;
    }
    println("{}", total);
    var s = if total > 0 { return; } else { 5 };
    println("{}", s);
}
