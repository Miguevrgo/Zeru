fn a(n: i32) i32 {
    if n > 0 {
        return 1;
    } else {
        return 2;
    }
}
fn b(n: i32) i32 {
    if n > 0 {
        return 1;
    }
    return 2;
}
fn c(n: i32) i32 {
    while n > 0 {
        return 1;
    }
    return 0;
}
fn d(n: i32?) i32 {
    match n {
        Some(v) => {
            return v;
        }
        None => {
            return 0;
        }
    }
}
fn main() {
    println("{} {} {} {}", a(1), b(0), c(1), d(None));
}
