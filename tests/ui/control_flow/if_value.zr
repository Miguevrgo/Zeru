fn sign(x: i32) i32 {
    return if x < 0 { -1 } else if x == 0 { 0 } else { 1 };
}

fn main() {
    const feel = if sign(-5) < 0 { "cold" } else { "warm" };
    const name = String.from("zeru");
    const shown: str? = if feel == "cold" { name } else { None };
    println("{} {} {} {}", sign(-5), sign(0), feel, shown.unwrap());
}
