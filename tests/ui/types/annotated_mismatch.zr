fn annotated_mismatch() {
    var x: i32 = true;
}

fn array_element_type() {
    var arr: Array<i32, 3> = [1.0, 2.0, 3.0];
}

fn array_length_mismatch() {
    var arr: Array<i32, 5> = [1, 2, 3];
}

fn f32_into_f64() {
    var a: f32 = 1.5;
    var b: f64 = a;
}

fn float_into_int() {
    var x: i32 = 3.14;
}

fn int_variable_into_float() {
    var i: i32 = 10;
    var x: f32 = i;
}

fn int_widths_do_not_mix() {
    var x: i32 = 10;
    var y: i64 = x;
}

fn str_is_not_pointer() {
    var s1: *u8 = "hello" as *u8;
    var s2: str = s1;
}

fn tuple_field_types() {
    var t: (i32, bool) = (true, 42);
}

fn main() {}
