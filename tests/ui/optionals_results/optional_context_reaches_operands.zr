fn doubled(a: i64) i64? {
    return a * 2;
}
fn takes(x: i64?) i64 {
    return x.unwrap();
}
fn main() {
    const a: i64 = 3;
    const b: i64 = 4;
    const sum: i64? = a + b;
    const neg: i64? = -a;
    var n: i32 = 7;
    const p: *i32 = &n;
    const read: i32? = *p;
    println(
        "{} {} {} {} {}",
        doubled(a).unwrap(),
        sum.unwrap(),
        neg.unwrap(),
        read.unwrap(),
        takes(a + 1),
    );
}
