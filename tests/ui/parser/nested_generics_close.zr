fn deep(v: Vec<Vec<Vec<i32>>>) usize {
    return v.len();
}

fn rows(v: Vec<Array<i32, 2>>, a: Array<Vec<i32>, 2>) usize {
    return v.len() + a[1].len();
}

fn maybe() Vec<i64>? {
    return Vec[1];
}

fn grid() Vec<Vec<i64>>! {
    return Vec[Vec[2]];
}

fn main() {
    var arrays: Vec<Array<i32, 2>> = Vec[[1, 2]];
    println("{} {}", deep(Vec[Vec[Vec[1]]]), rows(arrays, [Vec[1], Vec[2, 3]]));
    println("{} {}", maybe().unwrap()[0], grid().unwrap()[0][0]);
}
