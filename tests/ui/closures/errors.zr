struct Holder<T> {
    value: T,
}
fn apply(f: fn(i32) i32, x: i32) i32 {
    return f(x);
}
fn id<T>(x: T) T {
    return x;
}
fn keep(s: String) usize {
    return s.len();
}
fn stored(f: fn(i32)) fn(i32) {
    return f;
}
fn main() {
    const k = 1;
    var inc = fn(x: i32) i32 {
        return x + k;
    };
    var siguiente = fn() k + 1;
    var lista = Vec[inc];
    var caja = Holder { value: inc };
    println("{}", apply(fn(x, y) x, 1));
    println("{}", apply(fn(x: bool) x, 1));
    println("{}", apply(5, 1));
    println("{}", apply(id, 1));
    println("{}", inc(1, 2));
    var sin = fn(x) {
        return x;
    };
    var fabrica = fn() {
        return fn(x: i32) i32 {
            return x;
        };
    };
    var v: Vec<i32> = Vec[1];
    var mueve = fn() {
        var robado = v;
    };
    var nada = fn() {
        k += 1;
    };
    var words: Vec<String> = Vec[String.from("a")];
    var same = words.map(fn(w) w);
    var lens = words.map(keep);
    var grow = fn(var t: String) {
        t.push_str("x");
    };
    var lent = words.map(fn(w) {
        w.push_str("!");
        return 0;
    });
    var nothing = words.map(fn(w) {
        println("{}", w);
    });
    var pair = words.map(fn(a, b) a);
    var lens = words.filter(fn(w) w.len());
    var either = if words.len() > 0 { fn() {} } else { fn() {} };
    var again = fn(n: i32) i32 {
        return again(n - 1);
    };
    var plain = 3;
    plain(1);
    var maybe: fn()? = None;
}
