enum Packet { Int(i64), List(Vec<i64>) }
fn size(p: &Packet) i64 {
    match p {
        Packet::Int(n) => { return n; }
        Packet::List(items) => { return items.len() as i64; }
    }
}
fn main() {
    var ps: Vec<Packet> = Vec[Packet::Int(4), Packet::List(Vec[1, 2, 3])];
    for p in &ps { print("{} ", size(&p)); }
    println("{}", size(ps.get(1).unwrap()));
}
