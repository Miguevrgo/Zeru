const MAX: i32 = 10;
const A: i32 = 1;
const B: i32 = 2;
enum Shape { Circle(i64), Dot }
fn name(x: i32) str {
    return match x {
        MAX - 1 => "max-1",
        -MAX => "-max",
        1 << 3 => "eight",
        (A | B) => "three",
        A | B => "one or two",
        (4) => "four",
        default => "other",
    };
}
fn size(s: Shape) i64 {
    return match s { Shape::Circle(r) => r, Shape::Dot => 0 };
}
fn main() {
    println("{} {} {} {} {} {} {} {}", name(9), name(-10), name(8), name(3), name(2), name(4), name(5), size(Shape::Dot));
    var o: i32? = None;
    match o { Some(v) => { println("{}", v); }, None => { println("none"); } }
}
