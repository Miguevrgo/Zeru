fn pick(x: i32) i32 { return match x { default => 0, 1 => 1 }; }
fn pick2(x: i32) i32 { return match x { default => 0, 1..=3 => 1 }; }
fn pick3(x: i32) i32 { return match x { default => 0, y if y > 5 => 2, 1 => 1 }; }
const P: i32 = pick2(2);
fn main() { println("{} {} {} {} {}", P, pick(1), pick2(2), pick3(7), pick3(3)); }
