const LIMIT: i64 = 5;
enum E {
    A,
    B,
}
fn payload_pattern_names_a_value() {
    var o: i64? = 7;
    match o {
        Some(LIMIT) => {
            println("limit");
        }
        default => {
            println("other");
        }
    }
    var e: E? = E::B;
    match e {
        Some(E::A) => {
            println("A");
        }
        default => {
            println("other");
        }
    }
}

fn pattern_with_literal_payload() {
    var o: i32? = 1;
    var x = match o {
        Some(1) => 1,
        default => 0,
    };
}

fn main() {}
