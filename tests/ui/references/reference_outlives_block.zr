fn reference_outlives_block() {
    var v: Vec<i64> = Vec[1];
    var r = v.get(0);
    if v.len() > 0 {
        var w: Vec<i64> = Vec[7];
        r = w.get(0);
    }
    println("{}", r.is_some());
}

fn reference_outlives_nested_block() {
    var y: i32 = 5;
    var r: &i32 = &y;
    if true {
        {
            var x: i32 = 1;
            r = &x;
        }
        println("{}", *r);
    }
}

fn main() {}
