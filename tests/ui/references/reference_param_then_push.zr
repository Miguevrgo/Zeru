fn grow(v: &var Vec<i64>) {
    var e = &v[0];
    v.push(2);
    println("{}", *e);
}
fn reference_param_then_push() {
    var v: Vec<i64> = Vec[1];
    grow(&var v);
}

fn reference_through_var_reference() {
    var v: Vec<i64> = Vec[1];
    var m = &var v;
    var e = &m[0];
    m.push(1);
    println("{}", *e);
}

fn add(v: &var Vec<i64>) {
    v.push(1);
}
fn walk_and_grow(v: &var Vec<i64>) {
    for x in v {
        add(v);
        println("{}", x);
    }
}

fn main() {}
