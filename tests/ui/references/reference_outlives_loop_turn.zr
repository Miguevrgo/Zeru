fn reference_outlives_loop_turn() {
    var y: i32 = 5;
    var r: &i32 = &y;
    var i = 0;
    while i < 2 {
        if i == 1 {
            println("{}", *r);
        }
        {
            var x = 1;
            r = &x;
        }
        i += 1;
    }
}

fn reference_read_in_next_loop_turn() {
    var v: Vec<i64> = Vec[5];
    var r = v.get(0).unwrap();
    var i = 0;
    while i < 2 {
        if i == 1 {
            println("{}", *r);
        }
        var w: Vec<i64> = Vec[42];
        r = w.get(0).unwrap();
        i += 1;
    }
}

fn main() {}
