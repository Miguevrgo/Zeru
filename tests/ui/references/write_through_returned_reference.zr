enum State { Open, Frozen(i32) }
struct Account { state: State, log: Vec<i64> }
struct Bank {
    accounts: Vec<Account>,
    fn slot(var self, i: usize) &var Account { return &var self.accounts[i]; }
}
fn pick(v: &var Vec<Vec<i64>>) &var Vec<i64> { return &var v[0]; }
fn first(v: &var Vec<i64?>) &var i64? { return &var v[0]; }
fn find(v: &var Vec<Account>, frozen: bool) (&var Account)? {
    for a in v {
        match a.state { State::Frozen(_) => { if frozen { return &var a; } } State::Open => { if !frozen { return &var a; } } }
    }
    return None;
}
fn main() {
    var v: Vec<Vec<i64>> = [[1]];
    var s = pick(&var v);
    *s = [2, 3];
    s.push(4);
    var t = s;
    t.push(5);
    s.push(6);
    println("{}", v[0].len());

    var o: Vec<i64?> = [None];
    var x = first(&var o);
    *x = 5;
    println("{}", o[0].unwrap());

    var b = Bank { accounts: [Account { state: State::Open, log: Vec.new() }] };
    var acc = b.slot(0);
    acc.state = State::Frozen(1);
    acc.log.push(3);
    acc.log.push(4);
    println("{}", b.accounts[0].log.len());

    var a = find(&var b.accounts, true).unwrap();
    a.state = State::Open;
    match find(&var b.accounts, false) { Some(c) => { c.log.push(5); } None => { } }
    println("{}", b.accounts[0].log.len());
}
