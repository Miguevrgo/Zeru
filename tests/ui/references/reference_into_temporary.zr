fn mk() Vec<i64> {
    return Vec[1, 2, 3];
}
fn main() {
    var r = mk().get(0).unwrap();
    var other: Vec<i64> = Vec[77, 88, 99];
    println("{}", *r);
    println("{}", *mk().get(1).unwrap());
    match mk().get(2) {
        Some(x) => {
            var y = x;
            println("{}", *y);
        }
        None => {}
    }
}
