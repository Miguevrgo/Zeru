struct W {
    v: &var Vec<i64>,

    fn grow(self) {
        self.v.push(2);
    }
}
fn grow(w: W) {
    w.v.push(2);
}
fn grow_some(o: (&var Vec<i64>)?) {
    match o {
        Some(v) => {
            v.push(2);
        }
        None => {}
    }
}
fn add(v: &var Vec<i64>) {
    v.push(2);
}
fn grow_inside(v: &var Vec<i64>) bool {
    return v.any(fn(x) {
        v.push(2);
        return x == 1;
    });
}
fn pass_inside(v: &var Vec<i64>) bool {
    return v.any(fn(x) {
        add(v);
        return x == 1;
    });
}
fn main() {
    var a: Vec<i64> = Vec[1];
    var w = W { v: &var a };
    var e = &a[0];
    grow(w);
    println("{}", *e);

    var b: Vec<i64> = Vec[1];
    var o: (&var Vec<i64>)? = &var b;
    var f = &b[0];
    grow_some(o);
    println("{}", *f);

    var c: Vec<i64> = Vec[1];
    var x = W { v: &var c };
    var g = &c[0];
    x.grow();
    println("{}", *g);
}
