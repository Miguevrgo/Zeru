enum Tree { Leaf(i64), Node(Vec<Tree>) }
fn sum(t: Tree) i64 {
    var s: i64 = 0;
    match t {
        Tree::Leaf(v) => { s = v; }
        Tree::Node(kids) => { for k in kids { s += sum(k.copy()); } }
    }
    return s;
}
fn main() {
    var t = Tree::Node(Vec[Tree::Leaf(1), Tree::Node(Vec[Tree::Leaf(2), Tree::Leaf(3)])]);
    println("{}", sum(t));
}
