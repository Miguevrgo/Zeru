enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Empty,
}
fn area(s: Shape) f64 {
    return match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0.0,
    };
}
fn main() {
    println("{} {} {}", area(Shape::Circle(2.0)), area(Shape::Rect(2.0, 3.5)), area(Shape::Empty));
}
