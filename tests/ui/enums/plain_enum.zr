enum Status {
    Connected,
    Disconnected,
    Connecting,
}
fn name(s: Status) str {
    return match s {
        Status::Connected => "online",
        Status::Disconnected => "offline",
        Status::Connecting => "wait",
    };
}
fn main() {
    const s = Status::Connecting;
    println("{} {} {}", name(s), name(Status::Connected), s == Status::Connecting);
}
