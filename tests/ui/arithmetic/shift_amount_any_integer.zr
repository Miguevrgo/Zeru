const K: u64 = 1 << (40 as u8);

fn bits(n: u8) u64 {
    var x: u64 = 1;
    x <<= n;
    return x;
}

fn main() {
    const i: usize = 40;
    const one: u64 = 1;
    const bit: u64 = 1 << i;
    const n: u8 = 3;
    const small: u8 = 200;
    const a = one << n;
    const b = small >> n;
    const c: i32 = -64 >> (2 as u64);
    println("{} {} {} {} {} {} {}", bit, a, b, c, bits(63), K, 1 << 4);
}
