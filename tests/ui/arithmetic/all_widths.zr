fn main() {
    var a: i8 = 100;
    var b: i16 = 30000;
    var c: i32 = 2000000000;
    var d: i64 = 9000000000000000000;
    var e: u8 = 200;
    var f: u16 = 60000;
    var g: u32 = 4000000000;
    var h: u64 = 18000000000000000000;
    var i: usize = 7;
    var j: isize = -7;
    println(
        "{} {} {} {} {} {} {} {} {} {}",
        a + 27,
        b + 2767,
        c + 147483647,
        d + 223372036854775807,
        e + 55,
        f + 5535,
        g + 294967295,
        h + 446744073709551615,
        i * 3,
        j * 3,
    );
}
