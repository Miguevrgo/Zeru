fn main() {
    const a: i8 = 100;
    const b: i16 = 30000;
    const c: i32 = 2000000000;
    const d: i64 = 9000000000000000000;
    const e: u8 = 200;
    const f: u16 = 60000;
    const g: u32 = 4000000000;
    const h: u64 = 18000000000000000000;
    const i: usize = 7;
    const j: isize = -7;
    println(
        "{} {} {} {} {} {} {} {} {} {}",
        a + 27,
        b + 2767,
        c + 147483647,
        d + 223372036854775807,
        e + 55,
        f + 5535,
        g + 294967295,
        h + 446744073709551615,
        i * 3,
        j * 3,
    );
}
