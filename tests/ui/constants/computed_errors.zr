fn heap() i32 {
    var v: Vec<i32> = Vec[1, 2];
    return v[0];
}
fn noisy() i32 {
    println("hi");
    return 1;
}
fn forever() i32 {
    var n = 0;
    while true {
        n +%= 1;
    }
    return n;
}
fn deep(n: i32) i32 {
    return deep(n + 1);
}
fn overflow() i8 {
    var x: i8 = 100;
    return x + x;
}
fn outside() i32 {
    var a: Array<i32, 3> = [1, 2, 3];
    var i = 5;
    return a[i];
}
fn selfish() i32 {
    return LOOP + 1;
}
fn text() String {
    return String.new();
}
fn broken() i32 {
    return missing;
}
fn unfinished() i32 {
}
const PAIRS: Array<Array<i32, 2>, 2> = [[1, 2], [3, 4]];
fn past_table() i32 {
    var i = 2;
    return PAIRS[1][0] + PAIRS[i][0];
}
struct Noisy {
    n: i32,
    fn drop(var self) {
        println("drop {}", self.n);
    }
}
fn noisy_scope() i32 {
    const _n = Noisy { n: 1 };
    return 1;
}
fn pointer() i32 {
    var a: Array<i32, 2> = [1, 2];
    const p = (&a[0]) as *i32;
    return *(p + 1);
}
fn leave() i32 {
    exit(3);
    return 1;
}
fn parts() usize {
    return "a,b".split(",").len();
}
fn tail(x: &[i32]) &[i32] {
    return x[1..];
}
const A = heap();
const B = noisy();
const C = forever();
const D = deep(0);
const E = overflow();
const G = outside();
const LOOP = selfish();
const H = text();
const I = broken();
const J = unfinished();
const K = past_table();
const L: Noisy = Noisy { n: 1 };
const M = noisy_scope();
const P = pointer();
const Q = leave();
const R = parts();
const S = tail(&PAIRS[0]);
