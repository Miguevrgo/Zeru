fn main() {
    var v: Vec<i32> = Vec[1, 2, 3, 4];
    for x in &var v[1..3] {
        x *= 10;
    }
    for i, x in &var v[2..] {
        x += i as i32;
    }
    var c = 0;
    for x in v[..2] {
        c += x;
    }
    println("{} {}", v, c);
    var names: Vec<String> = Vec[String.from("a"), String.from("b")];
    for n in &var names[..] {
        n.push_str("!");
    }
    println("{}", names);
}
