fn main() {
    var v: Vec<i32> = Vec[5, 1, 9, 3];
    var top = v[1..];
    println("{} {} {} {}", top.sum(), top.min().unwrap(), top.max().unwrap(), top.contains(9));
    println("{} {}", v[..2].windows(2), v[1..].chunks(2));
    var a: Array<i32, 3> = [4, 6, 8];
    println("{} {}", a[..].sum(), a[1..].contains(4));
    println("{} {} {}", v.sum(), v.contains(1), v.windows(3));
    var e: Vec<i32> = Vec.new();
    println("{} {}", e[..].max(), e.sum());
    var words = "a b c".split();
    println("{}", words[1..].contains("c"));
}
