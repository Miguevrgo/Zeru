fn total(values: &[i32]) i32 {
    var sum = 0;
    for x in values {
        sum += x;
    }
    return sum;
}
fn largest<T: Ord>(values: &[T]) T {
    var best = values[0];
    for x in values {
        if x > best {
            best = x;
        }
    }
    return best;
}
fn first(values: &[i32]) &i32 {
    return &values[0];
}
fn main() {
    var list: Vec<i32> = Vec[1, 2, 3];
    const fixed: Array<i32, 2> = [10, 20];
    println("{} {} {}", total(&list), total(&fixed), total(list[1..]));
    const r = &list;
    println("{}", total(r));
    const m = &var list;
    println("{}", total(m));
    const s: &[i32] = &list;
    println("{}", s.len());
    println("{}", largest(&list));
    const f = first(&list);
    println("{}", *f);
    const text = String.from("abc");
    const view: str = &text;
    println("{}", view);
}
