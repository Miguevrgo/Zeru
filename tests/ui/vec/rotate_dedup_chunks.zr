struct N {
    id: i32,

    fn drop(var self) {
        println("drop {}", self.id);
    }
}

fn main() {
    var v: Vec<i32> = Vec[1, 2, 3, 4, 5];
    v.rotate_left(2);
    println("{}", v);
    v.rotate_right(7);
    println("{}", v);
    var empty: Vec<i32> = Vec.new();
    empty.rotate_left(3);
    empty.dedup();
    println("{} {}", empty, empty.chunks(2));
    var d: Vec<i32> = Vec[1, 1, 2, 2, 2, 1, 3, 3];
    d.dedup();
    println("{}", d);
    var words: Vec<String> = Vec.new();
    words.push(String.from("a"));
    words.push(String.from("a"));
    words.push(String.from("b"));
    words.dedup();
    println("{} {}", words, (String.from("k"), 1) == (String.from("k"), 1));
    var c: Vec<i32> = Vec[1, 2, 3, 4, 5, 6, 7];
    println("{}", c.chunks(3));
    var nodes: Vec<N> = Vec.new();
    nodes.push(N { id: 1 });
    nodes.push(N { id: 2 });
    nodes.push(N { id: 3 });
    nodes.rotate_left(1);
    println("{} {} {}", nodes[0].id, nodes[1].id, nodes[2].id);
}
