fn total(values: &[i64]) i64 {
    var sum: i64 = 0;
    for v in values {
        sum += v;
    }
    return sum;
}

fn main() {
    for line in "L23\nR4\nL105".lines() {
        var n = line[1..].parse_int().unwrap();
        println("{} {}", line[..1], n);
    }
    var word = String.from("zeru lang");
    println("[{}] [{}] [{}] [{}]", word[0..4], word[5..], word[..], word[9..]);
    var v: Vec<i64> = Vec[1, 2, 3, 4, 5];
    var mid = v[1..4];
    println("{} {} {}", mid.len(), mid[0], total(v[2..]));
    var a: Array<i32, 4> = [10, 20, 30, 40];
    var tail = a[2..];
    println("{} {}", tail.len(), tail[1]);
    var empty = v[5..];
    println("{}", empty.len());
    var i: usize = 2;
    println("{}", "abcdef"[i..i + 2]);
    var nested = "hello"[1..][1..3];
    println("{}", nested);
}
