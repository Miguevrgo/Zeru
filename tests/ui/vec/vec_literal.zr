fn main() {
    const v = Vec[1, 2, 3];
    const n: usize = v.len() + 1;
    const zeros: Vec<i64> = Vec[0; n];
    const word = String.from("ab");
    var words = Vec[word; 3];
    const empty: Vec<i32> = Vec[];
    words[0].push('c');
    println("{} {} {} {} {} {}", v, zeros, words, word, v.len(), empty.len());
}
