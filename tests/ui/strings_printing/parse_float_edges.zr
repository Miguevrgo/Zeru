fn show(text: str) {
    match text.parse_float() {
        Ok(v) => println("{} -> {}", text, v),
        Err(e) => println("{} -> error {}", text, e),
    }
}
fn main() {
    show("2.2250738585072014e-308");
    show("1.7976931348623157e308");
    show("1.7976931348623159e308");
    show("5e-324");
    show("2e-324");
    show("1e-9223372036854775808");
    show("12345678901234567890e9223372036854775807");
    show("-998135.4255457203");
    show("0.1");
    show("123456789012345678901234567890");
    show("9007199254740993");
    show("-0");
    show(".5");
    show("5.");
    show("x");
    show("1.000000000000000111022302462515654042363166809082031250001");
    show("1.00000000000000011102230246251565404236316680908203125");
    show("1.000000000000000111022302462515654042363166809082031249999");
    show("1e99999999999999999999");
    show("1e-99999999999999999999");
    show("0e99999999999999999999");
    show("1e+x");
    var ones = String.from("1");
    var tenth = String.from("0.");
    for _ in 0..1100 {
        ones.push('0');
        tenth.push('0');
    }
    ones.extend("e-1100");
    tenth.extend("1e1100");
    println("{} {}", ones.parse_float().unwrap(), tenth.parse_float().unwrap());
}
