fn noisy(n: i64) i64 {
    println("evaluating {}", n);
    return n * 10;
}
fn main() {
    println("first {} then {}", noisy(1), noisy(2));
    var s = "old";
    var t = s;
    println("{} {}", s, noisy(3));
    println("{}", t);
    later();
}
fn twice(x: i64) Vec<i64> {
    println("evaluating twice");
    return Vec[x, x];
}
fn later() {
    var o: i64? = 5;
    println("list {} then {} {}", twice(4), o, noisy(5));
}
