fn main() {
    println("[{:.2}] [{:.0}] [{:.1}] [{:.3}]", 3.14159, 2.5, 0.25, -1.0005);
    println("[{:>8}] [{:<6}] [{:^7}] [{:*^9}]", 42, "ab", "mid", true);
    println("[{:x}] [{:X}] [{:o}] [{:b}] [{:08b}]", 255, 255, 8, 5, 5);
    println("[{:05}] [{:+>6}] [{:08.3}] [{:>10.2}]", -42, 7, -3.14159, 1e10);
    var n: u64 = 18446744073709551615;
    var m: i8 = -128;
    println("[{:x}] [{:b}] [{}]", n, m, n);
    var x: f32 = 0.1;
    println("[{:>6}] [{:.10}] [{:5}]", x, x, 1.5);
    var name = String.from("zeru");
    println("[{:>6}] [{:<3}]", name, "toolong");
    println("[{:.2}] [{:.2}] [{:.1}] [{:.0}]", 0.125, 0.375, 0.05, 0.5);
    println("[{:.20}]", 0.1);
    println("[{:.3}]", 1.7976931348623157e308);
    println("[{:.3}] [{:.2}]", 5e-324, -0.0);
    println("[{:>5}] [{:^6}]", "ñu", "é");
    println("{{}} {:}", 3);
    var m: i8 = -128;
    var k: i32 = -1;
    println("[{:b}] [{:x}] [{:X}] [{:o}] [{}] [{:5}]", m, k, -255, 255, m, m);
}
