fn main() {
    const tiny: f64 = 1e-7;
    const third: f64 = 1.0 / 3.0;
    const pi: f64 = 3.14159265358979;
    const huge: f64 = 1e300;
    const neg_zero: f64 = -0.0;
    const sum: f64 = 0.1 + 0.2;
    const whole: f64 = 42.0;
    const small: f32 = 0.1;
    println("{} {} {} {}", tiny, third, pi, sum);
    println("{} {} {} {}", huge, neg_zero, whole, small);
}
