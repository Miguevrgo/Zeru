fn main() {
    const line = "name: Zeru";
    const colon = line.find(":").unwrap();
    println(
        "{}|{} {} {}",
        line[..colon],
        line[colon + 2..],
        line.contains("Ze"),
        line.find("zz").is_none(),
    );
    const owned = String.from("abcabc");
    println("{} {}", owned.find("ca").unwrap(), owned.contains(""));
}
