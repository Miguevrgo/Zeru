fn parse(s: str) i64! {
    return s.parse_int();
}

fn make() Vec<str> {
    return Vec["x\\", "y\t\r\0"];
}

fn main() {
    const v: Vec<i32> = Vec[1, 2, 3];
    const empty: Vec<i32> = Vec.new();
    const a: Array<f64, 2> = [1.5, 2.0];
    const nested: Vec<Vec<i32>> = Vec[Vec[1], Vec[2, 3]];
    const t = (1, "tw\"o\n", (3.5, true));
    const o: i32? = 5;
    const n: i32? = None;
    var names: Vec<String> = Vec.new();
    names.push(String.from("ann"));
    const opts: Vec<i32?> = Vec[1, None];
    println("{} {} {}", v, empty, a);
    println("{}", "84283   63343".split(" "));
    println("{} {} {}", nested, t, (7,));
    println("{} {} {} {}", o, n, parse("12"), parse("x"));
    println("{} {} {}", names, &v, opts);
    println("{} {}", v[1..], make());
}
