import std.collections.hashmap::{HashMap};
fn main() {
    var v: Vec<i32> = [4, 5];
    println("{} {}", v.get(1), v.get(9));
    var m: HashMap<i32, str> = HashMap.new();
    m.insert(1, "one");
    println("{}", m.get(1));
    var x = 3;
    var refs: Vec<&i32> = Vec.new();
    refs.push(&x);
    println("{} {}", refs, (&x, 1));
}
