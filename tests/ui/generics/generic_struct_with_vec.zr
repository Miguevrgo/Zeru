struct Stack<T> {
    items: Vec<T>,
    fn push(var self, x: T) {
        self.items.push(x);
    }
    fn pop(var self) T? {
        return self.items.pop();
    }
    fn size(self) usize {
        return self.items.len();
    }
}
fn main() {
    var s: Stack<i64> = Stack { items: Vec.new() };
    s.push(1);
    s.push(2);
    var top = s.pop().unwrap();
    println("{} {}", top, s.size());
}
