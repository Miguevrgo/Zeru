struct Stack<T> {
    items: Vec<T>,

    fn push(var self, x: T) {
        self.items.push(x);
    }
    fn pop(var self) T? {
        return self.items.pop();
    }
    fn size(self) usize {
        return self.items.len();
    }
    fn last(self) T {
        return self.items[self.items.len() - 1];
    }
}
fn main() {
    var s: Stack<i64> = Stack { items: Vec.new() };
    s.push(1);
    s.push(2);
    const top = s.pop().unwrap();
    println("{} {} {}", top, s.size(), s.last());
    var owners: Stack<Vec<i64>> = Stack { items: Vec.new() };
    owners.push(Vec[1, 2]);
    owners.push(Vec[3]);
    println("{}", owners.size());
}
