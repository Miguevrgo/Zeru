struct Box<T> {
    v: T,
    fn get(self) T { return self.v; }
    fn pair<U>(self, u: U) (T, U) { return (self.v, u); }
    fn set<U>(var self, u: U, t: T) U { self.v = t; return u; }
}
fn main() {
    var b: Box<i64> = Box { v: 7 };
    var p = b.pair(3.5);
    println("{} {}", p.0, p.1);
    println("{} {}", b.set(9, 8), b.get());
    var c: Box<bool> = Box { v: true };
    println("{}", c.pair(1).0);
}
