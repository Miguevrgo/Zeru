fn id<T>(x: T) T {
    return x;
}
fn pair<T>(a: T, b: T) T {
    return a + b;
}
fn either<T>(a: T, b: T) T {
    return a;
}
fn main() {
    var small: u8 = 1;
    var big: i64 = 5;
    println("{}", pair(id(300), small));
    println("{}", pair(id(-1), small));
    println("{}", pair(id(2.5), big));
    println("{}", pair(id(-3), big));
    println("{}", either(1, "x"));
}
