import std.os;
import std.fs;
import std.net;

fn sys(nr: i64, a: i64, b: i64, c: i64) {
    var _result: i64 = 0;
    asm volatile (
        "syscall"
        : "={rax}" (_result)
        : "{rax}" (nr), "{rdi}" (a), "{rsi}" (b), "{rdx}" (c)
        : "rcx", "r11", "memory"
    );
}

fn main() {
    println("{}", os::run("./no-such-file", Vec[]).unwrap_err());
    println("{}", os::output("/no/such/prog", Vec[]).unwrap_err());
    const open = fs::read_dir("/proc/self/fd").unwrap().len();
    var _ = os::output("/no/such/prog", Vec[]).unwrap_err();
    println("{}", fs::read_dir("/proc/self/fd").unwrap().len() - open);
    println("{}", os::run("sh", Vec["-c", "exit 127"]).unwrap());
    println("{}", os::output("echo", Vec["ok"]).unwrap().stdout.trim());
    for i in 0..2000 {
        os::run("./no-such-file", Vec[]).unwrap_err();
    }
    println("{}", os::run("true", Vec[]).unwrap());

    fs::create_dir("shadow").unwrap();
    fs::create_dir("shadow/true").unwrap();
    const path = os::env("PATH").unwrap();
    os::set_env("PATH", format("{}/shadow:{}", fs::current_dir().unwrap(), path)).unwrap();
    println("{} {}", os::run("true", Vec[]).unwrap(), os::run("", Vec[]).unwrap_err());
    os::set_env("PATH", path).unwrap();
    fs::remove_dir("shadow/true").unwrap();
    fs::remove_dir("shadow").unwrap();

    const _file = fs::File.open("/proc/self/status").unwrap();
    const listener = net::TcpListener.bind("127.0.0.1:0").unwrap();
    const _client = net::TcpStream.connect(listener.local_addr().unwrap()).unwrap();
    const _server = listener.accept().unwrap();
    const fds = os::output("ls", Vec["/proc/self/fd"]).unwrap().stdout;
    println("{}", fds.split().join(" "));

    sys(33, 1, 9, 0);
    sys(3, 1, 0, 0);
    sys(3, 2, 0, 0);
    const ran = os::run("true", Vec[]);
    const echoed = os::output("echo", Vec["closed"]);
    sys(33, 9, 1, 0);
    sys(33, 9, 2, 0);
    println("{} {}", ran.unwrap(), echoed.unwrap().stdout.trim());
    sys(3, 0, 0, 0);
    {
        const _dropped = fs::File.open("/proc/self/status").unwrap();
    }
    println("{}", os::stdin().read_line().unwrap_err());
}
