// Shortest paths on a small weighted grid: Dijkstra with a generic binary
// min-heap, BFS for the unweighted step count, and a path rebuilt backwards.

const W: usize = 8;
const H: usize = 6;
const WALL: u8 = '#';
const UNSEEN: i64 = 1000000;

// A min-heap of items ordered by an i64 priority.
struct MinHeap<T> {
    keys: Vec<i64>,
    items: Vec<T>,

    fn new() MinHeap<T> {
        return MinHeap { keys: Vec.new(), items: Vec.new() };
    }

    fn len(self) usize { return self.keys.len(); }

    fn swap(var self, a: usize, b: usize) {
        var k = self.keys[a];
        self.keys[a] = self.keys[b];
        self.keys[b] = k;
        var t = self.items[a];
        self.items[a] = self.items[b];
        self.items[b] = t;
    }

    fn push(var self, key: i64, item: T) {
        self.keys.push(key);
        self.items.push(item);
        var at = self.keys.len() - 1;
        while at > 0 {
            var up = (at - 1) / 2;
            if self.keys[up] <= self.keys[at] { break; }
            self.swap(at, up);
            at = up;
        }
    }

    // The item with the lowest key and that key.
    fn pop(var self) (i64, T)? {
        if self.keys.is_empty() { return None; }
        var last = self.keys.len() - 1;
        self.swap(0, last);
        var key = self.keys.pop().unwrap();
        var item = self.items.pop().unwrap();
        var at: usize = 0;
        while true {
            var low = at;
            var l = 2 * at + 1;
            var r = l + 1;
            if l < self.keys.len() && self.keys[l] < self.keys[low] { low = l; }
            if r < self.keys.len() && self.keys[r] < self.keys[low] { low = r; }
            if low == at { break; }
            self.swap(at, low);
            at = low;
        }
        return (key, item);
    }
}

struct Grid {
    cells: Vec<u8>,

    fn at(self, x: usize, y: usize) u8 { return self.cells[y * W + x]; }

    // What stepping onto a cell costs: its digit, or 1 for '.'.
    fn cost(self, cell: usize) i64 {
        var c = self.cells[cell];
        return match c {
            '.' | 'S' | 'E' => 1,
            default => (c - '0') as i64
        };
    }

    // The open cells next to `cell`, in a fixed order.
    fn neighbours(self, cell: usize) Vec<usize> {
        var out: Vec<usize> = Vec.new();
        var x = cell % W;
        var y = cell / W;
        if x > 0 && self.at(x - 1, y) != WALL { out.push(cell - 1); }
        if x + 1 < W && self.at(x + 1, y) != WALL { out.push(cell + 1); }
        if y > 0 && self.at(x, y - 1) != WALL { out.push(cell - W); }
        if y + 1 < H && self.at(x, y + 1) != WALL { out.push(cell + W); }
        return out;
    }
}

// print has no character format, so each cell byte maps to a one-letter str.
fn glyph(c: u8) str {
    return match c {
        '#' => "#", '*' => "*", 'S' => "S", 'E' => "E", '1' => "1", '9' => "9",
        default => "."
    };
}

fn parse(rows: Array<str, 6>) Grid {
    var cells: Vec<u8> = Vec.with_capacity(W * H);
    for row in rows {
        for i in 0..row.len() { cells.push(row[i]); }
    }
    return Grid { cells: cells };
}

fn find(grid: &Grid, want: u8) usize? {
    for i in 0..grid.cells.len() {
        if grid.cells[i] == want { return i; }
    }
    return None;
}

// Cheapest cost from `start` to every cell, and each cell's predecessor.
fn dijkstra(grid: &Grid, start: usize) (Vec<i64>, Vec<usize>) {
    var dist: Vec<i64> = Vec.new();
    var prev: Vec<usize> = Vec.new();
    for i in 0..W * H {
        dist.push(UNSEEN);
        prev.push(i);
    }
    var heap: MinHeap<usize> = MinHeap.new();
    dist[start] = 0;
    heap.push(0, start);
    while heap.len() > 0 {
        var top = heap.pop().unwrap();
        var cell = top.1;
        if top.0 > dist[cell] { continue; }
        for next in grid.neighbours(cell) {
            var through = top.0 + grid.cost(next);
            if through < dist[next] {
                dist[next] = through;
                prev[next] = cell;
                heap.push(through, next);
            }
        }
    }
    return (dist, prev);
}

// Fewest steps from `start` to `goal`, ignoring weights.
fn bfs(grid: &Grid, start: usize, goal: usize) i64? {
    var steps: Vec<i64> = Vec.new();
    for i in 0..W * H { steps.push(-1); }
    var queue: Vec<usize> = [start];
    var head: usize = 0;
    steps[start] = 0;
    while head < queue.len() {
        var cell = queue[head];
        head += 1;
        if cell == goal { return steps[cell]; }
        for next in grid.neighbours(cell) {
            if steps[next] < 0 {
                steps[next] = steps[cell] + 1;
                queue.push(next);
            }
        }
    }
    return None;
}

fn main() {
    var rows: Array<str, 6> = [
        "S..#....",
        ".#.#.##.",
        ".#9..#..",
        ".#.#.#.#",
        "...#1..E",
        "##.....#"
    ];
    var grid = parse(rows);
    var start = find(&grid, 'S').unwrap();
    var goal = find(&grid, 'E').unwrap();

    var result = dijkstra(&grid, start);
    var cost = result.0[goal];
    var steps = bfs(&grid, start, goal).unwrap();

    var path: Vec<usize> = [goal];
    var at = goal;
    while at != start {
        at = result.1[at];
        path.push(at);
    }

    var marked = grid.cells.copy();
    for cell in path {
        if marked[cell] == '.' { marked[cell] = '*'; }
    }
    for y in 0..H {
        for x in 0..W { print("{}", glyph(marked[y * W + x])); }
        println("");
    }
    println("cheapest cost {} over {} cells, fewest steps {}", cost, path.len(), steps);

    var heap: MinHeap<i64> = MinHeap.new();
    var values: Vec<i64> = [5, -2, 9, 0, 7, -2, 3];
    for v in values { heap.push(v, v * 10); }
    var sorted: Vec<i64> = Vec.new();
    while heap.len() > 0 { sorted.push(heap.pop().unwrap().1); }
    println("heap order: {} {} {} {} {} {} {}", sorted[0], sorted[1], sorted[2], sorted[3], sorted[4], sorted[5], sorted[6]);

    var ok = cost == 13 && steps == 11 && path.len() == 14 && sorted[0] == -20 && sorted[6] == 90;
    if !ok { exit(1); }
    exit(0);
}
