import std.net;

fn main() {
    var bind_r = net::TcpListener.bind(0, 0);
    if bind_r.is_err() { exit(1); }
    var listener = net::TcpListener { fd: bind_r.unwrap() };

    var sock_fd: i64 = syscall3(41, 2, 1, 0);
    if sock_fd < 0 { exit(2); }
    var stream = net::TcpStream { fd: sock_fd };

    stream.shutdown(net::SHUT_RDWR);
    stream.close();
    listener.close();

    var ip: u32 = net::ip4(127, 0, 0, 1);
    if ip != 2130706433 { exit(3); }

    var addr = net::make_addr(ip, 8080);
    if addr[0] != 2 { exit(4); }
    if addr[2] != 31 { exit(5); }
    if addr[3] != 144 { exit(6); }

    var udp_r = net::UdpSocket.bind(0, 0);
    if udp_r.is_err() { exit(7); }
    var udp = net::UdpSocket { fd: udp_r.unwrap() };
    udp.close();

    println("net: all tests passed");
}
