import std.fs;

fn main() {
    var path = "build/test_fs.txt";

    var wr = fs::write_file(path, "Hello from Zeru!");
    if wr.is_err() { exit(1); }
    if !fs::exists(path) { exit(2); }
    var sz = fs::file_size(path);
    if sz.is_err() { exit(3); }
    if sz.unwrap() != 16 { exit(4); }

    var rd = fs::read_file(path);
    if rd.is_err() { exit(5); }
    if rd.unwrap().len() != 16 { exit(6); }
    if rd.unwrap()[0] != 'H' { exit(7); }

    var path2 = "build/test_fs2.txt";
    var fd = fs::open(path2, fs::O_WRONLY | fs::O_CREAT | fs::O_TRUNC, fs::PERM_644);
    if fd.is_err() { exit(8); }
    var w2 = fs::write(fd.unwrap(), "test" as *u8, 4);
    if w2.is_err() { exit(9); }
    if fs::close(fd.unwrap()).is_err() { exit(10); }
    if fs::unlink(path).is_err() { exit(11); }
    if fs::unlink(path2).is_err() { exit(12); }
    if fs::exists(path) { exit(13); }

    println("fs: all tests passed");
}
