// The standard library put to work rather than merely compiled: every
// collection is built, filled, read and emptied through its own interface.

import std.math;
import std.collections.hashmap::{HashMap};
import std.collections.hashset::{HashSet};
import std.collections.binary_heap::{BinaryHeap};
import std.collections.vecdeque::{VecDeque};

fn main() {
    // --- math ----------------------------------------------------------------
    if math::abs(-4) != 4 { exit(1); }
    if math::min(3, 5) != 3 { exit(2); }
    if math::max(3, 5) != 5 { exit(3); }
    if math::clamp(9, 0, 5) != 5 { exit(4); }
    if math::clamp(-1, 0, 5) != 0 { exit(5); }
    if math::pow(2, 10) != 1024 { exit(6); }
    if !math::is_power_of_two(64) { exit(7); }
    if math::is_power_of_two(63) { exit(8); }
    // Euclidean division rounds towards minus infinity, so the remainder is
    // never negative, unlike `/` and `%`.
    if math::div_euclid(-7, 2) != -4 { exit(9); }
    if math::mod_euclid(-7, 2) != 1 { exit(10); }

    // --- HashMap -------------------------------------------------------------
    var map = HashMap.new();
    if !map.is_empty() { exit(20); }
    if !map.insert(1, 100) { exit(21); }
    if !map.insert(2, 200) { exit(22); }
    if map.size() != 2 { exit(23); }
    if map.get(1).unwrap() != 100 { exit(24); }
    if map.get(9).is_some() { exit(25); }
    if !map.contains(2) { exit(26); }

    // Inserting a key that is there again replaces the value.
    if !map.insert(1, 111) { exit(27); }
    if map.get(1).unwrap() != 111 { exit(28); }
    if map.size() != 2 { exit(29); }

    if !map.remove(1) { exit(30); }
    if map.get(1).is_some() { exit(31); }
    if map.remove(1) { exit(32); }
    map.clear();
    if !map.is_empty() { exit(33); }

    // Enough keys to make the open addressing collide and probe.
    var key: i64 = 0;
    while key < 100 {
        if !map.insert(key, key * 3) { exit(34); }
        key += 1;
    }
    if map.size() != 100 { exit(35); }
    if map.get(77).unwrap() != 231 { exit(36); }

    // --- HashSet -------------------------------------------------------------
    var seen = HashSet.new();
    if !seen.insert(5) { exit(40); }
    // The same element twice is not an error, and not a second element.
    seen.insert(5);
    if seen.size() != 1 { exit(41); }
    if !seen.contains(5) { exit(42); }
    if seen.contains(6) { exit(43); }
    if !seen.remove(5) { exit(44); }
    if !seen.is_empty() { exit(45); }

    // --- BinaryHeap ----------------------------------------------------------
    var heap = BinaryHeap.new();
    if heap.peek().is_some() { exit(50); }
    heap.push(3);
    heap.push(9);
    heap.push(1);
    heap.push(7);
    if heap.size() != 4 { exit(51); }
    // A max-heap hands back the largest first, whatever order they arrived in.
    if heap.peek().unwrap() != 9 { exit(52); }
    if heap.pop().unwrap() != 9 { exit(53); }
    if heap.pop().unwrap() != 7 { exit(54); }
    if heap.pop().unwrap() != 3 { exit(55); }
    if heap.pop().unwrap() != 1 { exit(56); }
    if heap.pop().is_some() { exit(57); }

    // --- VecDeque ------------------------------------------------------------
    var queue = VecDeque.new();
    queue.push_back(2);
    queue.push_back(3);
    queue.push_front(1);
    if queue.size() != 3 { exit(60); }
    if queue.front().unwrap() != 1 { exit(61); }
    if queue.back().unwrap() != 3 { exit(62); }
    if queue.at(1).unwrap() != 2 { exit(63); }
    if queue.pop_front().unwrap() != 1 { exit(64); }
    if queue.pop_back().unwrap() != 3 { exit(65); }
    if queue.size() != 1 { exit(66); }
    queue.clear();
    if queue.pop_front().is_some() { exit(67); }

    println("std: all tests passed");
    exit(0);
}
