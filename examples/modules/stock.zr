// What a module keeps to itself: an enum, a generic struct, a trait used as a
// bound, static calls on its own types, and names a parameter may shadow.

pub enum Level { Low, High }

pub struct Pile<T> {
    items: Vec<T>,

    pub fn first(self) T { return self.items[0]; }

    pub fn level(self) Level {
        if self.items.len() > 1 { return Level::High; }
        return Level::Low;
    }
}

pub trait Weighed { fn weight(self) i32; }

pub struct Crate {
    kg: i32,
    pub fn weight(self) i32 { return self.kg; }
}

pub struct Scale<T: Weighed> {
    item: T,
    pub fn read(self) i32 { return self.item.weight(); }
}

pub struct Counter {
    n: i32,
    pub fn start() Counter { return Counter { n: 1 }; }
}

pub fn pile_of(value: i64) Pile<i64> {
    var pile: Pile<i64> = Pile { items: Vec.new() };
    pile.items.push(value);
    return pile;
}

pub fn limit() i32 { return 100; }

// `limit` names both a function of this module and the parameter, and inside
// the body the parameter is the one meant.
pub fn capped(value: i32, limit: i32) i32 {
    if value > limit { return limit; }
    return value;
}

pub fn weigh(kg: i32) i32 {
    var scale = Scale { item: Crate { kg: kg } };
    return scale.read();
}

pub fn started() i32 { return Counter.start().n + Counter.start().n; }
