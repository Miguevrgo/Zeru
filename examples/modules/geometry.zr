pub struct Rect {
    w: i32,
    h: i32,

    pub fn area(self) i32 {
        return self.w * self.h;
    }
}

pub fn tiles(room: Rect, side: i32) i32 {
    return rounded_up(room.w, side) * rounded_up(room.h, side);
}

fn rounded_up(length: i32, step: i32) i32 {
    return (length + step - 1) / step;
}
