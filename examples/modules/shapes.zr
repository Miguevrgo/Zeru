// A module that imports another module, so the nested case is covered.
import geom.area;

pub struct Rect {
    w: i32,
    h: i32,

    pub fn area(self) i32 { return geom_area(self.w, self.h); }
}

pub fn geom_area(w: i32, h: i32) i32 {
    return area::rectangle(w, h);
}

struct Factor {
    n: i32,

    fn of(n: i32) Factor { return Factor { n: n }; }
}

pub fn doubled(r: Rect) i32 {
    return area::scale(r.area(), Factor.of(2).n);
}
