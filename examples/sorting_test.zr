// Sorting and searching over both an array and a Vec.

fn insertion_sort(data: *Array<i32, 8>, length: usize) {
    var i: usize = 1;
    while i < length {
        var key: i32 = (*data)[i];
        var j: usize = i;
        while j > 0 && (*data)[j - 1] > key {
            (*data)[j] = (*data)[j - 1];
            j -= 1;
        }
        (*data)[j] = key;
        i += 1;
    }
}

fn is_sorted(data: *Array<i32, 8>, length: usize) bool {
    var i: usize = 1;
    while i < length {
        if (*data)[i - 1] > (*data)[i] { return false; }
        i += 1;
    }
    return true;
}

fn binary_search(data: *Array<i32, 8>, length: usize, needle: i32) i64 {
    var low: usize = 0;
    var high: usize = length;
    while low < high {
        var mid: usize = low + (high - low) / 2;
        var seen: i32 = (*data)[mid];
        if seen == needle { return mid as i64; }
        if seen < needle { low = mid + 1; } else { high = mid; }
    }
    return -1;
}

fn sort_vec(list: *Vec<i64>) {
    var n: usize = (*list).len();
    if n < 2 { return; }
    var swapped: bool = true;
    while swapped {
        swapped = false;
        var i: usize = 1;
        while i < n {
            var previous: i64 = (*list)[i - 1];
            var current: i64 = (*list)[i];
            if previous > current {
                (*list)[i - 1] = current;
                (*list)[i] = previous;
                swapped = true;
            }
            i += 1;
        }
        n -= 1;
    }
}

fn main() {
    var data: Array<i32, 8> = [5, 3, 9, 1, 7, 3, 8, 2];
    if is_sorted(&data, 8) { exit(1); }

    insertion_sort(&data, 8);
    if !is_sorted(&data, 8) { exit(2); }
    if data[0] != 1 { exit(3); }
    if data[7] != 9 { exit(4); }
    if data[2] != 3 { exit(5); }

    if binary_search(&data, 8, 7) != 5 { exit(6); }
    if binary_search(&data, 8, 1) != 0 { exit(7); }
    if binary_search(&data, 8, 4) != -1 { exit(8); }

    // Already sorted input must come out unchanged.
    var ordered: Array<i32, 8> = [1, 2, 3, 4, 5, 6, 7, 8];
    insertion_sort(&ordered, 8);
    if ordered[3] != 4 { exit(9); }

    var list: Vec<i64> = Vec.new();
    list.push(4);
    list.push(1);
    list.push(3);
    list.push(2);
    sort_vec(&list);
    if list[0] != 1 { exit(10); }
    if list[3] != 4 { exit(11); }
    if list.len() != 4 { exit(12); }

    println("sorting: all tests passed");
    exit(0);
}
