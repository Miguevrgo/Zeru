// A small bank as a state machine: accounts are Open, Frozen with a reason or
// Closed, commands are enums carrying their data, and every failure is an
// error code. Accounts are reached through references into a Vec.

enum State {
    Open,
    Frozen(i32),
    Closed
}

enum Command {
    Deposit(u32, i64),
    Withdraw(u32, i64),
    Transfer(u32, u32, i64),
    Freeze(u32, i32),
    Thaw(u32),
    Close(u32)
}

const NO_ACCOUNT: i32 = 1;
const NOT_OPEN: i32 = 2;
const FUNDS: i32 = 3;
const BAD_AMOUNT: i32 = 4;
const NOT_EMPTY: i32 = 5;
const SAME: i32 = 6;

struct Account {
    id: u32,
    balance: i64,
    state: State,
    history: Vec<i64>,

    fn usable(self) bool {
        return match self.state {
            State::Open => true,
            State::Frozen(_) | State::Closed => false
        };
    }

    fn apply(var self, amount: i64) i32! {
        if !self.usable() { return Err(NOT_OPEN); }
        if self.balance + amount < 0 { return Err(FUNDS); }
        self.balance += amount;
        self.history.push(amount);
        return Ok(0);
    }
}

fn position(accounts: &Vec<Account>, id: u32) usize? {
    for i in 0..accounts.len() {
        if accounts[i].id == id { return i; }
    }
    return None;
}

// The balance of `id`, or None if it does not exist.
fn balance(accounts: &Vec<Account>, id: u32) i64? {
    var at = position(accounts, id)?;
    return accounts[at].balance;
}

// Account `id`, or NO_ACCOUNT.
fn need(accounts: &var Vec<Account>, id: u32) (&var Account)! {
    for acc in accounts {
        if acc.id == id { return Ok(&var acc); }
    }
    return Err(NO_ACCOUNT);
}

fn run(accounts: &var Vec<Account>, cmd: Command) i32! {
    match cmd {
        Command::Deposit(_, amount) | Command::Withdraw(_, amount) | Command::Transfer(_, _, amount) => {
            if amount <= 0 { return Err(BAD_AMOUNT); }
        }
        default => { }
    }
    match cmd {
        Command::Deposit(id, amount) => { need(accounts, id)!.apply(amount)!; }
        Command::Withdraw(id, amount) => { need(accounts, id)!.apply(-amount)!; }
        Command::Transfer(from, to, amount) => {
            if from == to { return Err(SAME); }
            var a = position(accounts, from);
            var b = position(accounts, to);
            if a.is_none() || b.is_none() { return Err(NO_ACCOUNT); }
            var dst = &var accounts[b.unwrap()];
            if !dst.usable() { return Err(NOT_OPEN); }
            accounts[a.unwrap()].apply(-amount)!;
            dst.apply(amount)!;
        }
        Command::Freeze(id, reason) => {
            var acc = need(accounts, id)!;
            match acc.state {
                State::Open | State::Frozen(_) => { acc.state = State::Frozen(reason); }
                State::Closed => { return Err(NOT_OPEN); }
            }
        }
        Command::Thaw(id) => {
            var acc = need(accounts, id)!;
            match acc.state {
                State::Frozen(_) => { acc.state = State::Open; }
                State::Open | State::Closed => { return Err(NOT_OPEN); }
            }
        }
        Command::Close(id) => {
            var acc = need(accounts, id)!;
            if acc.balance != 0 { return Err(NOT_EMPTY); }
            acc.state = State::Closed;
        }
    }
    return Ok(0);
}

fn state_name(s: State) str {
    return match s {
        State::Open => "open",
        State::Frozen(_) => "frozen",
        State::Closed => "closed"
    };
}

fn main() {
    var accounts: Vec<Account> = Vec.new();
    for id in 1..4 {
        accounts.push(Account { id: id as u32, balance: 0, state: State::Open, history: Vec.new() });
    }
    var script: Vec<Command> = [
        Command::Deposit(1, 500),
        Command::Deposit(2, 120),
        Command::Withdraw(1, 75),
        Command::Withdraw(2, 200),
        Command::Transfer(1, 3, 300),
        Command::Freeze(3, 42),
        Command::Transfer(1, 3, 10),
        Command::Deposit(3, 1),
        Command::Thaw(3),
        Command::Transfer(3, 2, 300),
        Command::Deposit(9, 5),
        Command::Withdraw(1, -5),
        Command::Close(1),
        Command::Withdraw(1, 125),
        Command::Close(1),
        Command::Deposit(1, 1),
        Command::Transfer(2, 2, 1)
    ];
    var want: Array<i32, 17> = [0, 0, 0, FUNDS, 0, 0, NOT_OPEN, NOT_OPEN, 0, 0, NO_ACCOUNT,
        BAD_AMOUNT, NOT_EMPTY, 0, 0, NOT_OPEN, SAME];
    var failures = 0;
    var step: usize = 0;
    for cmd in script {
        var got = run(&var accounts, cmd);
        var code = 0;
        if got.is_err() { code = got.unwrap_err(); }
        println("step {}: code {}", step, code);
        if code != want[step] { failures += 1; }
        step += 1;
    }

    var total: i64 = 0;
    for acc in &accounts {
        println("account {}: {} ({}), {} moves", acc.id, acc.balance, state_name(acc.state), acc.history.len());
        total += acc.balance;
    }
    var moved: i64 = 0;
    for amount in accounts[1].history { moved += amount; }

    var ok = failures == 0 && total == 420 && balance(&accounts, 2).unwrap() == 420
        && balance(&accounts, 3).unwrap() == 0 && balance(&accounts, 7).is_none() && moved == 420
        && accounts[0].history.len() == 4;
    if !ok { exit(1); }
    exit(0);
}
