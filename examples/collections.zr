import std.collections.hashmap::{HashMap};
import std.collections.hashset::{HashSet};
import std.collections.vecdeque::{VecDeque};
import std.collections.binary_heap::{BinaryHeap};

fn main() {
    var grid: Array<Array<i32, 3>, 2> = [[1, 2, 3], [4, 5, 6]];
    var zeros: Array<u8, 8> = [0; 8];
    grid[1][2] = 60;
    println("{} {} {}", grid[0][1], grid[1][2], zeros[7]);

    var v: Vec<i64> = [5, 3, 8];
    v.push(1);
    v.insert(0, 9);
    var last = v.pop();
    var removed = v.remove(1);
    println("{} {} {} {}", v.len(), last.unwrap(), removed, v[0]);
    v.sort();
    println("{} {} {} {}", v[0], v.sum(), v.max().unwrap(), v.contains(8));
    v.swap(0, 2);
    v.clear();
    println("{}", v.is_empty());

    var names: Vec<str> = ["ann", "bob"];
    println("{} {}", names.get(1).is_some(), names.get(5).is_none());

    var ages: HashMap<i64, i32> = HashMap.new();
    ages.insert(1, 30);
    ages.insert(2, 41);
    ages.insert(1, 31);
    match ages.get(1) {
        Some(age) => println("id 1 is {}", *age),
        None => println("no id 1"),
    }
    println("{} {}", ages.len(), ages.contains(3));

    var seen: HashSet<i32> = HashSet.new();
    for n in [4, 7, 4, 4, 9] {
        seen.insert(n);
    }
    println("{} distinct", seen.len());

    var queue: VecDeque<str> = VecDeque.new();
    queue.push_back("second");
    queue.push_front("first");
    queue.push_back("third");
    while !queue.is_empty() {
        print("{} ", queue.pop_front().unwrap());
    }
    println("");

    var heap: BinaryHeap<i32> = BinaryHeap.new();
    for n in [3, 10, 1, 7] {
        heap.push(n);
    }
    while !heap.is_empty() {
        print("{} ", heap.pop().unwrap());
    }
    println("");
}
