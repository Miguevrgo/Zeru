struct Ticket {
    id: i32,
    holders: Vec<str>,

    fn drop(var self) {
        println("ticket {} dropped", self.id);
    }
}

fn consume(ticket: Ticket) {
    println("using ticket {}", ticket.id);
}

fn count(names: &Vec<str>) usize {
    return names.len();
}

fn add_name(names: &var Vec<str>, name: str) {
    names.push(name);
}

fn make(id: i32) Ticket {
    return Ticket { id: id, holders: Vec.new() };
}

fn main() {
    var a = 5;
    var b = a;
    b += 1;
    println("{} {}", a, b);

    var first: Vec<str> = ["ann", "bob"];
    var second = first;
    var third = second.copy();
    add_name(&var third, "cid");
    println("{} {}", count(&second), count(&third));

    var scores: Vec<i64> = [1, 2, 3];
    for score in &var scores {
        score *= 10;
    }
    println("{} {} {}", scores[0], scores[1], scores[2]);

    {
        var inner = make(1);
        println("inner holds {}", inner.holders.len());
    }
    var ticket = make(2);
    ticket = make(3);
    consume(ticket);

    var top = &scores[2];
    println("top {}", *top);

    var bytes: Array<u8, 4> = [1, 2, 3, 4];
    var at: *u8 = &bytes[0];
    var sum: u32 = 0;
    for i in 0..4 {
        sum += *(at + i) as u32;
    }
    *at = 100;
    println("{} {}", sum, bytes[0]);
    println("end of main");
}
