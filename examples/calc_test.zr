// Evaluate "2 * (3 + 4) - 5" with a tokenizer and a recursive descent parser.

enum Token {
    Num(i64),
    Op(u8),
    Open,
    Close,
    End
}

enum CalcError {
    BadChar,
    Unclosed,
    DivByZero
}

struct Lexer {
    text: str,
    at: usize,

    fn new(text: str) Lexer {
        return Lexer { text: text, at: 0 };
    }

    fn peek(self) u8? {
        if self.at >= self.text.len() { return None; }
        return self.text[self.at];
    }

    fn next(var self) Token!CalcError {
        while (self.peek() orelse 0) == ' ' { self.at += 1; }
        var c = self.peek() orelse 0;
        if c == 0 { return Ok(Token::End); }
        self.at += 1;
        match c {
            '+' => { return Ok(Token::Op(c)); }
            '-' => { return Ok(Token::Op(c)); }
            '*' => { return Ok(Token::Op(c)); }
            '/' => { return Ok(Token::Op(c)); }
            '(' => { return Ok(Token::Open); }
            ')' => { return Ok(Token::Close); }
            default => { }
        }
        if c < '0' || c > '9' { return Err(CalcError::BadChar); }
        var value = (c - '0') as i64;
        var d = self.peek() orelse 0;
        while d >= '0' && d <= '9' {
            value = value * 10 + (d - '0') as i64;
            self.at += 1;
            d = self.peek() orelse 0;
        }
        return Ok(Token::Num(value));
    }
}

struct Parser {
    lexer: Lexer,
    current: Token,

    fn advance(var self) i64!CalcError {
        self.current = try self.lexer.next();
        return Ok(0);
    }

    fn expr(var self) i64!CalcError {
        var left = try self.term();
        while true {
            var current = self.current;
            match current {
                Token::Op(op) => {
                    if op != '+' && op != '-' { return Ok(left); }
                    try self.advance();
                    var right = try self.term();
                    left = match op { '+' => left + right, default => left - right };
                }
                default => { return Ok(left); }
            }
        }
        return Ok(left);
    }

    fn term(var self) i64!CalcError {
        var left = try self.atom();
        while true {
            var current = self.current;
            match current {
                Token::Op(op) => {
                    if op != '*' && op != '/' { return Ok(left); }
                    try self.advance();
                    var right = try self.atom();
                    if op == '/' && right == 0 { return Err(CalcError::DivByZero); }
                    left = match op { '*' => left * right, default => left / right };
                }
                default => { return Ok(left); }
            }
        }
        return Ok(left);
    }

    fn atom(var self) i64!CalcError {
        var current = self.current;
        match current {
            Token::Num(n) => {
                try self.advance();
                return Ok(n);
            }
            Token::Open => {
                try self.advance();
                var inner = try self.expr();
                var current = self.current;
                match current {
                    Token::Close => { try self.advance(); }
                    default => { return Err(CalcError::Unclosed); }
                }
                return Ok(inner);
            }
            default => { return Err(CalcError::BadChar); }
        }
    }
}

fn eval(text: str) i64!CalcError {
    var parser = Parser { lexer: Lexer.new(text), current: Token::End };
    try parser.advance();
    return parser.expr();
}

fn main() {
    if (eval("2 * (3 + 4) - 5") catch -1) != 9 { exit(1); }
    if (eval("100 / 7 / 2") catch -1) != 7 { exit(2); }
    var bad = eval("1 / 0");
    if !bad.is_err() { exit(3); }
    println("calc: {}", eval("1 + 2 * 3") catch -1);
    exit(0);
}
