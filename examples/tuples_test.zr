// Tuples: built, read and written by position, and carried around.

struct Span { range: (usize, usize), label: str }

fn pair_sum(p: (i32, i32)) i32 { return p.0 + p.1; }

fn divide(a: i32, b: i32) (i32, i32) { return (a / b, a % b); }

fn widen(narrow: (i32, i32)) (i64, i64) {
    return (narrow.0 as i64, narrow.1 as i64);
}

fn main() {
    var p: (i32, i32) = (3, 4);
    if p.0 != 3 { exit(1); }
    if p.1 != 4 { exit(2); }
    if pair_sum(p) != 7 { exit(3); }

    // A field is a place, so it can be written and compounded.
    p.0 = 10;
    if p.0 != 10 { exit(4); }
    if p.1 != 4 { exit(5); }
    p.1 += 6;
    if p.1 != 10 { exit(6); }

    // Fields of different widths keep their own.
    var mixed: (i32, i64) = (1, 2);
    if mixed.1 != 2 { exit(7); }

    // Two results out of one call.
    var divided = divide(17, 5);
    if divided.0 != 3 { exit(8); }
    if divided.1 != 2 { exit(9); }

    var wide = widen((1, 2));
    if wide.1 != 2 { exit(10); }

    // Nested, which needs parentheses: `n.0.1` reads as one number.
    var nested: ((i32, i32), i32) = ((1, 2), 3);
    if (nested.0).1 != 2 { exit(11); }
    if nested.1 != 3 { exit(12); }

    // In an array and in a struct.
    var cells: Array<(i32, i32), 2> = [(1, 2), (3, 4)];
    if cells[1].0 != 3 { exit(13); }
    cells[0].1 = 9;
    if cells[0].1 != 9 { exit(14); }

    var span = Span { range: (2, 5), label: "word" };
    if span.range.1 != 5 { exit(15); }
    span.range.0 = 3;
    if span.range.0 != 3 { exit(16); }
    println(span.label);

    // And in a Vec.
    var spans: Vec<(usize, usize)> = Vec.new();
    spans.push((0, 1));
    spans.push((2, 3));
    var total: usize = 0;
    for range in spans {
        total += range.1 - range.0;
    }
    if total != 2 { exit(17); }
    if spans[1].0 != 2 { exit(18); }

    println("tuples: all tests passed");
    exit(0);
}
