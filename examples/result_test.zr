// Result type (T!) integration test
// Tests is_ok, is_err, unwrap, unwrap_err, error enums, try, catch and orelse
// Uses exit codes to verify behavior

enum ParseError { Empty, NotDigit }

fn digit(c: u8) i32!ParseError {
    if c < '0' || c > '9' { return Err(ParseError::NotDigit); }
    return Ok((c - '0') as i32);
}

// `try` hands an error back to the caller as it is.
fn number(text: str) i32!ParseError {
    if text.len() == 0 { return Err(ParseError::Empty); }
    var total = 0;
    for i in 0..text.len() { total = total * 10 + try digit(text[i]); }
    return Ok(total);
}

fn first(items: Vec<i64>) i64? {
    if items.is_empty() { return None; }
    return items[0];
}

fn divide(a: i32, b: i32) i32! {
    if b == 0 {
        return Err(1);
    }
    return Ok(a / b);
}

fn name(n: i32) str? {
    if n == 0 { return None; }
    return "one";
}

fn pair() (i32, i32)? { return (1, 2); }

fn sign(n: i32?) i32 {
    match n {
        Some(v) => { return v; }
        None => { return 0; }
    }
}

fn always_fail() i64! {
    return Err(42);
}

fn always_ok() i64! {
    var v: i64 = 100;
    return Ok(v);
}

fn main() {
    var r1: i32! = divide(10, 2);
    if !r1.is_ok() {
        exit(1);
    }
    if r1.is_err() {
        exit(2);
    }
    var val: i32 = r1.unwrap();
    if val != 5 {
        exit(3);
    }

    var r2: i32! = divide(10, 0);
    if r2.is_ok() {
        exit(4);
    }
    if !r2.is_err() {
        exit(5);
    }
    var code: i32 = r2.unwrap_err();
    if code != 1 {
        exit(6);
    }

    var r3: i64! = always_ok();
    if !r3.is_ok() {
        exit(7);
    }
    if r3.unwrap() != 100 {
        exit(8);
    }

    var r4: i64! = always_fail();
    if !r4.is_err() {
        exit(9);
    }
    if r4.unwrap_err() != 42 {
        exit(10);
    }

    var r5: i32! = divide(20, 4);
    if r5.is_ok() {
        var v: i32 = r5.unwrap();
        if v != 5 {
            exit(11);
        }
    } else {
        exit(12);
    }

    if number("123").unwrap() != 123 { exit(20); }
    if number("1x").unwrap_err() != ParseError::NotDigit { exit(21); }
    if number("").unwrap_err() != ParseError::Empty { exit(22); }
    if (number("9z") catch -1) != -1 || (number("42") catch 0) != 42 { exit(23); }
    if (first(Vec.new()) orelse 5) != 5 || (first([3]) orelse 5) != 3 { exit(24); }
    if (name(0) orelse "none").len() != 4 || name(1).is_none() { exit(25); }
    if pair().unwrap().1 != 2 || sign(None) != 0 { exit(26); }

    println("result: all tests passed");
    exit(0);
}
